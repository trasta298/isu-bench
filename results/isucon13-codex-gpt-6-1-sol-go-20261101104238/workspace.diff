diff --git a/webapp/go/response_cache.go b/webapp/go/response_cache.go
new file mode 100644
index 0000000..073e5d6
--- /dev/null
+++ b/webapp/go/response_cache.go
@@ -0,0 +1,152 @@
+package main
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"github.com/labstack/echo/v4"
+	"sync"
+	"time"
+)
+
+type responseCacheKey struct{}
+type responseCache struct {
+	users   map[int64]User
+	streams map[int64]Livestream
+}
+
+func responseCacheMiddleware(next echo.HandlerFunc) echo.HandlerFunc {
+	return func(c echo.Context) error {
+		cache := &responseCache{users: make(map[int64]User), streams: make(map[int64]Livestream)}
+		c.SetRequest(c.Request().WithContext(context.WithValue(c.Request().Context(), responseCacheKey{}, cache)))
+		return next(c)
+	}
+}
+func getResponseCache(ctx context.Context) *responseCache {
+	cache, _ := ctx.Value(responseCacheKey{}).(*responseCache)
+	return cache
+}
+
+// Stream metadata never changes after reservation. User entries expire quickly
+// so changes to icon hashes become visible on all app servers within one second.
+type cachedUser struct {
+	user  User
+	until time.Time
+}
+
+var sharedResponses = struct {
+	sync.RWMutex
+	users   map[int64]cachedUser
+	streams map[int64]Livestream
+}{users: make(map[int64]cachedUser), streams: make(map[int64]Livestream)}
+
+func resetResponseCaches() {
+	resetIconCaches()
+	sharedResponses.Lock()
+	sharedResponses.users = make(map[int64]cachedUser)
+	sharedResponses.streams = make(map[int64]Livestream)
+	sharedResponses.Unlock()
+}
+func invalidateUser(id int64) {
+	sharedResponses.Lock()
+	delete(sharedResponses.users, id)
+	sharedResponses.Unlock()
+}
+func cachedUserResponse(ctx context.Context, id int64) (User, bool) {
+	if c := getResponseCache(ctx); c != nil {
+		if user, ok := c.users[id]; ok {
+			return user, true
+		}
+	}
+	sharedResponses.RLock()
+	v, ok := sharedResponses.users[id]
+	sharedResponses.RUnlock()
+	if ok && time.Now().Before(v.until) {
+		if c := getResponseCache(ctx); c != nil {
+			c.users[id] = v.user
+		}
+		return v.user, true
+	}
+	return User{}, false
+}
+func getUserResponse(ctx context.Context, tx DBReader, id int64) (User, error) {
+	if user, ok := cachedUserResponse(ctx, id); ok {
+		return user, nil
+	}
+	if user, ok, err := refreshUserIconHash(ctx, tx, id); ok {
+		return user, err
+	}
+	var model UserModel
+	if err := tx.GetContext(ctx, &model, "SELECT * FROM users WHERE id=?", id); err != nil {
+		return User{}, err
+	}
+	return fillUserResponse(ctx, tx, model)
+}
+func cachedLivestreamResponse(ctx context.Context, tx DBReader, id int64) (Livestream, bool, error) {
+	if c := getResponseCache(ctx); c != nil {
+		if stream, ok := c.streams[id]; ok {
+			return stream, true, nil
+		}
+	}
+	sharedResponses.RLock()
+	stream, ok := sharedResponses.streams[id]
+	sharedResponses.RUnlock()
+	if !ok {
+		return Livestream{}, false, nil
+	}
+	owner, err := getUserResponse(ctx, tx, stream.Owner.ID)
+	if err != nil {
+		return Livestream{}, true, err
+	}
+	stream.Owner = owner
+	if c := getResponseCache(ctx); c != nil {
+		c.streams[id] = stream
+	}
+	return stream, true, nil
+}
+func getLivestreamResponse(ctx context.Context, tx DBReader, id int64) (Livestream, error) {
+	if stream, ok, err := cachedLivestreamResponse(ctx, tx, id); ok {
+		return stream, err
+	}
+	var model LivestreamModel
+	if err := tx.GetContext(ctx, &model, "SELECT * FROM livestreams WHERE id=?", id); err != nil {
+		return Livestream{}, err
+	}
+	return fillLivestreamResponse(ctx, tx, model)
+}
+
+type DBReader interface {
+	GetContext(context.Context, interface{}, string, ...interface{}) error
+	SelectContext(context.Context, interface{}, string, ...interface{}) error
+}
+
+// User profiles and themes are immutable. Only refresh their icon hash when
+// the short cache expires, retaining the immutable metadata.
+func refreshUserIconHash(ctx context.Context, tx DBReader, id int64) (User, bool, error) {
+	sharedResponses.RLock()
+	entry, ok := sharedResponses.users[id]
+	sharedResponses.RUnlock()
+	if !ok {
+		return User{}, false, nil
+	}
+	expires := time.Now().Add(750 * time.Millisecond)
+	var hash string
+	if err := tx.GetContext(ctx, &hash, "SELECT hash FROM icons WHERE user_id=?", id); err != nil {
+		if !errors.Is(err, sql.ErrNoRows) {
+			return User{}, true, err
+		}
+		hash = fallbackHash
+	}
+	user := entry.user
+	user.IconHash = hash
+	storeUserResponse(ctx, user, expires)
+	return user, true, nil
+}
+func storeUserResponse(ctx context.Context, user User, expires time.Time) {
+	sharedResponses.Lock()
+	sharedResponses.users[user.ID] = cachedUser{user: user, until: expires}
+	sharedResponses.Unlock()
+	if c := getResponseCache(ctx); c != nil {
+		c.users[user.ID] = user
+	}
+}
