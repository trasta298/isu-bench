diff --git a/webapp/sql/scores.sql b/webapp/sql/scores.sql
new file mode 100644
index 0000000..e276adc
--- /dev/null
+++ b/webapp/sql/scores.sql
@@ -0,0 +1,51 @@
+CREATE TABLE stream_scores (
+ livestream_id BIGINT NOT NULL PRIMARY KEY,
+ user_id BIGINT NOT NULL,
+ score BIGINT NOT NULL DEFAULT 0,
+ KEY score_order (score,livestream_id),
+ KEY stream_user (user_id)
+) ENGINE=InnoDB;
+CREATE TABLE user_scores (
+ user_id BIGINT NOT NULL PRIMARY KEY,
+ name VARCHAR(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
+ score BIGINT NOT NULL DEFAULT 0,
+ KEY score_order (score,name)
+) ENGINE=InnoDB;
+INSERT INTO stream_scores (livestream_id,user_id,score)
+ SELECT l.id,l.user_id,COALESCE(r.score,0)+COALESCE(c.score,0)
+ FROM livestreams l
+ LEFT JOIN (SELECT livestream_id,COUNT(*) score FROM reactions GROUP BY livestream_id) r ON r.livestream_id=l.id
+ LEFT JOIN (SELECT livestream_id,SUM(tip) score FROM livecomments GROUP BY livestream_id) c ON c.livestream_id=l.id;
+INSERT INTO user_scores(user_id,name,score)
+ SELECT u.id,u.name,COALESCE(s.score,0) FROM users u
+ LEFT JOIN (SELECT user_id,SUM(score) score FROM stream_scores GROUP BY user_id) s ON s.user_id=u.id;
+DELIMITER //
+CREATE TRIGGER user_score_create AFTER INSERT ON users FOR EACH ROW
+BEGIN INSERT INTO user_scores(user_id,name) VALUES(NEW.id,NEW.name); END//
+CREATE TRIGGER stream_score_create AFTER INSERT ON livestreams FOR EACH ROW
+BEGIN INSERT INTO stream_scores(livestream_id,user_id) VALUES(NEW.id,NEW.user_id); END//
+CREATE TRIGGER reaction_score_add AFTER INSERT ON reactions FOR EACH ROW
+BEGIN
+ UPDATE stream_scores SET score=score+1 WHERE livestream_id=NEW.livestream_id;
+ UPDATE user_scores SET score=score+1 WHERE user_id=(SELECT user_id FROM livestreams WHERE id=NEW.livestream_id);
+END//
+CREATE TRIGGER reaction_score_delete AFTER DELETE ON reactions FOR EACH ROW
+BEGIN
+ UPDATE stream_scores SET score=score-1 WHERE livestream_id=OLD.livestream_id;
+ UPDATE user_scores SET score=score-1 WHERE user_id=(SELECT user_id FROM livestreams WHERE id=OLD.livestream_id);
+END//
+CREATE TRIGGER comment_score_add AFTER INSERT ON livecomments FOR EACH ROW
+BEGIN
+ IF NEW.tip!=0 THEN
+ UPDATE stream_scores SET score=score+NEW.tip WHERE livestream_id=NEW.livestream_id;
+ UPDATE user_scores SET score=score+NEW.tip WHERE user_id=(SELECT user_id FROM livestreams WHERE id=NEW.livestream_id);
+ END IF;
+END//
+CREATE TRIGGER comment_score_delete AFTER DELETE ON livecomments FOR EACH ROW
+BEGIN
+ IF OLD.tip!=0 THEN
+ UPDATE stream_scores SET score=score-OLD.tip WHERE livestream_id=OLD.livestream_id;
+ UPDATE user_scores SET score=score-OLD.tip WHERE user_id=(SELECT user_id FROM livestreams WHERE id=OLD.livestream_id);
+ END IF;
+END//
+DELIMITER ;
