+a=s.index('\tsharedResponses.Lock()',s.index('func fillUserResponse'));b=s.index('\n\treturn user, nil',a)
+s=s[:a]+'\tstoreUserResponse(ctx,user,expires)'+s[b:];p.write_text(s)
