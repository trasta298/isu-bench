+#!/bin/bash
+set -eu
+for h in s1 s2 s3; do
+  ssh "$h" 'hostname; ps -eo comm,%cpu,%mem --sort=-%cpu | head -7; free -m' &
+done
+wait
+ssh s1 'sudo mysql -e "SELECT LEFT(DIGEST_TEXT,200),COUNT_STAR,ROUND(SUM_TIMER_WAIT/1e12,2) sec,SUM_ROWS_EXAMINED FROM performance_schema.events_statements_summary_by_digest WHERE SCHEMA_NAME=\"isupipe\" ORDER BY SUM_TIMER_WAIT DESC LIMIT 15;"'
