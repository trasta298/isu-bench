+from pathlib import Path
+p=Path('webapp/go/response_cache.go');s=p.read_text();s=s.replace('"context"','"context"\n "sync"\n "time"\n "github.com/jmoiron/sqlx"')
+s+='''
+// Stream metadata never changes after reservation. User entries expire quickly
+// so changes to icon hashes become visible on all app servers within one second.
+type cachedUser struct { user User; until time.Time }
+var sharedResponses = struct {
+ sync.RWMutex
+ users map[int64]cachedUser
+ streams map[int64]Livestream
+}{users:make(map[int64]cachedUser),streams:make(map[int64]Livestream)}
+
+func resetResponseCaches() {
+ sharedResponses.Lock()
+ sharedResponses.users=make(map[int64]cachedUser)
+ sharedResponses.streams=make(map[int64]Livestream)
+ sharedResponses.Unlock()
+}
+func invalidateUser(id int64) {
+ sharedResponses.Lock();delete(sharedResponses.users,id);sharedResponses.Unlock()
+}
+func cachedUserResponse(ctx context.Context,id int64) (User,bool) {
+ if c:=getResponseCache(ctx);c!=nil { if user,ok:=c.users[id];ok{return user,true} }
+ sharedResponses.RLock();v,ok:=sharedResponses.users[id];sharedResponses.RUnlock()
+ if ok && time.Now().Before(v.until) {return v.user,true};return User{},false
+}
+func getUserResponse(ctx context.Context,tx *sqlx.Tx,id int64) (User,error) {
+ if user,ok:=cachedUserResponse(ctx,id);ok {return user,nil}
+ var model UserModel
+ if err:=tx.GetContext(ctx,&model,"SELECT * FROM users WHERE id=?",id);err!=nil{return User{},err}
+ return fillUserResponse(ctx,tx,model)
+}
+func cachedLivestreamResponse(ctx context.Context,tx *sqlx.Tx,id int64) (Livestream,bool,error) {
+ if c:=getResponseCache(ctx);c!=nil {if stream,ok:=c.streams[id];ok{return stream,true,nil}}
+ sharedResponses.RLock();stream,ok:=sharedResponses.streams[id];sharedResponses.RUnlock()
+ if !ok {return Livestream{},false,nil}
+ owner,err:=getUserResponse(ctx,tx,stream.Owner.ID)
+ if err!=nil {return Livestream{},true,err}
+ stream.Owner=owner
+ if c:=getResponseCache(ctx);c!=nil {c.streams[id]=stream}
+ return stream,true,nil
+}
+func getLivestreamResponse(ctx context.Context,tx *sqlx.Tx,id int64) (Livestream,error) {
+ if stream,ok,err:=cachedLivestreamResponse(ctx,tx,id);ok {return stream,err}
+ var model LivestreamModel
+ if err:=tx.GetContext(ctx,&model,"SELECT * FROM livestreams WHERE id=?",id);err!=nil{return Livestream{},err}
+ return fillLivestreamResponse(ctx,tx,model)
+}
+'''
+p.write_text(s)
+p=Path('webapp/go/user_handler.go');s=p.read_text()
+a=s.index('\tcache:=getResponseCache(ctx)',s.index('func fillUserResponse'))
+b=s.index('\n\tuser := User{',a)
+s=s[:a]+'''	if user,ok:=cachedUserResponse(ctx,userModel.ID);ok{return user,nil}
+ cache:=getResponseCache(ctx)
+ var metadata struct { ID int64 `db:"id"`; DarkMode bool `db:"dark_mode"`; Hash string `db:"hash"` }
+ if err:=tx.GetContext(ctx,&metadata,`SELECT t.id,t.dark_mode,COALESCE(i.hash,?) AS hash FROM themes t LEFT JOIN icons i ON i.user_id=t.user_id WHERE t.user_id=?`,fallbackHash,userModel.ID);err!=nil{return User{},err}
+ themeModel:=ThemeModel{ID:metadata.ID,DarkMode:metadata.DarkMode}
+ iconHash:=metadata.Hash
+'''+s[b:]
+s=s.replace('\tif cache!=nil { cache.users[user.ID]=user }','\tsharedResponses.Lock();sharedResponses.users[user.ID]=cachedUser{user:user,until:time.Now().Add(750*time.Millisecond)};sharedResponses.Unlock()\n\tif cache!=nil { cache.users[user.ID]=user }')
+pos=s.index('\n\treturn c.JSON(http.StatusCreated, &PostIconResponse')
+s=s[:pos]+'\n invalidateUser(userID)\n'+s[pos:];p.write_text(s)
+p=Path('webapp/go/livestream_handler.go');s=p.read_text()
+a=s.index('\tcache:=getResponseCache(ctx)',s.index('func fillLivestreamResponse'));b=s.index('\n\ttags := ',a)
+s=s[:a]+'''	if stream,ok,err:=cachedLivestreamResponse(ctx,tx,livestreamModel.ID);ok {return stream,err}
+ cache:=getResponseCache(ctx)
+ owner,err:=getUserResponse(ctx,tx,livestreamModel.UserID)
+ if err!=nil {return Livestream{},err}
+'''+s[b:]
+s=s.replace('\tif cache!=nil { cache.streams[livestream.ID]=livestream }','\tsharedResponses.Lock();sharedResponses.streams[livestream.ID]=livestream;sharedResponses.Unlock()\n\tif cache!=nil { cache.streams[livestream.ID]=livestream }')
+p.write_text(s)
+for filename,func,uid,prefix in [('livecomment_handler.go','fillLivecommentResponse','livecommentModel.UserID','commentOwner'),('reaction_handler.go','fillReactionResponse','reactionModel.UserID','user')]:
+ p=Path('webapp/go/'+filename);s=p.read_text();a=s.index('\n',s.index('func '+func))+1;b=s.index('\n\t'+('livecomment := ' if filename=='livecomment_handler.go' else 'reaction := '),a)
+ s=s[:a]+f'''\t{prefix},err:=getUserResponse(ctx,tx,{uid})
+ if err!=nil {{return {'Livecomment' if prefix=='commentOwner' else 'Reaction'}{{}},err}}
+ livestream,err:=getLivestreamResponse(ctx,tx,{ 'livecommentModel' if prefix=='commentOwner' else 'reactionModel'}.LivestreamID)
+ if err!=nil {{return {'Livecomment' if prefix=='commentOwner' else 'Reaction'}{{}},err}}
+'''+s[b:];p.write_text(s)
+p=Path('webapp/go/main.go');s=p.read_text().replace('func initializeHandler(c echo.Context) error {','func initializeHandler(c echo.Context) error {\n\tresetResponseCaches()').replace('\tc.Request().Header.Add("Content-Type"','\tresetResponseCaches()\n\tc.Request().Header.Add("Content-Type"');p.write_text(s)
