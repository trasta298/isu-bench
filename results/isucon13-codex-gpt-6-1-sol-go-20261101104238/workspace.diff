@@ -0,0 +1,10 @@
+from pathlib import Path
+import re
+p=Path('/work/RESULTS.md');s=p.read_text()
+for log in sorted(Path('/work/results').glob('[0-9][0-9].log')):
+ m=re.search(r'run (\d+)/15 finished: pass=(true|false) score=(\d+)',log.read_text())
+ if not m:continue
+ run,passed,score=m.groups()
+ result=('PASS ' if passed=='true' else 'FAIL ')+format(int(score),',')
+ s=re.sub(r'(\| '+run+r' \| [^\n]* \| )[^|\n]+( \|)',lambda m:m[1]+result+m[2],s)
+p.write_text(s)
