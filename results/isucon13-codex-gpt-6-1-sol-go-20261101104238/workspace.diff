+from pathlib import Path
+p=Path('webapp/go/response_cache.go');s=p.read_text().replace('"context"','"context"\n "database/sql"\n "errors"')
+s=s.replace('if ok && time.Now().Before(v.until) {\n\t\treturn v.user, true','if ok && time.Now().Before(v.until) {\n if c:=getResponseCache(ctx);c!=nil{c.users[id]=v.user}\n\t\treturn v.user, true')
+s=s.replace('\tvar model UserModel\n', '\tif user,ok,err:=refreshUserIconHash(ctx,tx,id);ok{return user,err}\n\tvar model UserModel\n',1)
+s+='''
+// User profiles and themes are immutable. Only refresh their icon hash when
+// the short cache expires, retaining the immutable metadata.
+func refreshUserIconHash(ctx context.Context,tx DBReader,id int64)(User,bool,error){
+ sharedResponses.RLock();entry,ok:=sharedResponses.users[id];sharedResponses.RUnlock()
+ if !ok{return User{},false,nil}
+ expires:=time.Now().Add(750*time.Millisecond)
+ var hash string
+ if err:=tx.GetContext(ctx,&hash,"SELECT hash FROM icons WHERE user_id=?",id);err!=nil{
+  if !errors.Is(err,sql.ErrNoRows){return User{},true,err};hash=fallbackHash
+ }
+ user:=entry.user;user.IconHash=hash
+ storeUserResponse(ctx,user,expires)
+ return user,true,nil
+}
+func storeUserResponse(ctx context.Context,user User,expires time.Time){
+ sharedResponses.Lock();sharedResponses.users[user.ID]=cachedUser{user:user,until:expires};sharedResponses.Unlock()
+ if c:=getResponseCache(ctx);c!=nil{c.users[user.ID]=user}
+}
+''';p.write_text(s)
+p=Path('webapp/go/user_handler.go');s=p.read_text()
+a=s.index('func fillUserResponse');b=s.index('\tvar metadata struct',a)
+s=s[:b]+s[b:]
