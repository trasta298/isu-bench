diff --git a/webapp/go/cache_peers.go b/webapp/go/cache_peers.go
new file mode 100644
index 0000000..473f738
--- /dev/null
+++ b/webapp/go/cache_peers.go
@@ -0,0 +1,40 @@
+package main
+
+import (
+	"fmt"
+	"github.com/labstack/echo/v4"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+)
+
+func resetCacheHandler(c echo.Context) error {
+	if c.Request().Header.Get("X-Cache-Key") != string(secret) {
+		return c.NoContent(http.StatusForbidden)
+	}
+	resetResponseCaches()
+	return c.NoContent(http.StatusNoContent)
+}
+func resetPeerCaches() error {
+	client := &http.Client{Timeout: 5 * time.Second}
+	for _, peer := range strings.Split(os.Getenv("ISUCON13_CACHE_PEERS"), ",") {
+		if peer == "" {
+			continue
+		}
+		req, err := http.NewRequest("POST", peer+"/internal/cache/reset", nil)
+		if err != nil {
+			return err
+		}
+		req.Header.Set("X-Cache-Key", string(secret))
+		resp, err := client.Do(req)
+		if err != nil {
+			return err
+		}
+		resp.Body.Close()
+		if resp.StatusCode != http.StatusNoContent {
+			return fmt.Errorf("cache reset on %s: %d", peer, resp.StatusCode)
+		}
+	}
+	return nil
+}
diff --git a/webapp/go/icon_cache.go b/webapp/go/icon_cache.go
new file mode 100644
index 0000000..3059fcb
--- /dev/null
+++ b/webapp/go/icon_cache.go
@@ -0,0 +1,28 @@
+package main
+
+import (
+	"sync"
+	"time"
+)
+
+type cachedIcon struct {
+	image []byte
+	hash  string
+	until time.Time
+}
+
+var iconResponses = struct {
+	sync.RWMutex
+	items map[string]cachedIcon
+}{items: make(map[string]cachedIcon)}
+
+func resetIconCaches() {
+	iconResponses.Lock()
+	iconResponses.items = make(map[string]cachedIcon)
+	iconResponses.Unlock()
+}
+func invalidateIcon(name string) {
+	iconResponses.Lock()
+	delete(iconResponses.items, name)
+	iconResponses.Unlock()
+}
