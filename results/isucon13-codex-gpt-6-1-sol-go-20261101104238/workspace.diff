+++ b/ops/experiments/tune_reads.py
@@ -0,0 +1,32 @@
+from pathlib import Path
+import re
+# Both *sqlx.DB and *sqlx.Tx satisfy this read interface.
+for fn in ['user_handler.go','livestream_handler.go','livecomment_handler.go','reaction_handler.go','response_cache.go']:
+ p=Path('webapp/go')/fn;s=p.read_text().replace('tx *sqlx.Tx','tx DBReader').replace('\n\t"github.com/jmoiron/sqlx"','')
+ if fn=='livestream_handler.go':s=s.replace('"time"','"time"\n "github.com/jmoiron/sqlx"') # search still uses sqlx.In
+ if fn=='response_cache.go':
+  s+='''
+type DBReader interface {
+ GetContext(context.Context,interface{},string,...interface{}) error
+ SelectContext(context.Context,interface{},string,...interface{}) error
+}
+'''
+ p.write_text(s)
+handlers={
+'user_handler.go':['getMeHandler','getUserHandler','loginHandler'],
+'livestream_handler.go':['searchLivestreamsHandler','getMyLivestreamsHandler','getUserLivestreamsHandler','getLivestreamHandler','getLivecommentReportsHandler'],
+'livecomment_handler.go':['getLivecommentsHandler','getNgwords'],
+'reaction_handler.go':['getReactionsHandler'],
+'payment_handler.go':['GetPaymentResult'],
+'top_handler.go':['getTagHandler','getStreamerThemeHandler']}
+for fn,names in handlers.items():
+ p=Path('webapp/go')/fn;s=p.read_text()
+ for name in names:
+  a=s.index('func '+name+'(');m=re.search(r'\nfunc ',s[a+1:]);b=a+1+m.start() if m else len(s)
+  f=s[a:b]
+  f,n=re.subn(r'\ttx, err := dbConn.BeginTxx\(ctx, nil\)\n\tif err != nil \{.*?\n\t\}\n\tdefer tx.Rollback\(\)', '\ttx := dbConn',f,count=1,flags=re.S)
+  assert n,(fn,name)
+  f=re.sub(r'\n\tif err := tx.Commit\(\); err != nil \{.*?\n\t\}\n','\n',f,count=1,flags=re.S)
+  if name in ['getMeHandler','getStreamerThemeHandler','loginHandler']:f=f.replace('\terr = tx.GetContext','\terr := tx.GetContext')
+  s=s[:a]+f+s[b:]
+ p.write_text(s)
diff --git a/ops/experiments/tune_shared.py b/ops/experiments/tune_shared.py
