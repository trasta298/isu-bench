diff --git a/webapp/go/payment.go b/webapp/go/payment.go
new file mode 100644
index 0000000..b93faad
--- /dev/null
+++ b/webapp/go/payment.go
@@ -0,0 +1,98 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"strconv"
+	"sync/atomic"
+	"time"
+)
+
+// asyncPayment: respond to the evaluation right away and settle the payment
+// in the background (idempotent retries). Payments are reconciled by the
+// benchmarker at the end of the run, with a 5s grace period.
+const asyncPayment = false
+
+func payInBackground(url, token, rideID string, amount int) {
+	atomic.AddInt64(&statPayInflight, 1)
+	defer atomic.AddInt64(&statPayInflight, -1)
+	if err := requestPayment(context.Background(), url, token, rideID, amount, time.Now().Add(120*time.Second)); err != nil {
+		log.Printf("async payment failed ride=%s: %v", rideID, err)
+	}
+}
+
+var paymentClient = &http.Client{
+	Transport: &http.Transport{
+		MaxIdleConns:        512,
+		MaxIdleConnsPerHost: 512,
+		IdleConnTimeout:     90 * time.Second,
+	},
+	Timeout: 5 * time.Second,
+}
+
+// requestPayment posts a payment, retrying with the same Idempotency-Key
+// until the gateway acknowledges it.
+func requestPayment(ctx context.Context, url, token, rideID string, amount int, deadline time.Time) error {
+	body := []byte(`{"amount":` + strconv.Itoa(amount) + `}`)
+	var lastErr error
+	for attempt := 0; ; attempt++ {
+		req, err := http.NewRequest(http.MethodPost, url+"/payments", bytes.NewReader(body))
+		if err != nil {
+			return err
+		}
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("Authorization", "Bearer "+token)
+		req.Header.Set("Idempotency-Key", rideID)
+		t0 := time.Now()
+		res, err := paymentClient.Do(req)
+		atomic.AddInt64(&statPayAttempts, 1)
+		el := time.Since(t0)
+		atomic.AddInt64(&statPayNs, int64(el))
+		switch {
+		case el < 10*time.Millisecond:
+			atomic.AddInt64(&statPayHist[0], 1)
+		case el < 50*time.Millisecond:
+			atomic.AddInt64(&statPayHist[1], 1)
+		case el < 200*time.Millisecond:
+			atomic.AddInt64(&statPayHist[2], 1)
+		case el < time.Second:
+			atomic.AddInt64(&statPayHist[3], 1)
+		default:
+			atomic.AddInt64(&statPayHist[4], 1)
+		}
+		if err == nil && res.StatusCode == http.StatusNoContent {
+			atomic.AddInt64(&statPayOkNs, int64(el))
+			atomic.AddInt64(&statPayOk, 1)
+		}
+		if err != nil {
+			atomic.AddInt64(&statPayErr, 1)
+		} else if res.StatusCode != http.StatusNoContent {
+			atomic.AddInt64(&statPayNon204, 1)
+			if res.StatusCode < 500 {
+				log.Printf("payment status %d attempt=%d", res.StatusCode, attempt)
+			}
+		}
+		if err == nil {
+			io.Copy(io.Discard, res.Body)
+			res.Body.Close()
+			if res.StatusCode == http.StatusNoContent || res.StatusCode == http.StatusOK {
+				return nil
+			}
+			lastErr = fmt.Errorf("payment status %d", res.StatusCode)
+		} else {
+			lastErr = err
+		}
+		if time.Now().After(deadline) {
+			log.Printf("payment give up ride=%s: %v", rideID, lastErr)
+			return lastErr
+		}
+		// 5xx are injected failures: retry right away (same Idempotency-Key).
+		if err != nil || (res != nil && res.StatusCode < 500) {
+			time.Sleep(5 * time.Millisecond)
+		}
+	}
+}
