+package main
+
+import (
+	"log"
+	"strings"
+)
+
+// Sampled request tracing to learn client behavior (1/32 of users and chairs).
+const traceEnabled = false
+
+func traced(id string) bool {
+	return traceEnabled && len(id) > 0 && strings.HasSuffix(id, "0")
+}
+
+func tracef(kind, id, format string, args ...any) {
+	if traced(id) {
+		log.Printf("TRACE %s %s "+format, append([]any{kind, id}, args...)...)
+	}
+}
