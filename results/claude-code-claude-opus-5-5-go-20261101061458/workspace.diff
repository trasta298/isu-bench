--- /dev/null
+++ b/tools/snapshot.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+# Dump read-only API responses for all preset accounts (for comparing implementations).
+import json, ssl, subprocess, sys, urllib.request, http.client
+BASE = "isuride.xiv.isucon.net"
+out = {}
+def q(sql):
+    r = subprocess.run(["sudo", "mysql", "-N", "-B", "isuride", "-e", sql], capture_output=True, text=True, check=True)
+    return [l.split("\t") for l in r.stdout.strip().split("\n") if l]
+ctx = ssl.create_default_context()
+def req(method, path, cookie, body=None):
+    c = http.client.HTTPSConnection("127.0.0.1", 443, context=ctx, timeout=10)
+    c._tunnel_host = None
+    c = http.client.HTTPSConnection(BASE, 443, timeout=10)
+    h = {"Cookie": cookie, "Content-Type": "application/json"}
+    c.request(method, path, body=json.dumps(body) if body else None, headers=h)
+    r = c.getresponse()
+    ct = r.getheader("Content-Type") or ""
+    if "event-stream" in ct:
+        c.sock.settimeout(0.3)
+        try:
+            line = r.readline().decode()
+        except Exception:
+            c.close()
+            return r.status, None
+        c.close()
+        return r.status, json.loads(line[len("data: "):])
+    data = r.read().decode()
+    c.close()
+    try:
+        return r.status, json.loads(data) if data else None
+    except Exception:
+        return r.status, data
+for oid, tok in q("select id, access_token from owners"):
+    out["owner_chairs_"+oid] = req("GET", "/api/owner/chairs", "owner_session="+tok)
+    out["owner_sales_"+oid] = req("GET", "/api/owner/sales", "owner_session="+tok)
+    out["owner_sales2_"+oid] = req("GET", "/api/owner/sales?since=1732579200000&until=1732620000000", "owner_session="+tok)
+for uid, tok in q("select id, access_token from users"):
+    out["app_rides_"+uid] = req("GET", "/api/app/rides", "app_session="+tok)
+    out["est_"+uid] = req("POST", "/api/app/rides/estimated-fare", "app_session="+tok, {"pickup_coordinate":{"latitude":0,"longitude":0},"destination_coordinate":{"latitude":30,"longitude":-12}})
+    out["notif_"+uid] = req("GET", "/api/app/notification", "app_session="+tok)
+for cid, tok in q("select id, access_token from chairs limit 100"):
+    out["cnotif_"+cid] = req("GET", "/api/chair/notification", "chair_session="+tok)
+json.dump(out, sys.stdout, sort_keys=True, ensure_ascii=False, indent=1)
