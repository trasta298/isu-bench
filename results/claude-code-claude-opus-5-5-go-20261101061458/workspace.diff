index 0000000..3d0a297
--- /dev/null
+++ b/webapp/go/persist.go
@@ -0,0 +1,125 @@
+package main
+
+import (
+	"database/sql"
+	"log"
+	"strings"
+	"sync"
+	"time"
+)
+
+// Write-behind persistence. All in-memory mutations are mirrored to MySQL
+// asynchronously, preserving order within the general queue.
+
+type dbOp struct {
+	q    string
+	args []any
+}
+
+type locRow struct {
+	id      string
+	chairID string
+	lat     int
+	lon     int
+	t       time.Time
+}
+
+var (
+	qmu      sync.Mutex
+	opQueue  []dbOp
+	locQueue []locRow
+	qsig     = make(chan struct{}, 1)
+	writerMu sync.Mutex // held while a batch is being written; initialize takes it
+)
+
+func persist(q string, args ...any) {
+	qmu.Lock()
+	opQueue = append(opQueue, dbOp{q, args})
+	qmu.Unlock()
+	select {
+	case qsig <- struct{}{}:
+	default:
+	}
+}
+
+func persistLoc(id, chairID string, lat, lon int, t time.Time) {
+	qmu.Lock()
+	locQueue = append(locQueue, locRow{id, chairID, lat, lon, t})
+	qmu.Unlock()
+}
+
+// discardQueues drops everything pending. Caller must hold writerMu.
+func discardQueues() {
+	qmu.Lock()
+	opQueue = nil
+	locQueue = nil
+	qmu.Unlock()
+}
+
+func writerLoop() {
+	t := time.NewTicker(200 * time.Millisecond)
+	defer t.Stop()
+	for {
+		select {
+		case <-qsig:
+		case <-t.C:
+		}
+		flushOnce()
+	}
+}
+
+func flushOnce() {
+	writerMu.Lock()
+	defer writerMu.Unlock()
+	qmu.Lock()
+	ops := opQueue
+	locs := locQueue
+	opQueue = nil
+	locQueue = nil
+	qmu.Unlock()
+
+	for len(ops) > 0 {
+		n := min(len(ops), 300)
+		execBatch(ops[:n])
+		ops = ops[n:]
+	}
+	for len(locs) > 0 {
+		n := min(len(locs), 2000)
+		insertLocs(locs[:n])
+		locs = locs[n:]
+	}
+}
+
+func execBatch(ops []dbOp) {
+	tx, err := db.Begin()
+	if err != nil {
+		log.Printf("persist begin: %v", err)
+		return
+	}
+	for _, op := range ops {
+		if _, err := tx.Exec(op.q, op.args...); err != nil {
+			log.Printf("persist exec %q: %v", op.q, err)
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		log.Printf("persist commit: %v", err)
+	}
+}
+
+func insertLocs(locs []locRow) {
+	var sb strings.Builder
+	sb.WriteString("INSERT INTO chair_locations (id, chair_id, latitude, longitude, created_at) VALUES ")
+	args := make([]any, 0, len(locs)*5)
+	for i, l := range locs {
+		if i > 0 {
+			sb.WriteString(",")
+		}
+		sb.WriteString("(?,?,?,?,?)")
+		args = append(args, l.id, l.chairID, l.lat, l.lon, l.t)
+	}
+	if _, err := db.Exec(sb.String(), args...); err != nil {
+		log.Printf("persist locs: %v", err)
+	}
+}
+
+var _ = sql.ErrNoRows
diff --git a/webapp/go/state.go b/webapp/go/state.go
new file mode 100644
index 0000000..86c2c30
--- /dev/null
+++ b/webapp/go/state.go
@@ -0,0 +1,434 @@
+package main
+
+import (
+	"database/sql"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+const (
+	StMatching  = "MATCHING"
+	StEnroute   = "ENROUTE"
+	StPickup    = "PICKUP"
+	StCarrying  = "CARRYING"
+	StArrived   = "ARRIVED"
+	StCompleted = "COMPLETED"
+)
+
+// mu guards every field reachable from st.
+var mu sync.Mutex
+var st *State
+
+// stPtr mirrors st for lock-free access to the token indexes.
+var stPtr atomic.Pointer[State]
+
+func setState(s *State) {
+	mu.Lock()
+	st = s
+	stPtr.Store(s)
+	mu.Unlock()
+}
+
+type Coupon struct {
+	UserID    string
+	Code      string
+	Discount  int
+	CreatedAt time.Time
+	UsedBy    string
+}
+
+type RideStatus struct {
+	Status    string
+	CreatedAt time.Time
+}
+
+type Ride struct {
+	ID         string
+	User       *User
+	Chair      *Chair
+	PickupLat  int
+	PickupLon  int
+	DestLat    int
+	DestLon    int
+	Evaluation int // 0 = NULL
+	CreatedAt  time.Time
+	UpdatedAt  time.Time
+	Statuses   []RideStatus
+	Discount   int // discount of the coupon whose used_by is this ride
+	paying     bool
+}
+
+func (r *Ride) Latest() string {
+	return r.Statuses[len(r.Statuses)-1].Status
+}
+
+func (r *Ride) hasStatus(s string) bool {
+	for _, x := range r.Statuses {
+		if x.Status == s {
+			return true
+		}
+	}
+	return false
+}
+
+func (r *Ride) Fare() int {
+	metered := farePerDistance * calculateDistance(r.PickupLat, r.PickupLon, r.DestLat, r.DestLon)
+	return initialFare + max(metered-r.Discount, 0)
+}
+
+func (r *Ride) RawFare() int {
+	return calculateFare(r.PickupLat, r.PickupLon, r.DestLat, r.DestLon)
+}
+
+type User struct {
+	ID             string
+	Username       string
+	Firstname      string
+	Lastname       string
+	DateOfBirth    string
+	AccessToken    string
+	InvitationCode string
+	CreatedAt      time.Time
+	Rides          []*Ride   // created_at asc
+	Coupons        []*Coupon // created_at asc
+	PaymentToken   string
+	HasToken       bool
+	notif          *Notifier
+}
+
+func (u *User) LatestRide() *Ride {
+	if len(u.Rides) == 0 {
+		return nil
+	}
+	return u.Rides[len(u.Rides)-1]
+}
+
+type Owner struct {
+	ID                 string
+	Name               string
+	AccessToken        string
+	ChairRegisterToken string
+	CreatedAt          time.Time
+	Chairs             []*Chair // id asc
+}
+
+type Chair struct {
+	ID          string
+	Owner       *Owner
+	Name        string
+	Model       string
+	Speed       int
+	IsActive    bool
+	AccessToken string
+	CreatedAt   time.Time
+	UpdatedAt   time.Time
+
+	HasLoc    bool
+	Lat       int
+	Lon       int
+	LocAt     time.Time
+	TotalDist int
+
+	Rides     []*Ride // all rides assigned to this chair
+	Current   *Ride   // latest ride by updated_at
+	Delivered bool    // COMPLETED of Current has been delivered to the chair
+
+	DeliveredAt time.Time // when COMPLETED of Current was delivered
+	ListedAt    time.Time // last time this chair was returned by nearby-chairs
+	Reserved    bool      // matcher wants it; hidden from nearby until assigned
+
+	StatCount   int
+	StatEvalSum int
+
+	notif *Notifier
+}
+
+type State struct {
+	PaymentURL string
+	Models     map[string]int
+
+	Users        map[string]*User
+	UsersByToken map[string]*User
+	UsersByInv   map[string]*User
+	UsersByName  map[string]*User
+	InvUsed      map[string]int // invitation code -> number of times used
+
+	Owners        map[string]*Owner
+	OwnersByToken map[string]*Owner
+	OwnersByReg   map[string]*Owner
+	OwnersByName  map[string]*Owner
+
+	Chairs        map[string]*Chair
+	ChairsByToken map[string]*Chair
+	ChairList     []*Chair // id asc
+
+	Rides   map[string]*Ride
+	Waiting []*Ride // rides without chair, created order
+
+	// lock-free token -> entity indexes (written under mu, read without)
+	TokUsers  sync.Map
+	TokOwners sync.Map
+	TokChairs sync.Map
+}
+
+func newState() *State {
+	return &State{
+		Models:        map[string]int{},
+		Users:         map[string]*User{},
+		UsersByToken:  map[string]*User{},
+		UsersByInv:    map[string]*User{},
+		UsersByName:   map[string]*User{},
+		InvUsed:       map[string]int{},
+		Owners:        map[string]*Owner{},
+		OwnersByToken: map[string]*Owner{},
+		OwnersByReg:   map[string]*Owner{},
+		OwnersByName:  map[string]*Owner{},
+		Chairs:        map[string]*Chair{},
+		ChairsByToken: map[string]*Chair{},
+		Rides:         map[string]*Ride{},
+	}
+}
+
+func loadState(db *sql.DB) (*State, error) {
+	s := newState()
+
+	if err := db.QueryRow("SELECT value FROM settings WHERE name = 'payment_gateway_url'").Scan(&s.PaymentURL); err != nil && err != sql.ErrNoRows {
+		return nil, err
+	}
+
+	rows, err := db.Query("SELECT name, speed FROM chair_models")
+	if err != nil {
+		return nil, err
+	}
+	for rows.Next() {
+		var n string
+		var sp int
+		if err := rows.Scan(&n, &sp); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		s.Models[n] = sp
+	}
+	rows.Close()
+
+	rows, err = db.Query("SELECT id, name, access_token, chair_register_token, created_at FROM owners ORDER BY id")
+	if err != nil {
+		return nil, err
+	}
+	for rows.Next() {
+		o := &Owner{}
+		if err := rows.Scan(&o.ID, &o.Name, &o.AccessToken, &o.ChairRegisterToken, &o.CreatedAt); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		s.Owners[o.ID] = o
+		s.OwnersByToken[o.AccessToken] = o
+		s.TokOwners.Store(o.AccessToken, o)
+		s.OwnersByReg[o.ChairRegisterToken] = o
+		s.OwnersByName[o.Name] = o
+	}
+	rows.Close()
+
+	rows, err = db.Query("SELECT id, owner_id, name, model, is_active, access_token, created_at, updated_at FROM chairs ORDER BY id")
+	if err != nil {
+		return nil, err
+	}
+	for rows.Next() {
+		c := &Chair{Delivered: true}
+		var ownerID string
+		if err := rows.Scan(&c.ID, &ownerID, &c.Name, &c.Model, &c.IsActive, &c.AccessToken, &c.CreatedAt, &c.UpdatedAt); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		c.Owner = s.Owners[ownerID]
+		c.Speed = s.speedOf(c.Model)
+		c.notif = newNotifier()
+		s.Chairs[c.ID] = c
+		s.ChairsByToken[c.AccessToken] = c
+		s.TokChairs.Store(c.AccessToken, c)
+		s.ChairList = append(s.ChairList, c)
+		if c.Owner != nil {
+			c.Owner.Chairs = append(c.Owner.Chairs, c)
+		}
+	}
+	rows.Close()
+
+	rows, err = db.Query("SELECT chair_id, latitude, longitude, created_at FROM chair_locations ORDER BY chair_id, created_at")
+	if err != nil {
+		return nil, err
+	}
+	for rows.Next() {
+		var cid string
+		var lat, lon int
+		var t time.Time
+		if err := rows.Scan(&cid, &lat, &lon, &t); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		c := s.Chairs[cid]
+		if c == nil {
+			continue
+		}
+		if c.HasLoc {
+			c.TotalDist += abs(lat-c.Lat) + abs(lon-c.Lon)
+		}
+		c.HasLoc = true
+		c.Lat, c.Lon, c.LocAt = lat, lon, t
+	}
+	rows.Close()
+
+	rows, err = db.Query("SELECT id, username, firstname, lastname, date_of_birth, access_token, invitation_code, created_at FROM users")
+	if err != nil {
+		return nil, err
+	}
+	for rows.Next() {
+		u := &User{}
+		if err := rows.Scan(&u.ID, &u.Username, &u.Firstname, &u.Lastname, &u.DateOfBirth, &u.AccessToken, &u.InvitationCode, &u.CreatedAt); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		u.notif = newNotifier()
+		s.Users[u.ID] = u
+		s.UsersByToken[u.AccessToken] = u
+		s.TokUsers.Store(u.AccessToken, u)
+		s.UsersByInv[u.InvitationCode] = u
+		s.UsersByName[u.Username] = u
+	}
+	rows.Close()
+
+	rows, err = db.Query("SELECT user_id, token FROM payment_tokens")
+	if err != nil {
+		return nil, err
+	}
+	for rows.Next() {
+		var uid, tok string
+		if err := rows.Scan(&uid, &tok); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		if u := s.Users[uid]; u != nil {
+			u.PaymentToken = tok
+			u.HasToken = true
+		}
+	}
+	rows.Close()
+
+	rows, err = db.Query("SELECT id, user_id, chair_id, pickup_latitude, pickup_longitude, destination_latitude, destination_longitude, evaluation, created_at, updated_at FROM rides ORDER BY created_at, id")
+	if err != nil {
+		return nil, err
+	}
+	for rows.Next() {
+		r := &Ride{}
+		var uid string
+		var cid sql.NullString
+		var ev sql.NullInt64
+		if err := rows.Scan(&r.ID, &uid, &cid, &r.PickupLat, &r.PickupLon, &r.DestLat, &r.DestLon, &ev, &r.CreatedAt, &r.UpdatedAt); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		if ev.Valid {
+			r.Evaluation = int(ev.Int64)
+		}
+		r.User = s.Users[uid]
+		if r.User == nil {
+			continue
+		}
+		if cid.Valid {
+			r.Chair = s.Chairs[cid.String]
+		}
+		s.Rides[r.ID] = r
+		r.User.Rides = append(r.User.Rides, r)
+		if r.Chair != nil {
+			r.Chair.Rides = append(r.Chair.Rides, r)
+		}
+	}
+	rows.Close()
+
+	rows, err = db.Query("SELECT ride_id, status, created_at FROM ride_statuses ORDER BY ride_id, created_at, id")
+	if err != nil {
+		return nil, err
+	}
+	for rows.Next() {
+		var rid string
+		var rs RideStatus
+		if err := rows.Scan(&rid, &rs.Status, &rs.CreatedAt); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		if r := s.Rides[rid]; r != nil {
+			r.Statuses = append(r.Statuses, rs)
+		}
+	}
+	rows.Close()
+
+	rows, err = db.Query("SELECT user_id, code, discount, created_at, used_by FROM coupons ORDER BY created_at, code")
+	if err != nil {
+		return nil, err
+	}
+	for rows.Next() {
+		c := &Coupon{}
+		var usedBy sql.NullString
+		if err := rows.Scan(&c.UserID, &c.Code, &c.Discount, &c.CreatedAt, &usedBy); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		if usedBy.Valid {
+			c.UsedBy = usedBy.String
+			if r := s.Rides[c.UsedBy]; r != nil {
+				r.Discount = c.Discount
+			}
+		}
+		if strings.HasPrefix(c.Code, "INV_") {
+			s.InvUsed[c.Code[4:]]++
+		}
+		if u := s.Users[c.UserID]; u != nil {
+			u.Coupons = append(u.Coupons, c)
+		}
+	}
+	rows.Close()
+
+	// derived data
+	for _, r := range s.Rides {
+		if len(r.Statuses) == 0 {
+			// should not happen; treat as MATCHING
+			r.Statuses = append(r.Statuses, RideStatus{Status: StMatching, CreatedAt: r.CreatedAt})
+		}
+		if r.Chair == nil {
+			s.Waiting = append(s.Waiting, r)
+		}
+	}
+	sort.Slice(s.Waiting, func(i, j int) bool { return s.Waiting[i].CreatedAt.Before(s.Waiting[j].CreatedAt) })
+	// MySQL returns ties of "ORDER BY created_at DESC" in ascending id order.
+	for _, u := range s.Users {
+		sort.SliceStable(u.Rides, func(i, j int) bool {
+			a, b := u.Rides[i], u.Rides[j]
+			if !a.CreatedAt.Equal(b.CreatedAt) {
+				return a.CreatedAt.Before(b.CreatedAt)
+			}
+			return a.ID > b.ID
+		})
+	}
+	for _, c := range s.ChairList {
+		for _, r := range c.Rides {
+			if c.Current == nil || r.UpdatedAt.After(c.Current.UpdatedAt) ||
+				(r.UpdatedAt.Equal(c.Current.UpdatedAt) && r.ID < c.Current.ID) {
+				c.Current = r
+			}
+			if r.Latest() == StCompleted && r.hasStatus(StArrived) && r.hasStatus(StCarrying) {
+				c.StatCount++
+				c.StatEvalSum += r.Evaluation
+			}
+		}
+	}
+	return s, nil
+}
+
+func (s *State) speedOf(model string) int {
+	if sp, ok := s.Models[model]; ok && sp > 0 {
+		return sp
+	}
+	return 1
+}
diff --git a/webapp/go/stats.go b/webapp/go/stats.go
new file mode 100644
index 0000000..6556cfe
--- /dev/null
+++ b/webapp/go/stats.go
@@ -0,0 +1,158 @@
+package main
+
+import (
+	"fmt"
+	"log"
+	"net/http"
+	"runtime"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+type routeStat struct {
+	count int64
+	ns    int64
+	max   int64
+}
+
+var routeStats sync.Map // pattern -> *routeStat
+
+// timed wraps a handler and records its server-side latency.
+func timed(pattern string, h http.HandlerFunc) http.HandlerFunc {
+	v, _ := routeStats.LoadOrStore(pattern, &routeStat{})
+	rs := v.(*routeStat)
+	return func(w http.ResponseWriter, r *http.Request) {
+		t0 := time.Now()
+		h(w, r)
+		d := int64(time.Since(t0))
+		atomic.AddInt64(&rs.count, 1)
+		atomic.AddInt64(&rs.ns, d)
+		for {
+			m := atomic.LoadInt64(&rs.max)
+			if d <= m || atomic.CompareAndSwapInt64(&rs.max, m, d) {
+				break
+			}
+		}
+	}
+}
+
+func routeSummary() string {
+	var parts []string
+	routeStats.Range(func(k, v any) bool {
+		rs := v.(*routeStat)
+		c := atomic.SwapInt64(&rs.count, 0)
+		ns := atomic.SwapInt64(&rs.ns, 0)
+		m := atomic.SwapInt64(&rs.max, 0)
+		if c > 0 && !strings.Contains(k.(string), "notification") {
+			name := k.(string)
+			if i := strings.LastIndex(name, "/api/"); i >= 0 {
+				name = name[i+5:]
+			}
+			parts = append(parts, fmt.Sprintf("%s:%d/%.2fms/max%.0fms", name, c, float64(ns)/float64(c)/1e6, float64(m)/1e6))
+		}
+		return true
+	})
+	sort.Strings(parts)
+	return strings.Join(parts, " ")
+}
+
+var statNearbyByState = map[string]int{} // guarded by mu
+
+var statPayHist [5]int64 // <10ms <50ms <200ms <1s >=1s
+var statPayOk, statPayOkNs int64
+
+var (
+	statPayAttempts   int64
+	statPayNs         int64
+	statPayErr        int64
+	statPayNon204     int64
+	statPayInflight   int64
+	statPickupDist    int64 // guarded by mu
+	statWaitNs        int64 // guarded by mu
+	statUrgent        int64 // guarded by mu
+	statRideDist      int64 // guarded by mu
+	statDemandLimited int64 // guarded by mu
+	statCoordGapNs    int64 // guarded by mu
+	statCoordGaps     int64 // guarded by mu
+	statMatchNs       int64
+	statMatchCalls    int64
+	statAssigned      int64
+)
+
+func statsLoop() {
+	runtime.SetMutexProfileFraction(0)
+	for range time.Tick(5 * time.Second) {
+		mu.Lock()
+		s := st
+		waiting := len(s.Waiting)
+		free, active, busy := 0, 0, 0
+		for _, c := range s.ChairList {
+			if c.IsActive {
+				active++
+			}
+			if c.isFree() {
+				free++
+			} else if c.IsActive {
+				busy++
+			}
+		}
+		guardNow := nearbyGuard()
+		gapNs, gaps := statCoordGapNs, statCoordGaps
+		statCoordGapNs, statCoordGaps = 0, 0
+		nb := fmt.Sprint(statNearbyByState)
+		statNearbyByState = map[string]int{}
+		pd, wn, urg, rd := statPickupDist, statWaitNs, statUrgent, statRideDist
+		statPickupDist, statWaitNs, statUrgent, statRideDist = 0, 0, 0, 0
+		dl := statDemandLimited
+		statDemandLimited = 0
+		mu.Unlock()
+		gapAvg := 0.0
+		if gaps > 0 {
+			gapAvg = float64(gapNs) / float64(gaps) / 1e6
+		}
+		calls := atomic.SwapInt64(&statMatchCalls, 0)
+		ns := atomic.SwapInt64(&statMatchNs, 0)
+		as := atomic.SwapInt64(&statAssigned, 0)
+		rsum := routeSummary()
+		if calls > 0 || waiting > 0 || rsum != "" {
+			log.Printf("stats waiting=%d free=%d busy=%d active=%d match_calls=%d match_ms=%.1f assigned=%d goroutines=%d coord_gap=%.1fms guard=%v",
+				waiting, free, busy, active, calls, float64(ns)/1e6, as, runtime.NumGoroutine(), gapAvg, guardNow)
+			pa := atomic.SwapInt64(&statPayAttempts, 0)
+			pns := atomic.SwapInt64(&statPayNs, 0)
+			if pa > 0 || as > 0 {
+				pavg, pdAvg, wAvg, rdAvg := 0.0, 0.0, 0.0, 0.0
+				if pa > 0 {
+					pavg = float64(pns) / float64(pa) / 1e6
+				}
+				if as > 0 {
+					pdAvg = float64(pd) / float64(as)
+					wAvg = float64(wn) / float64(as) / 1e9
+					rdAvg = float64(rd) / float64(as)
+				}
+				var h [5]int64
+				for i := range h {
+					h[i] = atomic.SwapInt64(&statPayHist[i], 0)
+				}
+				okN := atomic.SwapInt64(&statPayOk, 0)
+				okNs := atomic.SwapInt64(&statPayOkNs, 0)
+				failAvg, okAvg := 0.0, 0.0
+				if okN > 0 {
+					okAvg = float64(okNs) / float64(okN) / 1e6
+				}
+				if pa > okN {
+					failAvg = float64(pns-okNs) / float64(pa-okN) / 1e6
+				}
+				log.Printf("pay ok_avg=%.1fms fail_avg=%.1fms", okAvg, failAvg)
+				log.Printf("pay attempts=%d avg=%.1fms hist=%v err=%d non204=%d inflight=%d | assign pickup_avg=%.1f ride_avg=%.1f wait_avg=%.2fs urgent=%d demand_limited_passes=%d",
+					pa, pavg, h, atomic.SwapInt64(&statPayErr, 0), atomic.SwapInt64(&statPayNon204, 0), atomic.LoadInt64(&statPayInflight), pdAvg, rdAvg, wAvg, urg, dl)
+			}
+			log.Printf("nearby_by_state %s", nb)
+			if rsum != "" {
+				log.Printf("routes %s", rsum)
+			}
+		}
+	}
+}
