+}
+
+// userEvent must be called with mu held.
+func userEvent(r *Ride, status string) Event {
+	d := userNotifData{
+		RideID:                r.ID,
+		PickupCoordinate:      coordJSON{r.PickupLat, r.PickupLon},
+		DestinationCoordinate: coordJSON{r.DestLat, r.DestLon},
+		Fare:                  r.Fare(),
+		Status:                status,
+		CreatedAt:             r.CreatedAt.UnixMilli(),
+		UpdateAt:              r.UpdatedAt.UnixMilli(),
+	}
+	if c := r.Chair; c != nil {
+		d.Chair = &userNotifChair{ID: c.ID, Name: c.Name, Model: c.Model, Stats: chairStats(c)}
+	}
+	b, _ := json.Marshal(d)
+	return Event{data: b, rideID: r.ID, status: status}
+}
+
+// chairEvent must be called with mu held.
+func chairEvent(r *Ride, status string) Event {
+	d := chairNotifData{
+		RideID:                r.ID,
+		User:                  simpleUser{ID: r.User.ID, Name: r.User.Firstname + " " + r.User.Lastname},
+		PickupCoordinate:      coordJSON{r.PickupLat, r.PickupLon},
+		DestinationCoordinate: coordJSON{r.DestLat, r.DestLon},
+		Status:                status,
+	}
+	b, _ := json.Marshal(d)
+	return Event{data: b, rideID: r.ID, status: status}
+}
+
+// addStatus records a status transition and notifies both parties. mu held.
+func addStatus(r *Ride, status string, now time.Time) {
+	r.Statuses = append(r.Statuses, RideStatus{Status: status, CreatedAt: now})
+	persist("INSERT INTO ride_statuses (id, ride_id, status, created_at, app_sent_at, chair_sent_at) VALUES (?, ?, ?, ?, ?, ?)",
+		newID(), r.ID, status, now, now, now)
+	r.User.notif.push(userEvent(r, status))
+	tracef("user", r.User.ID, "event %s %s", r.ID, status)
+	if r.Chair != nil {
+		r.Chair.notif.push(chairEvent(r, status))
+		tracef("chair", r.Chair.ID, "event %s %s", r.ID, status)
+	}
+}
+
+var sseHeader = []byte("data: ")
+var sseTail = []byte("\n\n")
+
+// serveSSE streams events of n. snapshot is used when nothing is pending on
+// connect; delivered is called (with mu held) after events were flushed.
+func serveSSE(w http.ResponseWriter, r *http.Request, n *Notifier, snapshot func() *Event, delivered func([]Event)) {
+	mu.Lock()
+	n.gen++
+	my := n.gen
+	evs := append([]Event(nil), n.pending...)
+	fromPending := len(evs)
+	if len(evs) == 0 {
+		if e := snapshot(); e != nil {
+			evs = append(evs, *e)
+		}
+	}
+	ch := n.ch
+	mu.Unlock()
+
+	h := w.Header()
+	h.Set("Content-Type", "text/event-stream")
+	h.Set("Cache-Control", "no-cache")
+	h.Set("X-Accel-Buffering", "no")
+	w.WriteHeader(http.StatusOK)
+	rc := http.NewResponseController(w)
+	ctx := r.Context()
+
+	for {
+		if len(evs) > 0 {
+			var err error
+			for _, e := range evs {
+				if _, err = w.Write(sseHeader); err != nil {
+					break
+				}
+				if _, err = w.Write(e.data); err != nil {
+					break
+				}
+				if _, err = w.Write(sseTail); err != nil {
+					break
+				}
+			}
+			if err == nil {
+				err = rc.Flush()
+			}
+			if err != nil {
+				return
+			}
+			mu.Lock()
+			if n.gen != my {
+				mu.Unlock()
+				return
+			}
+			n.pending = n.pending[fromPending:]
+			if len(n.pending) == 0 {
+				n.pending = nil
+			}
+			delivered(evs)
+			mu.Unlock()
+		} else if err := rc.Flush(); err != nil {
+			return
+		}
+
+		select {
+		case <-ctx.Done():
+			return
+		case <-ch:
+		}
+		mu.Lock()
+		if n.gen != my {
+			n.signal()
+			mu.Unlock()
+			return
+		}
+		evs = append(evs[:0], n.pending...)
+		fromPending = len(evs)
+		mu.Unlock()
+	}
+}
+
+func appGetNotification(w http.ResponseWriter, r *http.Request, u *User) {
+	tracef("user", u.ID, "sse open")
+	defer tracef("user", u.ID, "sse close")
+	serveSSE(w, r, u.notif, func() *Event {
+		ride := u.LatestRide()
+		if ride == nil {
+			return nil
+		}
+		e := userEvent(ride, ride.Latest())
+		return &e
+	}, func([]Event) {})
+}
+
+func chairGetNotification(w http.ResponseWriter, r *http.Request, c *Chair) {
+	tracef("chair", c.ID, "sse open")
+	defer tracef("chair", c.ID, "sse close")
+	serveSSE(w, r, c.notif, func() *Event {
+		ride := c.Current
+		if ride == nil {
+			return nil
+		}
+		e := chairEvent(ride, ride.Latest())
+		return &e
+	}, func(evs []Event) {
+		cur := c.Current
+		if cur == nil {
+			return
+		}
+		for _, e := range evs {
+			if e.rideID == cur.ID && e.status == StCompleted {
+				if !c.Delivered {
+					c.Delivered = true
+					c.DeliveredAt = time.Now()
+					triggerMatch()
+				}
+			}
+		}
+	})
+}
