diff --git a/webapp/go/matcher.go b/webapp/go/matcher.go
new file mode 100644
index 0000000..9a5d740
--- /dev/null
+++ b/webapp/go/matcher.go
@@ -0,0 +1,259 @@
+package main
+
+import (
+	"sort"
+	"sync/atomic"
+	"time"
+)
+
+var matchSig = make(chan struct{}, 1)
+
+func triggerMatch() {
+	select {
+	case matchSig <- struct{}{}:
+	default:
+	}
+}
+
+const (
+	matchInterval   = 50 * time.Millisecond
+	urgentWait      = 20 * time.Second // oldest-first within region after this
+	crossRegionWait = 40 * time.Second // allow any distance after this
+	maxNormalDist   = 400
+	guardMin        = 100 * time.Millisecond
+	guardMax        = 500 * time.Millisecond
+	overheadTicks   = 10.0 // per-ride fixed cost (~1.25s of handshakes+payment) in chair ticks
+	waitBonus       = 0.1  // efficiency points per second waited
+
+)
+
+var retryScheduled int32
+
+// gapEWMA tracks the clients' interval between consecutive coordinate posts
+// (a proxy for how loaded/slow the client side is). Guarded by mu.
+var gapEWMA = float64(guardMax)
+
+// nearbyGuard is how long a chair is kept out of nearby-chairs after its
+// COMPLETED was delivered, and how long after being listed it can't be
+// assigned. Responses/notifications may be processed late by a loaded
+// client, so scale with its observed pace. mu held.
+func nearbyGuard() time.Duration {
+	g := time.Duration(2.5 * gapEWMA)
+	if g < guardMin {
+		return guardMin
+	}
+	if g > guardMax {
+		return guardMax
+	}
+	return g
+}
+
+func matcherLoop() {
+	t := time.NewTicker(matchInterval)
+	defer t.Stop()
+	for {
+		select {
+		case <-t.C:
+		case <-matchSig:
+		}
+		t0 := time.Now()
+		mu.Lock()
+		if st != nil {
+			st.match(nowUS())
+		}
+		mu.Unlock()
+		atomic.AddInt64(&statMatchNs, int64(time.Since(t0)))
+		atomic.AddInt64(&statMatchCalls, 1)
+	}
+}
+
+func (c *Chair) isFree() bool {
+	if !c.IsActive || !c.HasLoc {
+		return false
+	}
+	if c.Current == nil {
+		return true
+	}
+	return c.Current.Latest() == StCompleted && c.Delivered
+}
+
+type matchPair struct {
+	ri, ci int
+	cost   float64
+}
+
+// match assigns free chairs to waiting rides. mu held.
+func (s *State) match(now time.Time) {
+	free := make([]*Chair, 0, 64)
+	for _, c := range s.ChairList {
+		if c.isFree() {
+			c.Reserved = false
+			free = append(free, c)
+		} else if c.Reserved {
+			c.Reserved = false
+		}
+	}
+	if len(s.Waiting) == 0 || len(free) == 0 {
+		return
+	}
+	rides := s.Waiting
+	usedR := make([]bool, len(rides))
+	assignedR := make([]bool, len(rides))
+	usedC := make([]bool, len(free))
+	// eff is the expected score per chair tick of serving r with c.
+	eff := func(r *Ride, c *Chair, pickup int) float64 {
+		dist := float64(calculateDistance(r.PickupLat, r.PickupLon, r.DestLat, r.DestLon))
+		ticks := (float64(pickup)+dist)/float64(c.Speed) + overheadTicks
+		return (dist + 0.1*float64(pickup) + 5) / ticks
+	}
+	// Demand-limited (more free chairs than waiting rides): chairs would idle
+	// anyway, so optimize rider experience (pickup ETA). Supply-limited:
+	// maximize score per chair tick.
+	demandLimited := false // ETA-first in the demand-limited phase was worse (run 9)
+	pairCost := func(r *Ride, c *Chair, d int, wait float64) float64 {
+		if demandLimited {
+			return float64(d)/float64(c.Speed) - wait
+		}
+		return -(eff(r, c, d) + waitBonus*wait)
+	}
+	if demandLimited {
+		statDemandLimited++
+	}
+	guard := nearbyGuard()
+	assigned := 0
+	deferred := false
+	take := func(ri, ci int) {
+		usedR[ri], usedC[ci] = true, true
+		c := free[ci]
+		if now.Sub(c.ListedAt) < guard {
+			// a nearby-chairs response listing this chair may still be in flight
+			c.Reserved = true
+			deferred = true
+			return
+		}
+		assignedR[ri] = true
+		assigned++
+		s.assign(rides[ri], c, now)
+	}
+
+	// urgent rides first: oldest first, best chair in the same region
+	for ri, r := range rides {
+		wait := now.Sub(r.CreatedAt)
+		if wait < urgentWait {
+			break
+		}
+		best := -1
+		bestCost := 0.0
+		for ci, c := range free {
+			if usedC[ci] {
+				continue
+			}
+			d := calculateDistance(c.Lat, c.Lon, r.PickupLat, r.PickupLon)
+			if d > maxNormalDist && wait < crossRegionWait {
+				continue
+			}
+			cc := pairCost(r, c, d, 0)
+			if best < 0 || cc < bestCost {
+				best, bestCost = ci, cc
+			}
+		}
+		if best >= 0 {
+			statUrgent++
+			take(ri, best)
+		}
+	}
+
+	// Candidate pairs: each free chair keeps its top-K rides; greedy over the
+	// union, repeated for chairs whose candidates were all taken.
+	const topK = 4
+	waitSec := make([]float64, len(rides))
+	for ri, r := range rides {
+		waitSec[ri] = now.Sub(r.CreatedAt).Seconds()
+	}
+	pairs := make([]matchPair, 0, topK*len(free))
+	for round := 0; round < 4; round++ {
+		pairs = pairs[:0]
+		for ci, c := range free {
+			if usedC[ci] {
+				continue
+			}
+			var top [topK]matchPair
+			n := 0
+			for ri, r := range rides {
+				if usedR[ri] {
+					continue
+				}
+				d := calculateDistance(c.Lat, c.Lon, r.PickupLat, r.PickupLon)
+				if d > maxNormalDist {
+					continue
+				}
+				cost := pairCost(r, c, d, waitSec[ri])
+				if n == topK && cost >= top[n-1].cost {
+					continue
+				}
+				if n < topK {
+					n++
+				}
+				i := n - 1
+				for i > 0 && top[i-1].cost > cost {
+					top[i] = top[i-1]
+					i--
+				}
+				top[i] = matchPair{ri, ci, cost}
+			}
+			pairs = append(pairs, top[:n]...)
+		}
+		if len(pairs) == 0 {
+			break
+		}
+		sort.Slice(pairs, func(i, j int) bool {
+			if pairs[i].cost != pairs[j].cost {
+				return pairs[i].cost < pairs[j].cost
+			}
+			return pairs[i].ri < pairs[j].ri
+		})
+		progress := false
+		for _, p := range pairs {
+			if usedR[p.ri] || usedC[p.ci] {
+				continue
+			}
+			take(p.ri, p.ci)
+			progress = true
+		}
+		if !progress {
+			break
+		}
+	}
+
+	if assigned > 0 {
+		rest := make([]*Ride, 0, len(rides)-assigned)
+		for ri, r := range rides {
+			if !assignedR[ri] {
+				rest = append(rest, r)
+			}
+		}
+		s.Waiting = rest
+	}
+	if deferred && atomic.CompareAndSwapInt32(&retryScheduled, 0, 1) {
+		time.AfterFunc(guard+5*time.Millisecond, func() {
+			atomic.StoreInt32(&retryScheduled, 0)
+			triggerMatch()
+		})
+	}
+}
+
+func (s *State) assign(r *Ride, c *Chair, now time.Time) {
+	atomic.AddInt64(&statAssigned, 1)
+	statPickupDist += int64(calculateDistance(c.Lat, c.Lon, r.PickupLat, r.PickupLon))
+	statWaitNs += int64(now.Sub(r.CreatedAt))
+	statRideDist += int64(calculateDistance(r.PickupLat, r.PickupLon, r.DestLat, r.DestLon))
+	r.Chair = c
+	r.UpdatedAt = now
+	c.Current = r
+	c.Delivered = false
+	c.Reserved = false
+	c.Rides = append(c.Rides, r)
+	persist("UPDATE rides SET chair_id = ?, updated_at = ? WHERE id = ?", c.ID, now, r.ID)
+	c.notif.push(chairEvent(r, StMatching))
+	tracef("chair", c.ID, "event %s MATCHING (speed=%d pickup=%d)", r.ID, c.Speed, calculateDistance(c.Lat, c.Lon, r.PickupLat, r.PickupLon))
+}
