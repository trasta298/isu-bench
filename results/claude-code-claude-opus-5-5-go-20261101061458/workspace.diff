+flowtest/flowtest
diff --git a/tools/cmp.py b/tools/cmp.py
new file mode 100644
index 0000000..156ba1a
--- /dev/null
+++ b/tools/cmp.py
@@ -0,0 +1,20 @@
+import json, sys
+a = json.load(open(sys.argv[1])); b = json.load(open(sys.argv[2]))
+def norm(k, v):
+    st, body = v
+    if k.startswith("notif_") or k.startswith("cnotif_"):
+        if isinstance(body, dict) and "retry_after_ms" in body:
+            body = body.get("data")
+    if k.startswith("owner_sales") and isinstance(body, dict) and body.get("models"):
+        body["models"] = sorted(body["models"], key=lambda m: m["model"])
+    return st, body
+diff = 0
+for k in sorted(set(a) | set(b)):
+    if k not in a or k not in b:
+        print("missing", k); diff += 1; continue
+    x, y = norm(k, a[k]), norm(k, b[k])
+    if x != y:
+        diff += 1
+        if diff <= 8:
+            print("DIFF", k); print(" ref:", json.dumps(x, ensure_ascii=False)[:600]); print(" new:", json.dumps(y, ensure_ascii=False)[:600])
+print("total keys", len(a), "diffs", diff)
diff --git a/tools/deploy.sh b/tools/deploy.sh
new file mode 100755
index 0000000..95a099f
--- /dev/null
+++ b/tools/deploy.sh
@@ -0,0 +1,17 @@
+#!/bin/bash
+# Build and deploy: app -> s3, nginx config -> s1. DB lives on s2.
+set -e
+cd /work/webapp/go
+CGO_ENABLED=0 go build -o isuride .
+scp -q isuride s3:/tmp/isuride.new
+scp -q /work/tools/isuride.conf s1:/tmp/isuride.conf
+ssh s3 'set -e
+sudo systemctl stop isuride-go
+cp /tmp/isuride.new /home/isucon/webapp/go/isuride
+sudo systemctl start isuride-go
+sleep 1.5
+sudo journalctl -u isuride-go --no-pager -o cat | tail -2'
+ssh s1 'set -e
+sudo cp /tmp/isuride.conf /etc/nginx/sites-available/isuride.conf
+sudo nginx -t 2>/dev/null
+sudo systemctl reload nginx'
