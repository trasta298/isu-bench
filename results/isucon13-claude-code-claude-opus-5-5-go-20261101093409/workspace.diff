diff --git a/webapp/go/cache.go b/webapp/go/cache.go
new file mode 100644
index 0000000..ec073f7
--- /dev/null
+++ b/webapp/go/cache.go
@@ -0,0 +1,385 @@
+package main
+
+import (
+	"context"
+	"sync"
+
+	"github.com/jmoiron/sqlx"
+)
+
+// ---- users (immutable after creation: users + themes) ----
+
+type userEntry struct {
+	ID          int64  `db:"id"`
+	Name        string `db:"name"`
+	DisplayName string `db:"display_name"`
+	Description string `db:"description"`
+	ThemeID     int64  `db:"theme_id"`
+	DarkMode    bool   `db:"dark_mode"`
+}
+
+var (
+	userMu      sync.RWMutex
+	usersByID   = map[int64]*userEntry{}
+	usersByName = map[string]*userEntry{}
+)
+
+func resetUserCache() {
+	userMu.Lock()
+	usersByID = map[int64]*userEntry{}
+	usersByName = map[string]*userEntry{}
+	userMu.Unlock()
+}
+
+func putUserCache(u *userEntry) {
+	userMu.Lock()
+	usersByID[u.ID] = u
+	usersByName[u.Name] = u
+	userMu.Unlock()
+}
+
+const userSelect = "SELECT u.id, u.name, u.display_name, u.description, t.id AS theme_id, t.dark_mode FROM users u INNER JOIN themes t ON t.user_id = u.id"
+
+func getUserEntryByName(ctx context.Context, name string) (*userEntry, error) {
+	userMu.RLock()
+	u, ok := usersByName[name]
+	userMu.RUnlock()
+	if ok {
+		return u, nil
+	}
+	var e userEntry
+	if err := dbConn.GetContext(ctx, &e, userSelect+" WHERE u.name = ?", name); err != nil {
+		return nil, err
+	}
+	putUserCache(&e)
+	return &e, nil
+}
+
+func getUserEntryByID(ctx context.Context, id int64) (*userEntry, error) {
+	userMu.RLock()
+	u, ok := usersByID[id]
+	userMu.RUnlock()
+	if ok {
+		return u, nil
+	}
+	var e userEntry
+	if err := dbConn.GetContext(ctx, &e, userSelect+" WHERE u.id = ?", id); err != nil {
+		return nil, err
+	}
+	putUserCache(&e)
+	return &e, nil
+}
+
+func getUserEntries(ctx context.Context, ids []int64) (map[int64]*userEntry, error) {
+	res := make(map[int64]*userEntry, len(ids))
+	var miss []int64
+	userMu.RLock()
+	for _, id := range ids {
+		if u, ok := usersByID[id]; ok {
+			res[id] = u
+		} else if _, dup := res[id]; !dup {
+			miss = append(miss, id)
+		}
+	}
+	userMu.RUnlock()
+	if len(miss) > 0 {
+		q, args, err := sqlx.In(userSelect+" WHERE u.id IN (?)", miss)
+		if err != nil {
+			return nil, err
+		}
+		var es []*userEntry
+		if err := dbConn.SelectContext(ctx, &es, q, args...); err != nil {
+			return nil, err
+		}
+		for _, e := range es {
+			putUserCache(e)
+			res[e.ID] = e
+		}
+	}
+	return res, nil
+}
+
+// ---- icon hashes (in-memory on every app server; updates broadcast to peers) ----
+
+var (
+	iconMu     sync.RWMutex
+	iconHashes = map[int64]string{}
+)
+
+func loadIconHashes() error {
+	type row struct {
+		UserID int64  `db:"user_id"`
+		Hash   string `db:"hash"`
+	}
+	var rows []row
+	if err := dbConn.Select(&rows, "SELECT user_id, hash FROM icons"); err != nil {
+		return err
+	}
+	m := make(map[int64]string, len(rows))
+	for _, r := range rows {
+		m[r.UserID] = r.Hash
+	}
+	iconMu.Lock()
+	iconHashes = m
+	iconMu.Unlock()
+	return nil
+}
+
+func setIconHash(userID int64, hash string) {
+	iconMu.Lock()
+	iconHashes[userID] = hash
+	iconMu.Unlock()
+}
+
+func getIconHash(userID int64) (string, bool) {
+	iconMu.RLock()
+	h, ok := iconHashes[userID]
+	iconMu.RUnlock()
+	return h, ok
+}
+
+func getIconHashes(ctx context.Context, ids []int64) (map[int64]string, error) {
+	res := make(map[int64]string, len(ids))
+	iconMu.RLock()
+	for _, id := range ids {
+		if h, ok := iconHashes[id]; ok {
+			res[id] = h
+		}
+	}
+	iconMu.RUnlock()
+	return res, nil
+}
+
+func toUser(e *userEntry, hashes map[int64]string) User {
+	h, ok := hashes[e.ID]
+	if !ok {
+		h = fallbackImageHash
+	}
+	return User{
+		ID:          e.ID,
+		Name:        e.Name,
+		DisplayName: e.DisplayName,
+		Description: e.Description,
+		Theme: Theme{
+			ID:       e.ThemeID,
+			DarkMode: e.DarkMode,
+		},
+		IconHash: h,
+	}
+}
+
+func uniqIDs(ids []int64) []int64 {
+	seen := make(map[int64]struct{}, len(ids))
+	out := make([]int64, 0, len(ids))
+	for _, id := range ids {
+		if _, ok := seen[id]; ok {
+			continue
+		}
+		seen[id] = struct{}{}
+		out = append(out, id)
+	}
+	return out
+}
+
+// buildUsers returns User responses for the given ids.
+func buildUsers(ctx context.Context, ids []int64) (map[int64]User, error) {
+	ids = uniqIDs(ids)
+	entries, err := getUserEntries(ctx, ids)
+	if err != nil {
+		return nil, err
+	}
+	hashes, err := getIconHashes(ctx, ids)
+	if err != nil {
+		return nil, err
+	}
+	res := make(map[int64]User, len(ids))
+	for id, e := range entries {
+		res[id] = toUser(e, hashes)
+	}
+	return res, nil
+}
+
+func buildUser(ctx context.Context, id int64) (User, error) {
+	e, err := getUserEntryByID(ctx, id)
+	if err != nil {
+		return User{}, err
+	}
+	hashes, err := getIconHashes(ctx, []int64{id})
+	if err != nil {
+		return User{}, err
+	}
+	return toUser(e, hashes), nil
+}
+
+// ---- tags (static) ----
+
+var (
+	tagMu     sync.RWMutex
+	tagsByID  = map[int64]Tag{}
+	tagByName = map[string]int64{}
+	allTags   []*Tag
+)
+
+func loadTags() error {
+	var tagModels []*TagModel
+	if err := dbConn.Select(&tagModels, "SELECT * FROM tags ORDER BY id"); err != nil {
+		return err
+	}
+	byID := make(map[int64]Tag, len(tagModels))
+	byName := make(map[string]int64, len(tagModels))
+	all := make([]*Tag, len(tagModels))
+	for i, t := range tagModels {
+		byID[t.ID] = Tag{ID: t.ID, Name: t.Name}
+		byName[t.Name] = t.ID
+		all[i] = &Tag{ID: t.ID, Name: t.Name}
+	}
+	tagMu.Lock()
+	tagsByID = byID
+	tagByName = byName
+	allTags = all
+	tagMu.Unlock()
+	return nil
+}
+
+func getTag(id int64) (Tag, bool) {
+	tagMu.RLock()
+	t, ok := tagsByID[id]
+	tagMu.RUnlock()
+	return t, ok
+}
+
+// ---- livestreams (immutable after creation: livestreams + livestream_tags) ----
+
+type lsEntry struct {
+	Model LivestreamModel
+	Tags  []Tag
+}
+
+var (
+	lsMu   sync.RWMutex
+	lsByID = map[int64]*lsEntry{}
+)
+
+func resetLivestreamCache() {
+	lsMu.Lock()
+	lsByID = map[int64]*lsEntry{}
+	lsMu.Unlock()
+}
+
+func getLivestreamEntries(ctx context.Context, ids []int64) (map[int64]*lsEntry, error) {
+	res := make(map[int64]*lsEntry, len(ids))
+	var miss []int64
+	lsMu.RLock()
+	for _, id := range ids {
+		if e, ok := lsByID[id]; ok {
+			res[id] = e
+		} else {
+			miss = append(miss, id)
+		}
+	}
+	lsMu.RUnlock()
+	miss = uniqIDs(miss)
+	if len(miss) == 0 {
+		return res, nil
+	}
+	var models []LivestreamModel
+	var tagRows []LivestreamTagModel
+	if len(miss) == 1 {
+		if err := dbConn.SelectContext(ctx, &models, "SELECT * FROM livestreams WHERE id = ?", miss[0]); err != nil {
+			return nil, err
+		}
+		if err := dbConn.SelectContext(ctx, &tagRows, "SELECT * FROM livestream_tags WHERE livestream_id = ? ORDER BY id", miss[0]); err != nil {
+			return nil, err
+		}
+	} else {
+		q, args, err := sqlx.In("SELECT * FROM livestreams WHERE id IN (?)", miss)
+		if err != nil {
+			return nil, err
+		}
+		if err := dbConn.SelectContext(ctx, &models, q, args...); err != nil {
+			return nil, err
+		}
+		q, args, err = sqlx.In("SELECT * FROM livestream_tags WHERE livestream_id IN (?) ORDER BY id", miss)
+		if err != nil {
+			return nil, err
+		}
+		if err := dbConn.SelectContext(ctx, &tagRows, q, args...); err != nil {
+			return nil, err
+		}
+	}
+	tagMap := map[int64][]Tag{}
+	for _, tr := range tagRows {
+		t, _ := getTag(tr.TagID)
+		tagMap[tr.LivestreamID] = append(tagMap[tr.LivestreamID], t)
+	}
+	lsMu.Lock()
+	for _, m := range models {
+		tags := tagMap[m.ID]
+		if tags == nil {
+			tags = []Tag{}
+		}
+		e := &lsEntry{Model: m, Tags: tags}
+		lsByID[m.ID] = e
+		res[m.ID] = e
+	}
+	lsMu.Unlock()
+	return res, nil
+}
+
+func getLivestreamEntry(ctx context.Context, id int64) (*lsEntry, error) {
+	m, err := getLivestreamEntries(ctx, []int64{id})
+	if err != nil {
+		return nil, err
+	}
+	e, ok := m[id]
+	if !ok {
+		return nil, errNotFound
+	}
+	return e, nil
+}
+
+func putLivestreamCache(e *lsEntry) {
+	lsMu.Lock()
+	lsByID[e.Model.ID] = e
+	lsMu.Unlock()
+}
+
+func toLivestream(e *lsEntry, owner User) Livestream {
+	return Livestream{
+		ID:           e.Model.ID,
+		Owner:        owner,
+		Title:        e.Model.Title,
+		Tags:         e.Tags,
+		Description:  e.Model.Description,
+		PlaylistUrl:  e.Model.PlaylistUrl,
+		ThumbnailUrl: e.Model.ThumbnailUrl,
+		StartAt:      e.Model.StartAt,
+		EndAt:        e.Model.EndAt,
+	}
+}
+
+// buildLivestreams builds responses for the given livestream ids in order.
+func buildLivestreams(ctx context.Context, ids []int64, extraUserIDs []int64) ([]Livestream, map[int64]User, error) {
+	entries, err := getLivestreamEntries(ctx, ids)
+	if err != nil {
+		return nil, nil, err
+	}
+	userIDs := make([]int64, 0, len(entries)+len(extraUserIDs))
+	for _, e := range entries {
+		userIDs = append(userIDs, e.Model.UserID)
+	}
+	userIDs = append(userIDs, extraUserIDs...)
+	users, err := buildUsers(ctx, userIDs)
+	if err != nil {
+		return nil, nil, err
+	}
+	out := make([]Livestream, 0, len(ids))
+	for _, id := range ids {
+		e, ok := entries[id]
+		if !ok {
+			return nil, nil, errNotFound
+		}
+		out = append(out, toLivestream(e, users[e.Model.UserID]))
+	}
+	return out, users, nil
+}
diff --git a/webapp/go/dns.go b/webapp/go/dns.go
new file mode 100644
index 0000000..bd52e3c
--- /dev/null
+++ b/webapp/go/dns.go
@@ -0,0 +1,248 @@
+package main
+
+import (
+	"math/rand"
+	"bufio"
+	"fmt"
+	"hash/fnv"
+	"log"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/labstack/echo/v4"
+	"github.com/miekg/dns"
+)
+
+const dnsZone = "u.isucon.dev."
+
+var (
+	dnsEnabled  bool
+	dnsMu       sync.RWMutex
+	dnsNames    = map[string]struct{}{}
+	dnsStatic   = map[string]struct{}{}
+	dnsMainIP   net.IP
+	dnsUserIPs  []net.IP
+	dnsPipeIPs  []net.IP
+	dnsPipeTTL  uint32 = 600
+	dnsTTL      uint32 = 600
+	dnsSOA      dns.RR
+	dnsAddURL   string
+	dnsHTTPClnt = &http.Client{Timeout: 3 * time.Second}
+)
+
+func loadZoneNames(path string) {
+	f, err := os.Open(path)
+	if err != nil {
+		log.Printf("dns: cannot open zone file: %v", err)
+		return
+	}
+	defer f.Close()
+	sc := bufio.NewScanner(f)
+	for sc.Scan() {
+		fields := strings.Fields(sc.Text())
+		if len(fields) >= 4 && fields[len(fields)-2] == "A" {
+			label := strings.ToLower(fields[0])
+			if label == "@" {
+				continue
+			}
+			dnsStatic[label] = struct{}{}
+		}
+	}
+}
+
+func startDNS(listen string) {
+	dnsEnabled = true
+	dnsMainIP = net.ParseIP(powerDNSSubdomainAddress).To4()
+	if v := os.Getenv("ISUPIPE_DNS_USER_IPS"); v != "" {
+		for _, s := range strings.Split(v, ",") {
+			if ip := net.ParseIP(strings.TrimSpace(s)).To4(); ip != nil {
+				dnsUserIPs = append(dnsUserIPs, ip)
+			}
+		}
+	}
+	if len(dnsUserIPs) == 0 {
+		dnsUserIPs = []net.IP{dnsMainIP}
+	}
+	if v := os.Getenv("ISUPIPE_DNS_PIPE_IPS"); v != "" {
+		for _, s := range strings.Split(v, ",") {
+			if ip := net.ParseIP(strings.TrimSpace(s)).To4(); ip != nil {
+				dnsPipeIPs = append(dnsPipeIPs, ip)
+			}
+		}
+	}
+	if len(dnsPipeIPs) == 0 {
+		dnsPipeIPs = []net.IP{dnsMainIP}
+	}
+	if v := os.Getenv("ISUPIPE_DNS_PIPE_TTL"); v != "" {
+		if n, err := strconv.Atoi(v); err == nil {
+			dnsPipeTTL = uint32(n)
+		}
+	}
+	if v := os.Getenv("ISUPIPE_DNS_TTL"); v != "" {
+		if n, err := strconv.Atoi(v); err == nil {
+			dnsTTL = uint32(n)
+		}
+	}
+	soa, err := dns.NewRR(fmt.Sprintf("%s 3600 IN SOA ns1.%s hostmaster.%s 0 10800 3600 604800 3600", dnsZone, dnsZone, dnsZone))
+	if err != nil {
+		log.Fatalf("dns soa: %v", err)
+	}
+	dnsSOA = soa
+	loadZoneNames("../pdns/u.isucon.dev.zone")
+	dnsMu.Lock()
+	for k := range dnsStatic {
+		dnsNames[k] = struct{}{}
+	}
+	dnsMu.Unlock()
+
+	dns.HandleFunc(".", handleDNS)
+	n := 2
+	for i := 0; i < n; i++ {
+		srv := &dns.Server{Addr: listen, Net: "udp", ReusePort: true, UDPSize: 4096}
+		go func() {
+			if err := srv.ListenAndServe(); err != nil {
+				log.Fatalf("dns server: %v", err)
+			}
+		}()
+	}
+	log.Printf("dns: listening on %s", listen)
+}
+
+func reloadDNSUsers() error {
+	var names []string
+	if err := dbConn.Select(&names, "SELECT name FROM users"); err != nil {
+		return err
+	}
+	m := make(map[string]struct{}, len(names)+len(dnsStatic))
+	for k := range dnsStatic {
+		m[k] = struct{}{}
+	}
+	for _, n := range names {
+		m[strings.ToLower(n)] = struct{}{}
+	}
+	dnsMu.Lock()
+	dnsNames = m
+	dnsMu.Unlock()
+	return nil
+}
+
+func dnsIPFor(label string) net.IP {
+	switch label {
+	case "", "pipe", "ns1":
+		return dnsMainIP
+	}
+	if len(dnsUserIPs) == 1 {
+		return dnsUserIPs[0]
+	}
+	h := fnv.New32a()
+	h.Write([]byte(label))
+	return dnsUserIPs[h.Sum32()%uint32(len(dnsUserIPs))]
+}
+
+func handleDNS(w dns.ResponseWriter, r *dns.Msg) {
+	m := new(dns.Msg)
+	m.SetReply(r)
+	m.Authoritative = true
+	if len(r.Question) != 1 {
+		m.Rcode = dns.RcodeFormatError
+		w.WriteMsg(m)
+		return
+	}
+	q := r.Question[0]
+	name := strings.ToLower(q.Name)
+	if !strings.HasSuffix(name, dnsZone) {
+		m.Rcode = dns.RcodeRefused
+		m.Authoritative = false
+		w.WriteMsg(m)
+		return
+	}
+	label := strings.TrimSuffix(strings.TrimSuffix(name, dnsZone), ".")
+	ok := label == ""
+	if !ok {
+		dnsMu.RLock()
+		_, ok = dnsNames[label]
+		dnsMu.RUnlock()
+	}
+	if !ok {
+		m.Rcode = dns.RcodeNameError
+		m.Ns = []dns.RR{dnsSOA}
+		w.WriteMsg(m)
+		return
+	}
+	switch q.Qtype {
+	case dns.TypeA, dns.TypeANY:
+		ip, ttl := dnsIPFor(label), dnsTTL
+		if label == "pipe" {
+			ip = dnsPipeIPs[rand.Intn(len(dnsPipeIPs))]
+			ttl = dnsPipeTTL
+		}
+		m.Answer = []dns.RR{&dns.A{
+			Hdr: dns.RR_Header{Name: q.Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: ttl},
+			A:   ip,
+		}}
+	case dns.TypeSOA:
+		if label == "" {
+			m.Answer = []dns.RR{dnsSOA}
+		} else {
+			m.Ns = []dns.RR{dnsSOA}
+		}
+	case dns.TypeNS:
+		if label == "" {
+			m.Answer = []dns.RR{&dns.NS{
+				Hdr: dns.RR_Header{Name: q.Name, Rrtype: dns.TypeNS, Class: dns.ClassINET, Ttl: 3600},
+				Ns:  "ns1." + dnsZone,
+			}}
+		} else {
+			m.Ns = []dns.RR{dnsSOA}
+		}
+	default:
+		m.Ns = []dns.RR{dnsSOA}
+	}
+	w.WriteMsg(m)
+}
+
+func dnsAddLocal(name string) {
+	dnsMu.Lock()
+	dnsNames[strings.ToLower(name)] = struct{}{}
+	dnsMu.Unlock()
+}
+
+func dnsAddName(name string) error {
+	if dnsEnabled {
+		dnsAddLocal(name)
+		return nil
+	}
+	if dnsAddURL == "" {
+		dnsAddURL = os.Getenv("ISUPIPE_DNS_ADD_URL")
+	}
+	if dnsAddURL == "" {
+		return nil
+	}
+	resp, err := dnsHTTPClnt.PostForm(dnsAddURL, url.Values{"name": {name}})
+	if err != nil {
+		return err
+	}
+	resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("dns add status %d", resp.StatusCode)
+	}
+	return nil
+}
+
+func internalDNSAddHandler(c echo.Context) error {
+	name := c.FormValue("name")
+	if name == "" {
+		return c.NoContent(http.StatusBadRequest)
+	}
+	if !dnsEnabled {
+		return c.NoContent(http.StatusServiceUnavailable)
+	}
+	dnsAddLocal(name)
+	return c.NoContent(http.StatusOK)
+}
diff --git a/webapp/go/fastjson.go b/webapp/go/fastjson.go
new file mode 100644
index 0000000..19019eb
--- /dev/null
+++ b/webapp/go/fastjson.go
@@ -0,0 +1,368 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"strconv"
+	"sync"
+	"unicode/utf8"
+)
+
+// ---- JSON string escaping compatible with encoding/json (without HTML escaping) ----
+
+const hexDigits = "0123456789abcdef"
+
+func appendJSONString(dst []byte, s string) []byte {
+	dst = append(dst, '"')
+	start := 0
+	for i := 0; i < len(s); {
+		b := s[i]
+		if b < utf8.RuneSelf {
+			if b >= 0x20 && b != '"' && b != '\\' {
+				i++
+				continue
+			}
+			dst = append(dst, s[start:i]...)
+			switch b {
+			case '"':
+				dst = append(dst, '\\', '"')
+			case '\\':
+				dst = append(dst, '\\', '\\')
+			case '\n':
+				dst = append(dst, '\\', 'n')
+			case '\r':
+				dst = append(dst, '\\', 'r')
+			case '\t':
+				dst = append(dst, '\\', 't')
+			default:
+				dst = append(dst, '\\', 'u', '0', '0', hexDigits[b>>4], hexDigits[b&0xF])
+			}
+			i++
+			start = i
+			continue
+		}
+		r, size := utf8.DecodeRuneInString(s[i:])
+		if r == utf8.RuneError && size == 1 {
+			dst = append(dst, s[start:i]...)
+			dst = append(dst, `\ufffd`...)
+			i += size
+			start = i
+			continue
+		}
+		if r == '\u2028' || r == '\u2029' {
+			dst = append(dst, s[start:i]...)
+			dst = append(dst, '\\', 'u', '2', '0', '2', hexDigits[r&0xF])
+			i += size
+			start = i
+			continue
+		}
+		i += size
+	}
+	dst = append(dst, s[start:]...)
+	dst = append(dst, '"')
+	return dst
+}
+
+// ---- cached fragments ----
+
+type cachedFrag struct {
+	hash string
+	b    []byte
+}
+
+var (
+	userJSONMu    sync.RWMutex
+	userJSONCache = map[int64]cachedFrag{}
+	lsJSONMu      sync.RWMutex
+	lsJSONCache   = map[int64]cachedFrag{}
+)
+
+func resetJSONCaches() {
+	userJSONMu.Lock()
+	userJSONCache = map[int64]cachedFrag{}
+	userJSONMu.Unlock()
+	lsJSONMu.Lock()
+	lsJSONCache = map[int64]cachedFrag{}
+	lsJSONMu.Unlock()
+}
+
+func iconHashOf(id int64) string {
+	h, ok := getIconHash(id)
+	if !ok {
+		return fallbackImageHash
+	}
+	return h
+}
+
+func buildUserJSON(e *userEntry, hash string) []byte {
+	b := make([]byte, 0, 256)
+	b = append(b, `{"id":`...)
+	b = strconv.AppendInt(b, e.ID, 10)
+	b = append(b, `,"name":`...)
+	b = appendJSONString(b, e.Name)
+	if e.DisplayName != "" {
+		b = append(b, `,"display_name":`...)
+		b = appendJSONString(b, e.DisplayName)
+	}
+	if e.Description != "" {
+		b = append(b, `,"description":`...)
+		b = appendJSONString(b, e.Description)
+	}
+	b = append(b, `,"theme":{"id":`...)
+	b = strconv.AppendInt(b, e.ThemeID, 10)
+	if e.DarkMode {
+		b = append(b, `,"dark_mode":true}`...)
+	} else {
+		b = append(b, `,"dark_mode":false}`...)
+	}
+	if hash != "" {
+		b = append(b, `,"icon_hash":`...)
+		b = appendJSONString(b, hash)
+	}
+	b = append(b, '}')
+	return b
+}
+
+func userJSON(e *userEntry) []byte {
+	hash := iconHashOf(e.ID)
+	userJSONMu.RLock()
+	f, ok := userJSONCache[e.ID]
+	userJSONMu.RUnlock()
+	if ok && f.hash == hash {
+		return f.b
+	}
+	b := buildUserJSON(e, hash)
+	userJSONMu.Lock()
+	userJSONCache[e.ID] = cachedFrag{hash: hash, b: b}
+	userJSONMu.Unlock()
+	return b
+}
+
+func livestreamJSON(ls *lsEntry, owner *userEntry) []byte {
+	hash := iconHashOf(owner.ID)
+	lsJSONMu.RLock()
+	f, ok := lsJSONCache[ls.Model.ID]
+	lsJSONMu.RUnlock()
+	if ok && f.hash == hash {
+		return f.b
+	}
+	m := &ls.Model
+	b := make([]byte, 0, 1024)
+	b = append(b, `{"id":`...)
+	b = strconv.AppendInt(b, m.ID, 10)
+	b = append(b, `,"owner":`...)
+	b = append(b, userJSON(owner)...)
+	b = append(b, `,"title":`...)
+	b = appendJSONString(b, m.Title)
+	b = append(b, `,"description":`...)
+	b = appendJSONString(b, m.Description)
+	b = append(b, `,"playlist_url":`...)
+	b = appendJSONString(b, m.PlaylistUrl)
+	b = append(b, `,"thumbnail_url":`...)
+	b = appendJSONString(b, m.ThumbnailUrl)
+	b = append(b, `,"tags":[`...)
+	for i, t := range ls.Tags {
+		if i > 0 {
+			b = append(b, ',')
+		}
+		b = append(b, `{"id":`...)
+		b = strconv.AppendInt(b, t.ID, 10)
+		b = append(b, `,"name":`...)
+		b = appendJSONString(b, t.Name)
+		b = append(b, '}')
+	}
+	b = append(b, `],"start_at":`...)
+	b = strconv.AppendInt(b, m.StartAt, 10)
+	b = append(b, `,"end_at":`...)
+	b = strconv.AppendInt(b, m.EndAt, 10)
+	b = append(b, '}')
+	lsJSONMu.Lock()
+	lsJSONCache[m.ID] = cachedFrag{hash: hash, b: b}
+	lsJSONMu.Unlock()
+	return b
+}
+
+// livestreamsJSONArray renders livestreams (by id, in order) as a JSON array.
+func livestreamsJSONArray(ctx context.Context, ids []int64) ([]byte, error) {
+	entries, err := getLivestreamEntries(ctx, ids)
+	if err != nil {
+		return nil, err
+	}
+	ownerIDs := make([]int64, 0, len(entries))
+	for _, e := range entries {
+		ownerIDs = append(ownerIDs, e.Model.UserID)
+	}
+	owners, err := getUserEntries(ctx, uniqIDs(ownerIDs))
+	if err != nil {
+		return nil, err
+	}
+	b := make([]byte, 0, 1024*len(ids)+2)
+	b = append(b, '[')
+	for i, id := range ids {
+		e, ok := entries[id]
+		if !ok {
+			return nil, errNotFound
+		}
+		o, ok := owners[e.Model.UserID]
+		if !ok {
+			return nil, errNotFound
+		}
+		if i > 0 {
+			b = append(b, ',')
+		}
+		b = append(b, livestreamJSON(e, o)...)
+	}
+	b = append(b, ']')
+	return b, nil
+}
+
+// commentLike is a livecomment or reaction row
+type commentLike struct {
+	ID           int64
+	UserID       int64
+	LivestreamID int64
+	CreatedAt    int64
+	// livecomment
+	Comment string
+	Tip     int64
+	// reaction
+	EmojiName  string
+	isReaction bool
+}
+
+func commentsJSON(ctx context.Context, rows []commentLike, array bool) ([]byte, error) {
+	lsIDs := make([]int64, 0, 2)
+	seen := map[int64]struct{}{}
+	userIDs := make([]int64, 0, len(rows)+2)
+	for _, r := range rows {
+		if _, ok := seen[r.LivestreamID]; !ok {
+			seen[r.LivestreamID] = struct{}{}
+			lsIDs = append(lsIDs, r.LivestreamID)
+		}
+		userIDs = append(userIDs, r.UserID)
+	}
+	lss, err := getLivestreamEntries(ctx, lsIDs)
+	if err != nil {
+		return nil, err
+	}
+	for _, l := range lss {
+		userIDs = append(userIDs, l.Model.UserID)
+	}
+	users, err := getUserEntries(ctx, uniqIDs(userIDs))
+	if err != nil {
+		return nil, err
+	}
+	lsFrag := make(map[int64][]byte, len(lss))
+	for id, l := range lss {
+		o, ok := users[l.Model.UserID]
+		if !ok {
+			return nil, errNotFound
+		}
+		lsFrag[id] = livestreamJSON(l, o)
+	}
+	b := make([]byte, 0, 2048*len(rows)+2)
+	if array {
+		b = append(b, '[')
+	}
+	for i, r := range rows {
+		u, ok := users[r.UserID]
+		if !ok {
+			return nil, errNotFound
+		}
+		lf, ok := lsFrag[r.LivestreamID]
+		if !ok {
+			return nil, errNotFound
+		}
+		if i > 0 {
+			b = append(b, ',')
+		}
+		b = append(b, `{"id":`...)
+		b = strconv.AppendInt(b, r.ID, 10)
+		if r.isReaction {
+			b = append(b, `,"emoji_name":`...)
+			b = appendJSONString(b, r.EmojiName)
+			b = append(b, `,"user":`...)
+			b = append(b, userJSON(u)...)
+			b = append(b, `,"livestream":`...)
+			b = append(b, lf...)
+		} else {
+			b = append(b, `,"user":`...)
+			b = append(b, userJSON(u)...)
+			b = append(b, `,"livestream":`...)
+			b = append(b, lf...)
+			b = append(b, `,"comment":`...)
+			b = appendJSONString(b, r.Comment)
+			b = append(b, `,"tip":`...)
+			b = strconv.AppendInt(b, r.Tip, 10)
+		}
+		b = append(b, `,"created_at":`...)
+		b = strconv.AppendInt(b, r.CreatedAt, 10)
+		b = append(b, '}')
+	}
+	if array {
+		b = append(b, ']')
+	}
+	return b, nil
+}
