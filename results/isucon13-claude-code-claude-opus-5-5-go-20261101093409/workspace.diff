+func reactionRows(ms []ReactionModel) []commentLike {
+	out := make([]commentLike, len(ms))
+	for i, m := range ms {
+		out[i] = commentLike{ID: m.ID, UserID: m.UserID, LivestreamID: m.LivestreamID, CreatedAt: m.CreatedAt, EmojiName: m.EmojiName, isReaction: true}
+	}
