diff --git a/webapp/go/tlsserver.go b/webapp/go/tlsserver.go
new file mode 100644
index 0000000..72e3683
--- /dev/null
+++ b/webapp/go/tlsserver.go
@@ -0,0 +1,107 @@
+package main
+
+import (
+	"crypto/tls"
+	"log"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/labstack/echo/v4"
+)
+
+const publicDir = "/home/isucon/webapp/public"
+
+// same as nginx mime.types
+var nginxMime = map[string]string{
+	".html": "text/html", ".htm": "text/html", ".css": "text/css", ".js": "application/javascript",
+	".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif",
+	".ico": "image/x-icon", ".svg": "image/svg+xml", ".webp": "image/webp", ".json": "application/json",
+	".txt": "text/plain",
+}
+
+func setMime(w http.ResponseWriter, name string) {
+	if ct, ok := nginxMime[strings.ToLower(filepath.Ext(name))]; ok {
+		w.Header().Set("Content-Type", ct)
+	} else {
+		w.Header().Set("Content-Type", "application/octet-stream")
+	}
+}
+
+// serveStatic emulates nginx `try_files $uri /index.html`.
+func serveStatic(w http.ResponseWriter, r *http.Request) {
+	p := filepath.Clean("/" + r.URL.Path)
+	full := filepath.Join(publicDir, p)
+	f, err := os.Open(full)
+	if err == nil {
+		st, err2 := f.Stat()
+		if err2 == nil && !st.IsDir() {
+			defer f.Close()
+			setMime(w, st.Name())
+			http.ServeContent(w, r, st.Name(), st.ModTime(), f)
+			return
+		}
+		f.Close()
+	}
+	idx, err := os.Open(filepath.Join(publicDir, "index.html"))
+	if err != nil {
+		http.NotFound(w, r)
+		return
+	}
+	defer idx.Close()
+	st, err := idx.Stat()
+	if err != nil {
+		http.NotFound(w, r)
+		return
+	}
+	setMime(w, "index.html")
+	http.ServeContent(w, r, "index.html", st.ModTime(), idx)
+}
+
+func startTLS(e *echo.Echo) {
+	certFile := os.Getenv("ISUPIPE_TLS_CERT")
+	keyFile := os.Getenv("ISUPIPE_TLS_KEY")
+	if certFile == "" || keyFile == "" {
+		return
+	}
+	cert, err := tls.LoadX509KeyPair(certFile, keyFile)
+	if err != nil {
+		log.Fatalf("tls cert: %v", err)
+	}
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if strings.HasPrefix(r.URL.Path, "/api/internal/") {
+			http.NotFound(w, r)
+			return
+		}
+		if strings.HasPrefix(r.URL.Path, "/api") {
+			e.ServeHTTP(w, r)
+			return
+		}
+		serveStatic(w, r)
+	})
+	srv := &http.Server{
+		Handler: handler,
+		TLSConfig: &tls.Config{
+			Certificates: []tls.Certificate{cert},
+			MinVersion:   tls.VersionTLS12,
+		},
+		// HTTP/1.1 only (same as the previous nginx setup)
+		TLSNextProto: map[string]func(*http.Server, *tls.Conn, http.Handler){},
+	}
+	addr := os.Getenv("ISUPIPE_TLS_LISTEN")
+	if addr == "" {
+		addr = ":443"
+	}
+	ln, err := net.Listen("tcp", addr)
+	if err != nil {
+		log.Fatalf("tls listen: %v", err)
+	}
+	go func() {
+		if err := srv.ServeTLS(ln, "", ""); err != nil {
+			log.Printf("tls serve: %v", err)
+		}
+	}()
+	log.Printf("tls: listening on %s", addr)
+}
