diff --git a/webapp/go/lsindex.go b/webapp/go/lsindex.go
new file mode 100644
index 0000000..a008808
--- /dev/null
+++ b/webapp/go/lsindex.go
@@ -0,0 +1,243 @@
+package main
+
+import (
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/labstack/echo/v4"
+)
+
+// ---- in-memory livestream index (livestreams/livestream_tags are insert-only) ----
+
+var (
+	idxMu     sync.RWMutex
+	idxLoaded bool
+	idxSeen   = map[int64]bool{}
+	idxAll    []int64
+	idxByUser = map[int64][]int64{}
+	idxByTag  = map[int64][]int64{}
+	idxRecent []idxItem // items added since last reset (merged on reload)
+)
+
+type idxItem struct {
+	ID     int64
+	UserID int64
+	TagIDs []int64
+}
+
+func insertSorted(s []int64, v int64) []int64 {
+	i := sort.Search(len(s), func(i int) bool { return s[i] > v })
+	s = append(s, 0)
+	copy(s[i+1:], s[i:])
+	s[i] = v
+	return s
+}
+
+func idxAddLocked(it idxItem) {
+	if idxSeen[it.ID] {
+		return
+	}
+	idxSeen[it.ID] = true
+	idxAll = insertSorted(idxAll, it.ID)
+	idxByUser[it.UserID] = insertSorted(idxByUser[it.UserID], it.ID)
+	for _, t := range it.TagIDs {
+		idxByTag[t] = insertSorted(idxByTag[t], it.ID)
+	}
+}
+
+func indexAdd(it idxItem) {
+	idxMu.Lock()
+	idxRecent = append(idxRecent, it)
+	if idxLoaded {
+		idxAddLocked(it)
+	}
+	idxMu.Unlock()
+}
+
+func loadLsIndex() error {
+	idxMu.Lock()
+	idxLoaded = false
+	idxRecent = nil
+	idxMu.Unlock()
+
+	type lsRow struct {
+		ID     int64 `db:"id"`
+		UserID int64 `db:"user_id"`
+	}
+	var rows []lsRow
+	if err := dbConn.Select(&rows, "SELECT id, user_id FROM livestreams ORDER BY id"); err != nil {
+		return err
+	}
+	var tagRows []LivestreamTagModel
+	if err := dbConn.Select(&tagRows, "SELECT * FROM livestream_tags ORDER BY livestream_id, id"); err != nil {
+		return err
+	}
+	tagsOf := map[int64][]int64{}
+	for _, t := range tagRows {
+		tagsOf[t.LivestreamID] = append(tagsOf[t.LivestreamID], t.TagID)
+	}
+	idxMu.Lock()
+	defer idxMu.Unlock()
+	idxSeen = make(map[int64]bool, len(rows)+1024)
+	idxAll = make([]int64, 0, len(rows)+1024)
+	idxByUser = map[int64][]int64{}
+	idxByTag = map[int64][]int64{}
+	for _, r := range rows {
+		idxSeen[r.ID] = true
+		idxAll = append(idxAll, r.ID)
+		idxByUser[r.UserID] = append(idxByUser[r.UserID], r.ID)
+		for _, t := range tagsOf[r.ID] {
+			idxByTag[t] = append(idxByTag[t], r.ID)
+		}
+	}
+	for _, it := range idxRecent {
+		idxAddLocked(it)
+	}
+	idxLoaded = true
+	return nil
+}
+
+// idxSearchAll returns ids DESC (limit<0: all)
+func idxSearchAll(limit int) ([]int64, bool) {
+	idxMu.RLock()
+	defer idxMu.RUnlock()
+	if !idxLoaded {
+		return nil, false
+	}
+	n := len(idxAll)
+	if limit >= 0 && limit < n {
+		n = limit
+	}
+	out := make([]int64, n)
+	for i := 0; i < n; i++ {
+		out[i] = idxAll[len(idxAll)-1-i]
+	}
+	return out, true
+}
+
+func idxSearchTag(tagID int64) ([]int64, bool) {
+	idxMu.RLock()
+	defer idxMu.RUnlock()
+	if !idxLoaded {
+		return nil, false
+	}
+	s := idxByTag[tagID]
+	out := make([]int64, len(s))
+	for i := range s {
+		out[i] = s[len(s)-1-i]
+	}
+	return out, true
+}
+
+func idxUser(userID int64) ([]int64, bool) {
+	idxMu.RLock()
+	defer idxMu.RUnlock()
+	if !idxLoaded {
+		return nil, false
+	}
+	s := idxByUser[userID]
+	out := make([]int64, len(s))
+	copy(out, s)
+	return out, true
+}
+
+func broadcastLivestream(id int64) {
+	if len(peerURLs) == 0 {
+		return
+	}
+	var wg sync.WaitGroup
+	for _, p := range peerURLs {
+		wg.Add(1)
+		go func(p string) {
+			defer wg.Done()
+			resp, err := dnsHTTPClnt.Post(p+"/api/internal/livestream?id="+strconv.FormatInt(id, 10), "text/plain", nil)
+			if err != nil {
+				log.Printf("broadcast livestream to %s failed: %v", p, err)
+				return
+			}
+			io.Copy(io.Discard, resp.Body)
+			resp.Body.Close()
+		}(p)
+	}
+	wg.Wait()
+}
+
+func internalLivestreamHandler(c echo.Context) error {
+	id, err := strconv.ParseInt(c.QueryParam("id"), 10, 64)
+	if err != nil {
+		return c.NoContent(http.StatusBadRequest)
+	}
+	e, err := getLivestreamEntry(c.Request().Context(), id)
+	if err != nil {
+		return c.NoContent(http.StatusInternalServerError)
+	}
+	tagIDs := make([]int64, len(e.Tags))
+	for i, t := range e.Tags {
+		tagIDs[i] = t.ID
+	}
+	indexAdd(idxItem{ID: id, UserID: e.Model.UserID, TagIDs: tagIDs})
+	return c.NoContent(http.StatusOK)
+}
+
+// ---- per-route timing ----
+
+type routeStat struct {
+	count int64
+	total int64
+	max   int64
+}
+
+var routeStats sync.Map
+
+func timingMiddleware(next echo.HandlerFunc) echo.HandlerFunc {
+	return func(c echo.Context) error {
+		start := time.Now()
+		err := next(c)
+		d := int64(time.Since(start))
+		key := c.Request().Method + " " + c.Path()
+		v, ok := routeStats.Load(key)
+		if !ok {
+			v, _ = routeStats.LoadOrStore(key, &routeStat{})
+		}
+		st := v.(*routeStat)
+		atomic.AddInt64(&st.count, 1)
+		atomic.AddInt64(&st.total, d)
+		for {
+			m := atomic.LoadInt64(&st.max)
+			if d <= m || atomic.CompareAndSwapInt64(&st.max, m, d) {
+				break
+			}
+		}
+		return err
+	}
+}
+
+func internalRouteStatsHandler(c echo.Context) error {
+	type row struct {
+		k            string
+		n, tot, maxd int64
+	}
+	var rows []row
+	routeStats.Range(func(k, v any) bool {
+		st := v.(*routeStat)
+		rows = append(rows, row{k.(string), atomic.LoadInt64(&st.count), atomic.LoadInt64(&st.total), atomic.LoadInt64(&st.max)})
+		return true
+	})
+	sort.Slice(rows, func(i, j int) bool { return rows[i].tot > rows[j].tot })
+	var b strings.Builder
+	for _, r := range rows {
+		fmt.Fprintf(&b, "%8d sum=%8.1fs avg=%7.2fms max=%7.1fms %s\n", r.n, float64(r.tot)/1e9, float64(r.tot)/float64(r.n)/1e6, float64(r.maxd)/1e6, r.k)
+	}
+	if c.QueryParam("reset") == "1" {
+		routeStats.Range(func(k, v any) bool { routeStats.Delete(k); return true })
+	}
+	return c.String(http.StatusOK, b.String())
+}
