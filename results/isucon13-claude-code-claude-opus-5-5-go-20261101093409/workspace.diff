new file mode 100644
index 0000000..9f94a9d
--- /dev/null
+++ b/webapp/go/owner.go
@@ -0,0 +1,226 @@
+package main
+
+import (
+	"context"
+	"net/http"
+	"net/http/httputil"
+	"net/url"
+	"os"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/labstack/echo/v4"
+)
+
+// Livestream-scoped livecomment/reaction data is owned by one server (ISUPIPE_LS_CACHE=1),
+// which keeps it in memory (write-through to DB). Other servers proxy those requests to it
+// (ISUPIPE_LS_OWNER_URL).
+
+var (
+	lsCacheEnabled bool
+	ownerProxy     *httputil.ReverseProxy
+)
+
+func setupOwner() {
+	lsCacheEnabled = os.Getenv("ISUPIPE_LS_CACHE") == "1"
+	if u := os.Getenv("ISUPIPE_LS_OWNER_URL"); u != "" {
+		target, err := url.Parse(u)
+		if err != nil {
+			panic(err)
+		}
+		rp := httputil.NewSingleHostReverseProxy(target)
+		rp.Transport = &http.Transport{
+			MaxIdleConns:        256,
+			MaxIdleConnsPerHost: 256,
+			IdleConnTimeout:     90 * time.Second,
+		}
+		ownerProxy = rp
+	}
+}
+
+// proxyIfNotOwner forwards the request to the owner server. Returns true if proxied.
+func proxyIfNotOwner(c echo.Context) bool {
+	if ownerProxy == nil {
+		return false
+	}
+	ownerProxy.ServeHTTP(c.Response(), c.Request())
+	return true
+}
+
+type lsData struct {
+	mu       sync.Mutex
+	lcLoaded bool
+	lcs      []LivecommentModel // sorted asc by (created_at, id)
+	rxLoaded bool
+	rxs      []ReactionModel // sorted asc by (created_at, id)
+}
+
+var (
+	lsDataMu sync.Mutex
+	lsDataM  = map[int64]*lsData{}
+)
+
+func resetLsData() {
+	lsDataMu.Lock()
+	lsDataM = map[int64]*lsData{}
+	lsDataMu.Unlock()
+}
+
+func getLsData(id int64) *lsData {
+	lsDataMu.Lock()
+	d, ok := lsDataM[id]
+	if !ok {
+		d = &lsData{}
+		lsDataM[id] = d
+	}
+	lsDataMu.Unlock()
+	return d
+}
+
+func lcLess(a, b *LivecommentModel) bool {
+	if a.CreatedAt != b.CreatedAt {
+		return a.CreatedAt < b.CreatedAt
+	}
+	return a.ID < b.ID
+}
+
+func rxLess(a, b *ReactionModel) bool {
+	if a.CreatedAt != b.CreatedAt {
+		return a.CreatedAt < b.CreatedAt
+	}
+	return a.ID < b.ID
+}
+
+// cachedLivecomments returns comments in DESC order (created_at DESC, id DESC) with optional limit.
+func cachedLivecomments(ctx context.Context, livestreamID int64, limit int, hasLimit bool) ([]LivecommentModel, error) {
+	d := getLsData(livestreamID)
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if !d.lcLoaded {
+		var ms []LivecommentModel
+		if err := dbConn.SelectContext(ctx, &ms, "SELECT * FROM livecomments WHERE livestream_id = ? ORDER BY created_at, id", livestreamID); err != nil {
+			return nil, err
+		}
+		d.lcs = ms
+		d.lcLoaded = true
+	}
+	n := len(d.lcs)
+	if hasLimit && limit < n {
+		n = limit
+	}
+	if n < 0 {
+		n = 0
+	}
+	out := make([]LivecommentModel, n)
+	for i := 0; i < n; i++ {
+		out[i] = d.lcs[len(d.lcs)-1-i]
+	}
+	return out, nil
+}
+
+func cacheAddLivecomment(m LivecommentModel) {
+	if !lsCacheEnabled {
+		return
+	}
+	d := getLsData(m.LivestreamID)
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if !d.lcLoaded {
+		return
+	}
+	for i := len(d.lcs) - 1; i >= 0 && i >= len(d.lcs)-64; i-- {
+		if d.lcs[i].ID == m.ID {
+			return
+		}
+	}
+	idx := sort.Search(len(d.lcs), func(i int) bool { return lcLess(&m, &d.lcs[i]) })
+	if idx < len(d.lcs) {
+		// check duplicates anywhere (rare path)
+		for i := range d.lcs {
+			if d.lcs[i].ID == m.ID {
+				return
+			}
+		}
+	}
+	d.lcs = append(d.lcs, LivecommentModel{})
+	copy(d.lcs[idx+1:], d.lcs[idx:])
+	d.lcs[idx] = m
+}
+
+func cacheRemoveLivecomments(livestreamID int64, ids []int64) {
+	if !lsCacheEnabled || len(ids) == 0 {
+		return
+	}
+	del := make(map[int64]struct{}, len(ids))
+	for _, id := range ids {
+		del[id] = struct{}{}
+	}
+	d := getLsData(livestreamID)
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if !d.lcLoaded {
+		return
+	}
+	out := d.lcs[:0]
+	for _, m := range d.lcs {
+		if _, ok := del[m.ID]; !ok {
+			out = append(out, m)
+		}
+	}
+	d.lcs = out
+}
+
+func cachedReactions(ctx context.Context, livestreamID int64, limit int, hasLimit bool) ([]ReactionModel, error) {
+	d := getLsData(livestreamID)
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if !d.rxLoaded {
+		var ms []ReactionModel
+		if err := dbConn.SelectContext(ctx, &ms, "SELECT * FROM reactions WHERE livestream_id = ? ORDER BY created_at, id", livestreamID); err != nil {
+			return nil, err
+		}
+		d.rxs = ms
+		d.rxLoaded = true
+	}
+	n := len(d.rxs)
+	if hasLimit && limit < n {
+		n = limit
+	}
+	if n < 0 {
+		n = 0
+	}
+	out := make([]ReactionModel, n)
+	for i := 0; i < n; i++ {
+		out[i] = d.rxs[len(d.rxs)-1-i]
+	}
+	return out, nil
+}
+
+func cacheAddReaction(m ReactionModel) {
+	if !lsCacheEnabled {
+		return
+	}
+	d := getLsData(m.LivestreamID)
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if !d.rxLoaded {
+		return
+	}
+	for i := len(d.rxs) - 1; i >= 0 && i >= len(d.rxs)-64; i-- {
+		if d.rxs[i].ID == m.ID {
+			return
+		}
+	}
+	idx := sort.Search(len(d.rxs), func(i int) bool { return rxLess(&m, &d.rxs[i]) })
+	if idx < len(d.rxs) {
+		for i := range d.rxs {
+			if d.rxs[i].ID == m.ID {
+				return
+			}
+		}
+	}
+	d.rxs = append(d.rxs, ReactionModel{})
+	copy(d.rxs[idx+1:], d.rxs[idx:])
+	d.rxs[idx] = m
+}
