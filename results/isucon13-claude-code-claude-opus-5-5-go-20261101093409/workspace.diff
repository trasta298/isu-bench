+func livecommentRows(ms []LivecommentModel) []commentLike {
+	out := make([]commentLike, len(ms))
+	for i, m := range ms {
+		out[i] = commentLike{ID: m.ID, UserID: m.UserID, LivestreamID: m.LivestreamID, CreatedAt: m.CreatedAt, Comment: m.Comment, Tip: m.Tip}
+	}
+	return out
+}
