+TRUNCATE TABLE livestream_stats;
+INSERT INTO livestream_stats (livestream_id, user_id, reactions, tips)
+SELECT l.id, l.user_id, IFNULL(r.cnt, 0), IFNULL(c.tips, 0) FROM livestreams l
