diff --git a/deploy/alp.py b/deploy/alp.py
new file mode 100644
index 0000000..898f4eb
--- /dev/null
+++ b/deploy/alp.py
@@ -0,0 +1,12 @@
+import sys,re,collections
+st=collections.defaultdict(lambda:[0,0.0,0.0,0])
+for line in sys.stdin:
+    d=dict(kv.split(':',1) for kv in line.rstrip('\n').split('\t') if ':' in kv)
+    uri=d.get('uri','').split('?')[0]
+    uri=re.sub(r'/\d+','/:id',uri)
+    uri=re.sub(r'^/api/user/[^/]+','/api/user/:name',uri) if not uri.startswith('/api/user/me') else uri
+    k=d.get('method','')+' '+uri
+    t=float(d.get('reqtime','0') or 0)
+    s=st[k]; s[0]+=1; s[1]+=t; s[2]=max(s[2],t); s[3]+=int(d.get('size','0') or 0)
+for k,v in sorted(st.items(),key=lambda x:-x[1][1])[:30]:
+    print(f"{v[0]:7d} sum={v[1]:8.1f} avg={v[1]/v[0]*1000:7.1f}ms max={v[2]:.2f} bytes={v[3]//v[0]:7d} {k}")
diff --git a/deploy/deploy.sh b/deploy/deploy.sh
new file mode 100755
index 0000000..74f2e54
--- /dev/null
+++ b/deploy/deploy.sh
@@ -0,0 +1,12 @@
+#!/bin/bash
+# usage: deploy.sh host...
+set -e
+cd /work/webapp/go
+CGO_ENABLED=0 go build -o /tmp/isupipe .
+for h in "$@"; do
+  echo "== $h"
+  scp -q /tmp/isupipe $h:/tmp/isupipe.new
+  scp -q -r /work/webapp/sql/init.sh /work/webapp/sql/init.sql /work/webapp/sql/init_stats.sql /work/webapp/sql/triggers.sql $h:/home/isucon/webapp/sql/
+  scp -q /work/deploy/isupipe-go.service /work/deploy/nginx.conf /work/deploy/isupipe.conf $h:/tmp/
