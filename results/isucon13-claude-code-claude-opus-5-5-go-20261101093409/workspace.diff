+// ---- fast icon request body parsing ----
+
+// parseIconBody extracts and decodes {"image":"<base64>"}; ok=false means use the generic decoder.
+func parseIconBody(body []byte) ([]byte, bool) {
+	key := []byte(`"image"`)
+	i := bytes.Index(body, key)
+	if i < 0 {
+		return nil, false
+	}
+	rest := body[i+len(key):]
+	j := 0
+	for j < len(rest) && (rest[j] == ' ' || rest[j] == '\t' || rest[j] == '\n' || rest[j] == '\r') {
+		j++
+	}
+	if j >= len(rest) || rest[j] != ':' {
+		return nil, false
+	}
+	j++
+	for j < len(rest) && (rest[j] == ' ' || rest[j] == '\t' || rest[j] == '\n' || rest[j] == '\r') {
+		j++
+	}
+	if j >= len(rest) || rest[j] != '"' {
+		return nil, false
+	}
+	j++
+	end := bytes.IndexByte(rest[j:], '"')
+	if end < 0 {
+		return nil, false
+	}
+	s := rest[j : j+end]
+	if bytes.IndexByte(s, '\\') >= 0 {
+		return nil, false
+	}
+	// only one key expected
+	if bytes.Count(body, []byte(`"`)) != 4 {
+		return nil, false
+	}
+	dst := make([]byte, base64.StdEncoding.DecodedLen(len(s)))
+	n, err := base64.StdEncoding.Decode(dst, s)
+	if err != nil {
+		return nil, false
+	}
+	return dst[:n], true
+}
