diff --git a/webapp/sql/triggers.sql b/webapp/sql/triggers.sql
new file mode 100644
index 0000000..3122b6b
--- /dev/null
+++ b/webapp/sql/triggers.sql
@@ -0,0 +1,21 @@
+DROP TRIGGER IF EXISTS trg_reactions_ai;
+DROP TRIGGER IF EXISTS trg_livecomments_ai;
+DROP TRIGGER IF EXISTS trg_livecomments_ad;
+DELIMITER //
+CREATE TRIGGER trg_reactions_ai AFTER INSERT ON reactions FOR EACH ROW
+BEGIN
+  UPDATE livestream_stats SET reactions = reactions + 1 WHERE livestream_id = NEW.livestream_id;
+END//
+CREATE TRIGGER trg_livecomments_ai AFTER INSERT ON livecomments FOR EACH ROW
+BEGIN
+  IF NEW.tip <> 0 THEN
+    UPDATE livestream_stats SET tips = tips + NEW.tip WHERE livestream_id = NEW.livestream_id;
+  END IF;
+END//
+CREATE TRIGGER trg_livecomments_ad AFTER DELETE ON livecomments FOR EACH ROW
+BEGIN
+  IF OLD.tip <> 0 THEN
+    UPDATE livestream_stats SET tips = tips - OLD.tip WHERE livestream_id = OLD.livestream_id;
+  END IF;
+END//
+DELIMITER ;
