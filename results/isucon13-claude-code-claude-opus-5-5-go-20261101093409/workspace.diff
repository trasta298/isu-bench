diff --git a/webapp/go/session.go b/webapp/go/session.go
new file mode 100644
index 0000000..c89dc3c
--- /dev/null
+++ b/webapp/go/session.go
@@ -0,0 +1,71 @@
+package main
+
+import (
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/labstack/echo-contrib/session"
+	"github.com/labstack/echo/v4"
+)
+
+type sessInfo struct {
+	userID  int64
+	expires int64
+}
+
+var sessCache sync.Map // cookie value -> *sessInfo
+
+func loadSession(c echo.Context) (*sessInfo, error) {
+	ck, ckErr := c.Cookie(defaultSessionIDKey)
+	if ckErr == nil && ck.Value != "" {
+		if v, ok := sessCache.Load(ck.Value); ok {
+			return v.(*sessInfo), nil
+		}
+	}
+	sess, err := session.Get(defaultSessionIDKey, c)
+	if err != nil {
+		return nil, echo.NewHTTPError(http.StatusUnauthorized, "failed to get session")
+	}
+	sessionExpires, ok := sess.Values[defaultSessionExpiresKey]
+	if !ok {
+		return nil, echo.NewHTTPError(http.StatusForbidden, "failed to get EXPIRES value from session")
+	}
+	userID, ok := sess.Values[defaultUserIDKey].(int64)
+	if !ok {
+		return nil, echo.NewHTTPError(http.StatusUnauthorized, "failed to get USERID value from session")
+	}
+	exp, ok := sessionExpires.(int64)
+	if !ok {
+		return nil, echo.NewHTTPError(http.StatusUnauthorized, "invalid EXPIRES value")
+	}
+	si := &sessInfo{userID: userID, expires: exp}
+	if ckErr == nil && ck.Value != "" {
+		sessCache.Store(ck.Value, si)
+	}
+	return si, nil
+}
+
+func verifyUserSession(c echo.Context) error {
+	si, err := loadSession(c)
+	if err != nil {
+		return err
+	}
+	if time.Now().Unix() > si.expires {
+		return echo.NewHTTPError(http.StatusUnauthorized, "session has expired")
+	}
+	c.Set("uid", si.userID)
+	return nil
+}
+
+// sessionUserID must be called after verifyUserSession succeeded.
+func sessionUserID(c echo.Context) int64 {
+	if v, ok := c.Get("uid").(int64); ok {
+		return v
+	}
+	si, err := loadSession(c)
+	if err != nil {
+		return 0
+	}
+	return si.userID
+}
