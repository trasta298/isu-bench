+// ---- LIKE '%word%' emulation ----
+
+var (
+	likeMu    sync.RWMutex
+	likeCache = map[string]*regexp.Regexp{}
+)
+
+func likeContains(text, word string) bool {
+	if !strings.ContainsAny(word, "%_\\") {
+		return strings.Contains(text, word)
+	}
+	likeMu.RLock()
+	re, ok := likeCache[word]
+	likeMu.RUnlock()
+	if !ok {
+		var b strings.Builder
+		b.WriteString("(?s)")
+		rs := []rune(word)
+		for i := 0; i < len(rs); i++ {
+			r := rs[i]
+			switch r {
+			case '%':
+				b.WriteString(".*")
+			case '_':
+				b.WriteString(".")
+			case '\\':
+				if i+1 < len(rs) {
+					i++
+					b.WriteString(regexp.QuoteMeta(string(rs[i])))
+				} else {
+					b.WriteString(regexp.QuoteMeta("\\"))
+				}
+			default:
+				b.WriteString(regexp.QuoteMeta(string(r)))
+			}
+		}
+		var err error
+		re, err = regexp.Compile(b.String())
+		if err != nil {
+			return strings.Contains(text, word)
+		}
+		likeMu.Lock()
+		likeCache[word] = re
+		likeMu.Unlock()
+	}
+	return re.MatchString(text)
+}
