+"${MYSQL[@]}" < 1-schema.sql
+"${MYSQL[@]}" < 2-master-data.sql
+gzip -dkc 3-initial-data.sql.gz | "${MYSQL[@]}"
+
+# 初期データ投入後に派生カラムを追加する（初期データは列名なしINSERTのため）
+"${MYSQL[@]}" <<'SQL'
+ALTER TABLE chairs
+  ADD COLUMN total_distance            INT          NOT NULL DEFAULT 0 COMMENT '移動距離合計',
+  ADD COLUMN total_distance_updated_at DATETIME(6)  NULL COMMENT '移動距離更新日時',
+  ADD COLUMN total_rides_count         INT          NOT NULL DEFAULT 0 COMMENT '完了ライド数',
+  ADD COLUMN total_evaluation_sum      INT          NOT NULL DEFAULT 0 COMMENT '評価合計',
+  ADD COLUMN current_ride_id           VARCHAR(26)  NULL COMMENT '現在のライドID',
+  ADD COLUMN last_latitude             INT          NULL COMMENT '最終緯度',
+  ADD COLUMN last_longitude            INT          NULL COMMENT '最終経度',
+  ADD COLUMN last_location_at          DATETIME(6)  NULL COMMENT '最終位置更新日時',
+  ADD COLUMN distance_started          TINYINT(1)   NOT NULL DEFAULT 0 COMMENT '距離計測開始済み',
+  ADD KEY idx_chairs_active_current (is_active, current_ride_id);
+
+ALTER TABLE rides
+  ADD COLUMN fare   INTEGER NOT NULL DEFAULT 0 COMMENT '運賃',
+  ADD COLUMN status ENUM ('MATCHING', 'ENROUTE', 'PICKUP', 'CARRYING', 'ARRIVED', 'COMPLETED') NOT NULL DEFAULT 'MATCHING' COMMENT '現在の状態',
+  ADD KEY idx_rides_chair_status_updated (chair_id, status, updated_at);
+SQL
+
+# 初期データから派生カラムを構築する
+"${MYSQL[@]}" <<'SQL'
+SET SESSION group_concat_max_len = 1000000;
+
+UPDATE rides r
+JOIN (
+  SELECT ride_id,
+         SUBSTRING_INDEX(GROUP_CONCAT(status ORDER BY created_at DESC, id DESC), ',', 1) AS latest_status
+  FROM ride_statuses
+  GROUP BY ride_id
+) s ON s.ride_id = r.id
+SET r.status = s.latest_status,
+    r.updated_at = r.updated_at;
+
+UPDATE rides r
+LEFT JOIN (
+  SELECT used_by, MAX(discount) AS discount
+  FROM coupons
+  WHERE used_by IS NOT NULL
+  GROUP BY used_by
+) cp ON cp.used_by = r.id
+SET r.fare = 500 + GREATEST(
+  100 * (ABS(r.pickup_latitude - r.destination_latitude) + ABS(r.pickup_longitude - r.destination_longitude)) - IFNULL(cp.discount, 0),
+  0
+),
+    r.updated_at = r.updated_at;
+
+UPDATE chairs c
+LEFT JOIN (
+  SELECT r.chair_id, COUNT(*) AS cnt, SUM(r.evaluation) AS evalsum
+  FROM rides r
+  WHERE r.status = 'COMPLETED'
+    AND r.evaluation IS NOT NULL
+    AND EXISTS (SELECT 1 FROM ride_statuses s WHERE s.ride_id = r.id AND s.status = 'ARRIVED')
+    AND EXISTS (SELECT 1 FROM ride_statuses s WHERE s.ride_id = r.id AND s.status = 'CARRYING')
+  GROUP BY r.chair_id
+) s ON s.chair_id = c.id
+SET c.total_rides_count = IFNULL(s.cnt, 0),
+    c.total_evaluation_sum = IFNULL(s.evalsum, 0),
+    c.updated_at = c.updated_at;
+
+UPDATE chairs c
+LEFT JOIN (
+  SELECT chair_id, id, status
+  FROM (
+    SELECT chair_id, id, status,
+           ROW_NUMBER() OVER (PARTITION BY chair_id ORDER BY created_at DESC, id DESC) AS rn
+    FROM rides
+    WHERE chair_id IS NOT NULL
+  ) x
+  WHERE x.rn = 1
+) lr ON lr.chair_id = c.id
+SET c.current_ride_id = IF(lr.status IS NULL OR lr.status = 'COMPLETED', NULL, lr.id),
+    c.updated_at = c.updated_at;
+
+UPDATE chairs c
+LEFT JOIN (
+  SELECT chair_id, SUM(distance) AS total_distance, MAX(created_at) AS updated_at
+  FROM (
+    SELECT chair_id, created_at,
+           ABS(latitude - LAG(latitude) OVER (PARTITION BY chair_id ORDER BY created_at, id)) +
+           ABS(longitude - LAG(longitude) OVER (PARTITION BY chair_id ORDER BY created_at, id)) AS distance
+    FROM chair_locations
+  ) t
+  GROUP BY chair_id
+) d ON d.chair_id = c.id
+SET c.total_distance = IFNULL(d.total_distance, 0),
+    c.total_distance_updated_at = d.updated_at,
+    c.updated_at = c.updated_at;
+
+UPDATE chairs c
+LEFT JOIN (
+  SELECT chair_id, latitude, longitude, created_at
+  FROM (
+    SELECT chair_id, latitude, longitude, created_at,
+           ROW_NUMBER() OVER (PARTITION BY chair_id ORDER BY created_at DESC, id DESC) AS rn
+    FROM chair_locations
+  ) x
+  WHERE x.rn = 1
+) l ON l.chair_id = c.id
+SET c.last_latitude = l.latitude,
+    c.last_longitude = l.longitude,
+    c.last_location_at = l.created_at,
+    c.updated_at = c.updated_at;
+
+UPDATE chairs
+SET distance_started = 1,
+    updated_at = updated_at;
+SQL
