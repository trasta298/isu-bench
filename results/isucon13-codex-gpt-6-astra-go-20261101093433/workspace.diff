new file mode 100644
index 0000000..093cc09
--- /dev/null
+++ b/webapp/go/list_cache.go
@@ -0,0 +1,149 @@
+package main
+
+import (
+	"context"
+	"sort"
+	"sync"
+)
+
+var lists = struct {
+	sync.RWMutex
+	all      []int64
+	owned    map[int64][]int64
+	tagged   map[string][]int64
+	words    map[int64][]NGWord
+	reports  map[int64][]LivecommentReportModel
+	comments map[int64]LivecommentModel
+}{}
+
+func descending(ids []int64) { sort.Slice(ids, func(i, j int) bool { return ids[i] > ids[j] }) }
+func insertDescending(ids []int64, id int64) []int64 {
+	i := sort.Search(len(ids), func(i int) bool { return ids[i] < id })
+	ids = append(ids, 0)
+	copy(ids[i+1:], ids[i:])
+	ids[i] = id
+	return ids
+}
+func loadLists(ctx context.Context) error {
+	all := []int64{}
+	owned := make(map[int64][]int64)
+	tagged := make(map[string][]int64)
+	words := make(map[int64][]NGWord)
+	reports := make(map[int64][]LivecommentReportModel)
+	comments := make(map[int64]LivecommentModel)
+	cached.RLock()
+	for id, s := range cached.streams {
+		all = append(all, id)
+		owned[s.UserID] = append(owned[s.UserID], id)
+		for _, t := range cached.tags[id] {
+			tagged[t.Name] = append(tagged[t.Name], id)
+		}
+	}
+	cached.RUnlock()
+	descending(all)
+	for _, ids := range owned {
+		sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+	}
+	for _, ids := range tagged {
+		descending(ids)
+	}
+	var wm []NGWord
+	var rm []LivecommentReportModel
+	var cm []LivecommentModel
+	if err := dbConn.SelectContext(ctx, &wm, "SELECT * FROM ng_words"); err != nil {
+		return err
+	}
+	for _, w := range wm {
+		words[w.LivestreamID] = append(words[w.LivestreamID], w)
+	}
+	if err := dbConn.SelectContext(ctx, &rm, "SELECT * FROM livecomment_reports"); err != nil {
+		return err
+	}
+	for _, r := range rm {
+		reports[r.LivestreamID] = append(reports[r.LivestreamID], r)
+	}
+	if err := dbConn.SelectContext(ctx, &cm, "SELECT * FROM livecomments"); err != nil {
+		return err
+	}
+	for _, c := range cm {
+		comments[c.ID] = c
+	}
+	lists.Lock()
+	lists.all = all
+	lists.owned = owned
+	lists.tagged = tagged
+	lists.words = words
+	lists.reports = reports
+	lists.comments = comments
+	lists.Unlock()
+	return nil
+}
+func addListedStream(s LivestreamModel, tags []Tag) {
+	lists.Lock()
+	lists.all = insertDescending(lists.all, s.ID)
+	lists.owned[s.UserID] = append(lists.owned[s.UserID], s.ID)
+	for _, t := range tags {
+		lists.tagged[t.Name] = insertDescending(lists.tagged[t.Name], s.ID)
+	}
+	lists.Unlock()
+}
+func getListedStreams(tag string, owner int64, limit int) []LivestreamModel {
+	lists.RLock()
+	ids := lists.all
+	if tag != "" {
+		ids = lists.tagged[tag]
+	} else if owner != 0 {
+		ids = lists.owned[owner]
+	}
+	if limit >= 0 && len(ids) > limit {
+		ids = ids[:limit]
+	}
+	copyIDs := append([]int64{}, ids...)
+	lists.RUnlock()
+	if owner != 0 {
+		sort.Slice(copyIDs, func(i, j int) bool { return copyIDs[i] < copyIDs[j] })
+	}
+	out := make([]LivestreamModel, 0, len(copyIDs))
+	cached.RLock()
+	for _, id := range copyIDs {
+		out = append(out, cached.streams[id])
+	}
+	cached.RUnlock()
+	return out
+}
+func getListedWords(id, user int64) []*NGWord {
+	var out []*NGWord
+	lists.RLock()
+	for _, w := range lists.words[id] {
+		if w.UserID == user {
+			v := w
+			out = append(out, &v)
+		}
+	}
+	lists.RUnlock()
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].CreatedAt == out[j].CreatedAt {
+			return out[i].ID > out[j].ID
+		}
+		return out[i].CreatedAt > out[j].CreatedAt
+	})
+	return out
+}
+func getListedReports(id int64) []LivecommentReportModel {
+	lists.RLock()
+	out := append([]LivecommentReportModel{}, lists.reports[id]...)
+	lists.RUnlock()
+	sort.Slice(out, func(i, j int) bool { return out[i].ID < out[j].ID })
+	return out
+}
+func addListedWord(w NGWord) {
+	lists.Lock()
+	lists.words[w.LivestreamID] = append(lists.words[w.LivestreamID], w)
+	lists.Unlock()
+}
+func addListedReport(r LivecommentReportModel) {
+	lists.Lock()
+	lists.reports[r.LivestreamID] = append(lists.reports[r.LivestreamID], r)
+	lists.Unlock()
+}
+func addListedComment(c LivecommentModel) { lists.Lock(); lists.comments[c.ID] = c; lists.Unlock() }
