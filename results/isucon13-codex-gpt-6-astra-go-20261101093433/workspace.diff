--- /dev/null
+++ b/webapp/go/icon_storage.go
@@ -0,0 +1,35 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+)
+
+const iconDirectory = "../icons"
+
+func storeIcon(hash string, image []byte) error {
+	path := filepath.Join(iconDirectory, hash)
+	if _, err := os.Stat(path); err == nil {
+		return nil
+	}
+	f, err := os.CreateTemp(iconDirectory, ".upload-")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if _, err = f.Write(image); err != nil {
+		f.Close()
+		return err
+	}
+	if err = f.Close(); err != nil {
+		return err
+	}
+	return os.Rename(name, path)
+}
+func initializeIconStorage() error {
+	if err := os.RemoveAll(iconDirectory); err != nil {
+		return err
+	}
+	return os.MkdirAll(iconDirectory, 0755)
+}
