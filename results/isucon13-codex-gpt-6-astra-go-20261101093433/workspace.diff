+package main
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+
+	"sync"
+
+	"github.com/jmoiron/sqlx"
+)
+
+type iconData struct {
+	Image []byte
+	Hash  string
+}
+type readCache struct {
+	sync.RWMutex
+	users   map[int64]UserModel
+	names   map[string]int64
+	themes  map[int64]Theme
+	streams map[int64]LivestreamModel
+	tags    map[int64][]Tag
+	allTags []Tag
+	icons   map[int64]iconData
+	images  map[string][]byte
+}
+
+var cached = readCache{}
+var iconLocks [256]sync.Mutex
+
+func loadReadCache(ctx context.Context) error {
+	var users []UserModel
+	var themes []ThemeModel
+	var streams []LivestreamModel
+	var tags []TagModel
+	var joins []LivestreamTagModel
+	var icons []struct {
+		UserID int64 `db:"user_id"`
+		Image  []byte
+		Hash   string
+	}
+	for _, q := range []struct {
+		dst   interface{}
+		query string
+	}{
+		{&users, "SELECT * FROM users"}, {&themes, "SELECT * FROM themes"},
+		{&streams, "SELECT * FROM livestreams"}, {&tags, "SELECT * FROM tags ORDER BY id"},
+		{&joins, "SELECT * FROM livestream_tags ORDER BY id"}, {&icons, "SELECT user_id,image,hash FROM icons"},
+	} {
+		if err := dbConn.SelectContext(ctx, q.dst, q.query); err != nil {
+			return err
+		}
+	}
+	if err := os.MkdirAll(iconDirectory, 0755); err != nil {
+		return err
+	}
+	imageMap := make(map[string][]byte)
+	for n := range icons {
+		if b, ok := imageMap[icons[n].Hash]; ok {
+			icons[n].Image = b
+		} else {
+			if len(icons[n].Image) == 0 && len(icons[n].Hash) == 64 {
+				b, err := os.ReadFile(filepath.Join(iconDirectory, icons[n].Hash))
+				if err != nil {
+					return err
+				}
+				icons[n].Image = b
+			}
+			imageMap[icons[n].Hash] = icons[n].Image
+		}
+	}
+	cached.Lock()
+	defer cached.Unlock()
+	cached.images = imageMap
+	cached.users = make(map[int64]UserModel, len(users))
+	cached.names = make(map[string]int64, len(users))
+	cached.themes = make(map[int64]Theme, len(themes))
+	cached.streams = make(map[int64]LivestreamModel, len(streams))
+	cached.tags = make(map[int64][]Tag, len(streams))
+	cached.icons = make(map[int64]iconData, len(icons))
+	cached.allTags = make([]Tag, 0, len(tags))
+	tagMap := make(map[int64]Tag, len(tags))
+	for _, u := range users {
+		cached.users[u.ID] = u
+		cached.names[u.Name] = u.ID
+	}
+	for _, t := range themes {
+		cached.themes[t.UserID] = Theme{ID: t.ID, DarkMode: t.DarkMode}
+	}
+	for _, s := range streams {
+		cached.streams[s.ID] = s
+		cached.tags[s.ID] = []Tag{}
+	}
+	for _, t := range tags {
+		v := Tag{ID: t.ID, Name: t.Name}
+		cached.allTags = append(cached.allTags, v)
+		tagMap[t.ID] = v
+	}
+	for _, j := range joins {
+		cached.tags[j.LivestreamID] = append(cached.tags[j.LivestreamID], tagMap[j.TagID])
+	}
+	for _, i := range icons {
+		cached.icons[i.UserID] = iconData{Image: i.Image, Hash: i.Hash}
+	}
+	return nil
+}
+func userByID(ctx context.Context, tx *sqlx.Tx, id int64) (UserModel, error) {
+	cached.RLock()
+	u, ok := cached.users[id]
+	cached.RUnlock()
+	if ok {
+		return u, nil
+	}
+	var err error
+	if tx == nil {
+		err = dbConn.GetContext(ctx, &u, "SELECT * FROM users WHERE id=?", id)
+	} else {
+		err = tx.GetContext(ctx, &u, "SELECT * FROM users WHERE id=?", id)
+	}
+	return u, err
+}
+func userByName(ctx context.Context, tx *sqlx.Tx, name string) (UserModel, error) {
+	cached.RLock()
+	id, ok := cached.names[name]
+	u := cached.users[id]
+	cached.RUnlock()
+	if ok {
+		return u, nil
+	}
+	var err error
+	if tx == nil {
+		err = dbConn.GetContext(ctx, &u, "SELECT * FROM users WHERE name=?", name)
+	} else {
+		err = tx.GetContext(ctx, &u, "SELECT * FROM users WHERE name=?", name)
+	}
+	return u, err
+}
+func streamByID(ctx context.Context, tx *sqlx.Tx, id int64) (LivestreamModel, error) {
+	cached.RLock()
+	s, ok := cached.streams[id]
+	cached.RUnlock()
+	if ok {
+		return s, nil
+	}
+	var err error
+	if tx == nil {
+		err = dbConn.GetContext(ctx, &s, "SELECT * FROM livestreams WHERE id=?", id)
+	} else {
+		err = tx.GetContext(ctx, &s, "SELECT * FROM livestreams WHERE id=?", id)
+	}
+	return s, err
+}
+func currentIcon(id int64) iconData {
+	cached.RLock()
+	i, ok := cached.icons[id]
+	cached.RUnlock()
+	if ok {
+		return i
+	}
+	b, h := getFallback()
+	return iconData{Image: b, Hash: h}
+}
+func publishUser(u UserModel, t Theme) {
+	cached.Lock()
+	cached.users[u.ID] = u
+	cached.names[u.Name] = u.ID
+	cached.themes[u.ID] = t
+	cached.Unlock()
+}
+func publishStream(s LivestreamModel, tags []Tag) {
+	cached.Lock()
+	cached.streams[s.ID] = s
+	cached.tags[s.ID] = tags
+	cached.Unlock()
+}
+
+func getRow(ctx context.Context, tx *sqlx.Tx, dest interface{}, query string, args ...interface{}) error {
+	if tx == nil {
+		return dbConn.GetContext(ctx, dest, query, args...)
+	}
+	return tx.GetContext(ctx, dest, query, args...)
+}
+func getRows(ctx context.Context, tx *sqlx.Tx, dest interface{}, query string, args ...interface{}) error {
+	if tx == nil {
+		return dbConn.SelectContext(ctx, dest, query, args...)
+	}
+	return tx.SelectContext(ctx, dest, query, args...)
+}
+
+var commentLocks [1024]sync.RWMutex
