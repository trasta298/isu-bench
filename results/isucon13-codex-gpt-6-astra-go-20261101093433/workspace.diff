+package main
+
+import (
+	json "github.com/goccy/go-json"
+	"github.com/labstack/echo/v4"
+)
+
+type fastJSONSerializer struct{}
+
+func (fastJSONSerializer) Serialize(c echo.Context, v interface{}, indent string) error {
+	e := json.NewEncoder(c.Response())
+	e.SetEscapeHTML(false)
+	if indent != "" {
+		e.SetIndent("", indent)
+	}
+	return e.Encode(v)
+}
+func (fastJSONSerializer) Deserialize(c echo.Context, v interface{}) error {
+	return json.NewDecoder(c.Request().Body).Decode(v)
+}
