@@ -0,0 +1,32 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"time"
+)
+
+var dnsClient = &http.Client{Timeout: 3 * time.Second}
+
+func syncDNS(ctx context.Context, path string, values url.Values) error {
+	base := os.Getenv("ISUCON_DNS_API")
+	if base == "" {
+		return nil
+	}
+	req, err := http.NewRequestWithContext(ctx, "POST", base+path+"?"+values.Encode(), nil)
+	if err != nil {
+		return err
+	}
+	res, err := dnsClient.Do(req)
+	if err != nil {
+		return err
+	}
+	defer res.Body.Close()
+	if res.StatusCode != 204 {
+		return fmt.Errorf("DNS update status %d", res.StatusCode)
+	}
+	return nil
+}
