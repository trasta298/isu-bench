@@ -0,0 +1,36 @@
+package main
+
+import (
+	"bytes"
+	stdjson "encoding/json"
+	json "github.com/goccy/go-json"
+	"reflect"
+	"testing"
+)
+
+func TestFastJSONCompatibility(t *testing.T) {
+	user := User{ID: 123, Name: "tester", DisplayName: "<猫>&emoji😀", Description: "test\n\"quote\"\u2028", Theme: Theme{ID: 1, DarkMode: true}, IconHash: "aabb"}
+	stream := Livestream{ID: 456, Owner: user, Tags: []Tag{{ID: 1, Name: "日本語"}}, Title: "title", StartAt: 1234567890, EndAt: 1234569999}
+	for _, v := range []interface{}{user, stream, Livecomment{ID: 2, User: user, Livestream: stream, Comment: "a%b_\\foo", Tip: 10000}, Reaction{User: user, Livestream: stream, EmojiName: "innocent"}, UserStatistics{Rank: 123}, PostIconRequest{Image: []byte{0, 1, 2, 128, 255}}} {
+		expected, err := stdjson.Marshal(v)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var buf bytes.Buffer
+		enc := json.NewEncoder(&buf)
+		enc.SetEscapeHTML(false)
+		if err := enc.Encode(v); err != nil {
+			t.Fatal(err)
+		}
+		var a, b interface{}
+		if err := stdjson.Unmarshal(expected, &a); err != nil {
+			t.Fatal(err)
+		}
+		if err := stdjson.Unmarshal(buf.Bytes(), &b); err != nil {
+			t.Fatal(err)
+		}
+		if !reflect.DeepEqual(a, b) {
+			t.Fatalf("JSON differs: %s %s", expected, buf.Bytes())
+		}
+	}
+}
