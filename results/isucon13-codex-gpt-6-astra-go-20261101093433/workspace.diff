+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	_ "github.com/go-sql-driver/mysql"
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+type zoneData struct {
+	sync.RWMutex
+	records map[string][]dnsmessage.Resource
+}
+
+var zone zoneData
+var db *sql.DB
+var httpAddresses [][4]byte
+var roundRobin atomic.Uint64
+var soa = dnsmessage.SOAResource{NS: mustName("ns1.u.isucon.dev."), MBox: mustName("hostmaster.u.isucon.dev."), Serial: 0, Refresh: 10800, Retry: 3600, Expire: 604800, MinTTL: 1}
+
+func mustName(s string) dnsmessage.Name {
+	n, e := dnsmessage.NewName(s)
+	if e != nil {
+		panic(e)
+	}
+	return n
+}
+func canonical(s string) string { return strings.ToLower(strings.TrimSuffix(s, ".")) + "." }
+func aRecord(name, ip string) (dnsmessage.Resource, error) {
+	parsed := net.ParseIP(ip).To4()
+	if parsed == nil {
+		return dnsmessage.Resource{}, fmt.Errorf("invalid IPv4")
+	}
+	var a [4]byte
+	copy(a[:], parsed)
+	return dnsmessage.Resource{Header: dnsmessage.ResourceHeader{Name: mustName(canonical(name)), Type: dnsmessage.TypeA, Class: dnsmessage.ClassINET, TTL: 60}, Body: &dnsmessage.AResource{A: a}}, nil
+}
+func reload() error {
+	rows, err := db.Query("SELECT name,type,content FROM records WHERE disabled=0")
+	if err != nil {
+		return err
+	}
+	defer rows.Close()
+	records := make(map[string][]dnsmessage.Resource)
+	for rows.Next() {
+		var name, typ, content string
+		if err := rows.Scan(&name, &typ, &content); err != nil {
+			return err
+		}
+		name = canonical(name)
+		hdr := dnsmessage.ResourceHeader{Name: mustName(name), Class: dnsmessage.ClassINET, TTL: 60}
+		var r dnsmessage.Resource
+		switch typ {
+		case "A":
+			r, err = aRecord(name, content)
+			if err != nil {
+				return err
+			}
+		case "NS":
+			hdr.Type = dnsmessage.TypeNS
+			r = dnsmessage.Resource{Header: hdr, Body: &dnsmessage.NSResource{NS: mustName(canonical(content))}}
+		case "SOA":
+			f := strings.Fields(content)
+			v := soa
+			if len(f) >= 7 {
+				v.NS = mustName(canonical(f[0]))
+				v.MBox = mustName(canonical(f[1]))
+				nums := []*uint32{&v.Serial, &v.Refresh, &v.Retry, &v.Expire, &v.MinTTL}
+				for i, p := range nums {
+					n, _ := strconv.ParseUint(f[i+2], 10, 32)
+					*p = uint32(n)
+				}
+			}
+			hdr.Type = dnsmessage.TypeSOA
+			r = dnsmessage.Resource{Header: hdr, Body: &v}
+		default:
+			return fmt.Errorf("unsupported record type %s", typ)
+		}
+		records[name] = append(records[name], r)
+	}
+	if err := rows.Err(); err != nil {
+		return err
+	}
+	zone.Lock()
+	zone.records = records
+	zone.Unlock()
+	return nil
+}
+func answer(packet []byte) ([]byte, error) {
+	var req dnsmessage.Message
+	if err := req.Unpack(packet); err != nil {
+		return nil, err
+	}
+	if len(req.Questions) != 1 || req.Header.Response {
+		return nil, fmt.Errorf("invalid query")
+	}
+	q := req.Questions[0]
+	res := dnsmessage.Message{Header: dnsmessage.Header{ID: req.Header.ID, Response: true, Authoritative: true, RecursionDesired: req.Header.RecursionDesired}, Questions: req.Questions}
+	zone.RLock()
+	rr, exists := zone.records[canonical(q.Name.String())]
+	zone.RUnlock()
+	if !exists {
+		res.Header.RCode = dnsmessage.RCodeNameError
+		res.Authorities = []dnsmessage.Resource{{Header: dnsmessage.ResourceHeader{Name: mustName("u.isucon.dev."), Type: dnsmessage.TypeSOA, Class: dnsmessage.ClassINET, TTL: 1}, Body: &soa}}
+	} else {
+		for _, r := range rr {
+			if r.Header.Type == q.Type || q.Type == dnsmessage.TypeALL {
+				if r.Header.Type == dnsmessage.TypeA && len(httpAddresses) > 0 && canonical(q.Name.String()) != "ns1.u.isucon.dev." {
+					a := httpAddresses[(roundRobin.Add(1)-1)%uint64(len(httpAddresses))]
+					r.Body = &dnsmessage.AResource{A: a}
+					if canonical(q.Name.String()) == "pipe.u.isucon.dev." {
+						r.Header.TTL = 0
+					}
+				}
+				res.Answers = append(res.Answers, r)
+			}
+		}
+	}
+	return res.Pack()
+}
+func main() {
+	if pool := os.Getenv("ISUDNS_HTTP_BACKENDS"); pool != "" {
+		for _, host := range strings.Split(pool, ",") {
+			ip := net.ParseIP(host).To4()
+			if ip == nil {
+				log.Fatal("invalid HTTP backend")
+			}
+			var a [4]byte
+			copy(a[:], ip)
+			httpAddresses = append(httpAddresses, a)
+		}
+	}
+	var err error
+	db, err = sql.Open("mysql", "isudns:isudns@tcp(127.0.0.1:3306)/isudns")
+	if err != nil {
+		log.Fatal(err)
+	}
+	db.SetMaxOpenConns(2)
+	if err := reload(); err != nil {
+		log.Fatal(err)
+	}
+	http.HandleFunc("/reload", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != "POST" {
+			http.Error(w, "method", 405)
+			return
+		}
+		if err := reload(); err != nil {
+			http.Error(w, err.Error(), 500)
+			return
+		}
+		w.WriteHeader(204)
+	})
+	http.HandleFunc("/add", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != "POST" {
+			http.Error(w, "method", 405)
+			return
+		}
+		name := canonical(r.URL.Query().Get("name"))
+		rec, err := aRecord(name, r.URL.Query().Get("ip"))
+		if err != nil {
+			http.Error(w, err.Error(), 400)
+			return
+		}
+		zone.Lock()
+		zone.records[name] = []dnsmessage.Resource{rec}
+		zone.Unlock()
+		w.WriteHeader(204)
+	})
+	go func() { log.Fatal(http.ListenAndServe(":8053", nil)) }()
+	conn, err := net.ListenUDP("udp", &net.UDPAddr{Port: 53})
+	if err != nil {
+		log.Fatal(err)
+	}
+	conn.SetReadBuffer(4 << 20)
+	conn.SetWriteBuffer(4 << 20)
+	for i := 0; i < 2; i++ {
+		go func() {
+			buf := make([]byte, 4096)
+			for {
+				n, addr, err := conn.ReadFromUDP(buf)
+				if err != nil {
+					log.Print(err)
+					continue
+				}
+				out, err := answer(buf[:n])
+				if err == nil {
+					conn.WriteToUDP(out, addr)
+				}
+			}
+		}()
+	}
+	for {
+		time.Sleep(time.Hour)
+	}
+}
