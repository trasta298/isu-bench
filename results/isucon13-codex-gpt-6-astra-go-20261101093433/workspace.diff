+package main
+
+import (
+	"database/sql"
+	"os"
+	"testing"
+)
+
+func TestMatcherAgainstMySQL(t *testing.T) {
+	dsn := os.Getenv("MYSQL_TEST_DSN")
+	if dsn == "" {
+		t.Skip("set MYSQL_TEST_DSN for differential matcher test")
+	}
+	db, err := sql.Open("mysql", dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	words := []string{"foo", "FOO", "", "_", "%", "a_b", "a%b", "a\\_b", "a\\%b", "foo\\", "\\", "\\\\", "日本", "é", "e", "a\nb"}
+	comments := []string{"", "a", "foo", "FOO", "abcfooXYZ", "a_b", "axb", "a日本b", "a\nb", "foo%", "foo%tail", "abc\\def", "a%b", "日本語", "é", "é", "É"}
+	for _, w := range words {
+		for _, c := range comments {
+			var want bool
+			if err := db.QueryRow("SELECT CONVERT(? USING utf8mb4) COLLATE utf8mb4_bin LIKE CONCAT('%',?,'%')", c, w).Scan(&want); err != nil {
+				t.Fatal(err)
+			}
+			got := compileWord(1, w).matches(c)
+			if got != want {
+				t.Errorf("comment=%q word=%q got=%v SQL=%v", c, w, got, want)
+			}
+		}
+	}
+}
