@@ -0,0 +1,40 @@
+import http.client,json,time,base64,hashlib,sys,urllib.parse
+conn=http.client.HTTPConnection('127.0.0.1',8080,timeout=20)
+cookie=''
+def call(method,path,data=None,expect=200,extra=None):
+ global cookie
+ headers={'Host':'pipe.u.isucon.dev','Content-Type':'application/json'}
+ if cookie:headers['Cookie']=cookie
+ if extra:headers.update(extra)
+ conn.request(method,path,json.dumps(data) if data is not None else None,headers)
+ r=conn.getresponse();body=r.read()
+ if r.getheader('Set-Cookie'):cookie=r.getheader('Set-Cookie').split(';',1)[0]
+ assert r.status==expect,(method,path,r.status,body[:200])
+ if r.getheader('Content-Type','').startswith('application/json') and body:return json.loads(body)
+ return body
+name='tuning-smoke-'+str(int(time.time()))
+u=call('POST','/api/register',dict(name=name,display_name='Cache smoke',description='verification',password='test',theme={'dark_mode':True}),201)
+call('POST','/api/login',dict(username=name,password='test'))
+start=int(sys.argv[1]);s=call('POST','/api/livestream/reservation',dict(tags=[1],title='smoke',description='test',playlist_url='https://example.invalid/live.m3u8',thumbnail_url='https://example.invalid/thumb.jpg',start_at=start,end_at=start+3600),201);sid=s['id'];p=f'/api/livestream/{sid}'
+assert call('GET','/api/livestream')[0]['id']==sid
+assert call('GET',f'/api/user/{name}/livestream')[0]['id']==sid
+assert call('GET','/api/livestream/search?limit=1')[0]['id']==sid
+assert call('GET','/api/livestream/search?tag='+urllib.parse.quote(s['tags'][0]['name']))[0]['id']==sid
+call('POST',p+'/enter')
+c=call('POST',p+'/livecomment',dict(comment='cache-smoke-word',tip=123),201)
+call('POST',p+'/reaction',dict(emoji_name='smile'),201)
+assert call('GET',p+'/livecomment?limit=1')[0]['id']==c['id']
+call('POST',p+f'/livecomment/{c["id"]}/report',expect=201)
+n=call('POST',p+'/moderate',dict(ng_word='cache-smoke-word'),201)
+assert call('GET',p+'/ngwords')[0]['id']==n['word_id']
+assert call('GET',p+'/livecomment')==[]
+assert call('GET',p+'/report')[0]['livecomment']['id']==c['id']
+call('POST',p+'/livecomment',dict(comment='again cache-smoke-word',tip=0),400)
+st=call('GET',p+'/statistics');assert st['max_tip']==0 and st['total_reports']==1 and st['total_reactions']==1 and st['viewers_count']==1,st
+st=call('GET',f'/api/user/{name}/statistics');assert st['total_tip']==0 and st['total_livecomments']==0 and st['favorite_emoji']=='smile',st
+call('DELETE',p+'/exit');assert call('GET',p+'/statistics')['viewers_count']==0
+image=open('/home/isucon/webapp/img/NoImage.jpg','rb').read();digest=hashlib.sha256(image).hexdigest()
+call('POST','/api/icon',dict(image=base64.b64encode(image).decode()),201)
+assert call('GET',f'/api/user/{name}/icon')==image
+call('GET',f'/api/user/{name}/icon',expect=304,extra={'If-None-Match':'"'+digest+'"'})
+print('PASS: register/login, list/search, comments/reactions, reports/moderation, statistics, viewers, icons; user='+name)
