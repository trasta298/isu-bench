diff --git a/webapp/go/timeline_cache.go b/webapp/go/timeline_cache.go
new file mode 100644
index 0000000..4295d3c
--- /dev/null
+++ b/webapp/go/timeline_cache.go
@@ -0,0 +1,157 @@
+package main
+
+import (
+	"context"
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+)
+
+type wordMatcher struct {
+	userID int64
+	word   string
+	re     *regexp.Regexp
+}
+
+func compileWord(user int64, word string) wordMatcher {
+	m := wordMatcher{userID: user, word: word}
+	if !strings.ContainsAny(word, "%_\\") {
+		return m
+	}
+	var b strings.Builder
+	b.WriteString("(?s)^")
+	r := []rune("%" + word + "%")
+	for i := 0; i < len(r); i++ {
+		switch r[i] {
+		case '%':
+			b.WriteString(".*")
+		case '_':
+			b.WriteString(".")
+		case '\\':
+			if i+1 < len(r) {
+				i++
+				b.WriteString(regexp.QuoteMeta(string(r[i])))
+			} else {
+				b.WriteString(`\\`)
+			}
+		default:
+			b.WriteString(regexp.QuoteMeta(string(r[i])))
+		}
+	}
+	b.WriteString("$")
+	m.re = regexp.MustCompile(b.String())
+	return m
+}
+func (m wordMatcher) matches(comment string) bool {
+	if m.re != nil {
+		return m.re.MatchString(comment)
+	}
+	return strings.Contains(comment, m.word)
+}
+
+var timeline = struct {
+	sync.RWMutex
+	comments  map[int64][]LivecommentModel
+	reactions map[int64][]ReactionModel
+	words     map[int64][]wordMatcher
+}{}
+
+func loadTimelines(ctx context.Context) error {
+	var comments []LivecommentModel
+	var reactions []ReactionModel
+	var words []NGWord
+	if err := dbConn.SelectContext(ctx, &comments, "SELECT * FROM livecomments WHERE deleted=0"); err != nil {
+		return err
+	}
+	if err := dbConn.SelectContext(ctx, &reactions, "SELECT * FROM reactions"); err != nil {
+		return err
+	}
+	if err := dbConn.SelectContext(ctx, &words, "SELECT * FROM ng_words"); err != nil {
+		return err
+	}
+	cm := make(map[int64][]LivecommentModel)
+	rm := make(map[int64][]ReactionModel)
+	wm := make(map[int64][]wordMatcher)
+	for _, c := range comments {
+		cm[c.LivestreamID] = append(cm[c.LivestreamID], c)
+	}
+	for _, r := range reactions {
+		rm[r.LivestreamID] = append(rm[r.LivestreamID], r)
+	}
+	for _, w := range words {
+		wm[w.LivestreamID] = append(wm[w.LivestreamID], compileWord(w.UserID, w.Word))
+	}
+	timeline.Lock()
+	timeline.comments = cm
+	timeline.reactions = rm
+	timeline.words = wm
+	timeline.Unlock()
+	return nil
+}
+func getComments(id int64, limit int) []LivecommentModel {
+	timeline.RLock()
+	rows := append([]LivecommentModel{}, timeline.comments[id]...)
+	timeline.RUnlock()
+	sort.Slice(rows, func(i, j int) bool {
+		if rows[i].CreatedAt == rows[j].CreatedAt {
+			return rows[i].ID > rows[j].ID
+		}
+		return rows[i].CreatedAt > rows[j].CreatedAt
+	})
+	if limit >= 0 && len(rows) > limit {
+		rows = rows[:limit]
+	}
+	return rows
+}
+func getReactionModels(id int64, limit int) []ReactionModel {
+	timeline.RLock()
+	rows := append([]ReactionModel{}, timeline.reactions[id]...)
+	timeline.RUnlock()
+	sort.Slice(rows, func(i, j int) bool {
+		if rows[i].CreatedAt == rows[j].CreatedAt {
+			return rows[i].ID > rows[j].ID
+		}
+		return rows[i].CreatedAt > rows[j].CreatedAt
+	})
+	if limit >= 0 && len(rows) > limit {
+		rows = rows[:limit]
+	}
+	return rows
+}
+func isSpam(id, user int64, comment string) bool {
+	timeline.RLock()
+	words := timeline.words[id]
+	timeline.RUnlock()
+	for _, w := range words {
+		if w.userID == user && w.matches(comment) {
+			return true
+		}
+	}
+	return false
+}
+func appendComment(m LivecommentModel) {
+	timeline.Lock()
+	timeline.comments[m.LivestreamID] = append(timeline.comments[m.LivestreamID], m)
+	timeline.Unlock()
+}
+func appendReaction(m ReactionModel) {
+	timeline.Lock()
+	timeline.reactions[m.LivestreamID] = append(timeline.reactions[m.LivestreamID], m)
+	timeline.Unlock()
+}
+func moderateTimeline(id, user int64, word string, comments []LivecommentModel) {
+	matcher := compileWord(user, word)
+	timeline.Lock()
+	timeline.comments[id] = comments
+	timeline.words[id] = append(timeline.words[id], matcher)
+	timeline.Unlock()
+	var tips, max int64
+	for i, c := range comments {
+		tips += c.Tip
+		if i == 0 || c.Tip > max {
+			max = c.Tip
+		}
+	}
+	setCommentStats(id, int64(len(comments)), tips, max)
+}
