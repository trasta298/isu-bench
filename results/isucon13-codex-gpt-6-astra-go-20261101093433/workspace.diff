@@ -0,0 +1,59 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"golang.org/x/crypto/bcrypt"
+	"io"
+	"net/http"
+	"os"
+	"time"
+)
+
+var hashClient = &http.Client{Timeout: 2 * time.Second, Transport: &http.Transport{MaxIdleConns: 128, MaxIdleConnsPerHost: 128, IdleConnTimeout: 90 * time.Second}}
+
+func remoteHash(ctx context.Context, path string, password, hash []byte) (int, []byte, error) {
+	body, _ := json.Marshal(struct {
+		Password []byte `json:"password"`
+		Hash     []byte `json:"hash"`
+	}{password, hash})
+	req, err := http.NewRequestWithContext(ctx, "POST", os.Getenv("ISUCON_HASH_API")+path, bytes.NewReader(body))
+	if err != nil {
+		return 0, nil, err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	res, err := hashClient.Do(req)
+	if err != nil {
+		return 0, nil, err
+	}
+	defer res.Body.Close()
+	data, err := io.ReadAll(res.Body)
+	return res.StatusCode, data, err
+}
+func generatePasswordHash(ctx context.Context, password []byte) ([]byte, error) {
+	if os.Getenv("ISUCON_HASH_API") != "" {
+		status, hash, err := remoteHash(ctx, "/hash", password, nil)
+		if err == nil && status == 200 {
+			cost, e := bcrypt.Cost(hash)
+			if e == nil && cost == bcryptDefaultCost {
+				return hash, nil
+			}
+		}
+	}
+	return bcrypt.GenerateFromPassword(password, bcryptDefaultCost)
+}
+func comparePasswordHash(ctx context.Context, hash, password []byte) error {
+	if os.Getenv("ISUCON_HASH_API") != "" {
+		status, _, err := remoteHash(ctx, "/verify", password, hash)
+		if err == nil {
+			if status == 204 {
+				return nil
+			}
+			if status == 401 {
+				return bcrypt.ErrMismatchedHashAndPassword
+			}
+		}
+	}
+	return bcrypt.CompareHashAndPassword(hash, password)
+}
