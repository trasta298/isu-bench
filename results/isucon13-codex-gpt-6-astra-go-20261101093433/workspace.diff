@@ -0,0 +1,9 @@
+#!/bin/bash
+set -euo pipefail
+cd /work
+n=${1:?run number required}
+last=$(cat results/count)
+if [ "$n" -ne "$((last+1))" ] || [ "$n" -gt 15 ]; then echo "Invalid run number"; exit 1; fi
+printf '%s\n' "$n" > results/count
+bench > "results/run$(printf '%02d' "$n").log" 2>&1
+cat "results/run$(printf '%02d' "$n").log"
