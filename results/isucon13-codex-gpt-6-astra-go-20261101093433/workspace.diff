+	if err := tx.SelectContext(ctx, &ranking, `SELECT u.name AS username, COALESCE(r.cnt,0)+COALESCE(c.tip,0) AS score FROM users u
+	LEFT JOIN (SELECT l.user_id, COUNT(*) cnt FROM reactions r JOIN livestreams l ON l.id=r.livestream_id GROUP BY l.user_id) r ON r.user_id=u.id
+	LEFT JOIN (SELECT l.user_id, SUM(c.tip) tip FROM livecomments c JOIN livestreams l ON l.id=c.livestream_id GROUP BY l.user_id) c ON c.user_id=u.id`); err != nil { return err }
