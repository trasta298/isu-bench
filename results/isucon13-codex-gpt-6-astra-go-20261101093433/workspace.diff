diff --git a/webapp/go/session_cache.go b/webapp/go/session_cache.go
new file mode 100644
index 0000000..0bd2708
--- /dev/null
+++ b/webapp/go/session_cache.go
@@ -0,0 +1,47 @@
+package main
+
+import (
+	"github.com/gorilla/sessions"
+	"github.com/labstack/echo-contrib/session"
+	"github.com/labstack/echo/v4"
+	"sync"
+	"time"
+)
+
+var sessionCache = struct {
+	sync.RWMutex
+	entries map[string]*sessions.Session
+}{entries: make(map[string]*sessions.Session)}
+
+// Cached sessions are immutable; login always uses a fresh request-local session.
+func getSessionCached(c echo.Context) (*sessions.Session, error) {
+	if v := c.Get("verified-session"); v != nil {
+		return v.(*sessions.Session), nil
+	}
+	cookie, e := c.Request().Cookie(defaultSessionIDKey)
+	if e == nil {
+		sessionCache.RLock()
+		s := sessionCache.entries[cookie.Value]
+		sessionCache.RUnlock()
+		if s != nil {
+			c.Set("verified-session", s)
+			return s, nil
+		}
+	}
+	s, err := session.Get(defaultSessionIDKey, c)
+	if err != nil {
+		return s, err
+	}
+	if e == nil {
+		if expiry, ok := s.Values[defaultSessionExpiresKey].(int64); ok && expiry > time.Now().Unix() {
+			sessionCache.Lock()
+			if len(sessionCache.entries) > 100000 {
+				sessionCache.entries = make(map[string]*sessions.Session)
+			}
+			sessionCache.entries[cookie.Value] = s
+			sessionCache.Unlock()
+		}
+	}
+	c.Set("verified-session", s)
+	return s, nil
