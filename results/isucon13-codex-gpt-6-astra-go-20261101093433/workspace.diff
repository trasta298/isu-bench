@@ -0,0 +1,160 @@
+package main
+
+import (
+	"context"
+	"sync"
+)
+
+type streamCounters struct {
+	OwnerID   int64
+	Reactions int64
+	Comments  int64
+	Tips      int64
+	MaxTip    int64
+	Viewers   int64
+	Reports   int64
+}
+
+var statistics = struct {
+	sync.RWMutex
+	streams map[int64]streamCounters
+	emojis  map[int64]map[string]int64
+}{}
+var viewerLocks [1024]sync.Mutex
+
+func loadState(ctx context.Context) error {
+	if err := loadReadCache(ctx); err != nil {
+		return err
+	}
+	if err := loadStatistics(ctx); err != nil {
+		return err
+	}
+	if err := loadTimelines(ctx); err != nil {
+		return err
+	}
+	return loadLists(ctx)
+}
+func loadStatistics(ctx context.Context) error {
+	streams := make(map[int64]streamCounters)
+	emojis := make(map[int64]map[string]int64)
+	var owners []struct {
+		ID     int64
+		UserID int64 `db:"user_id"`
+	}
+	if err := dbConn.SelectContext(ctx, &owners, "SELECT id,user_id FROM livestreams"); err != nil {
+		return err
+	}
+	for _, r := range owners {
+		streams[r.ID] = streamCounters{OwnerID: r.UserID}
+	}
+	var rows []struct {
+		ID    int64
+		Count int64
+		Tips  int64
+		Max   int64
+	}
+	for _, t := range []struct {
+		query string
+		kind  int
+	}{
+		{"SELECT livestream_id id, COUNT(*) count, SUM(tip) tips, MAX(tip) max FROM livecomments WHERE deleted=0 GROUP BY livestream_id", 0},
+		{"SELECT livestream_id id, COUNT(*) count FROM reactions GROUP BY livestream_id", 1},
+		{"SELECT livestream_id id, COUNT(*) count FROM livestream_viewers_history GROUP BY livestream_id", 2},
+		{"SELECT livestream_id id, COUNT(*) count FROM livecomment_reports GROUP BY livestream_id", 3},
+	} {
+		rows = nil
+		if err := dbConn.SelectContext(ctx, &rows, t.query); err != nil {
+			return err
+		}
+		for _, r := range rows {
+			s, ok := streams[r.ID]
+			if !ok {
+				continue
+			}
+			switch t.kind {
+			case 0:
+				s.Comments = r.Count
+				s.Tips = r.Tips
+				s.MaxTip = r.Max
+			case 1:
+				s.Reactions = r.Count
+			case 2:
+				s.Viewers = r.Count
+			case 3:
+				s.Reports = r.Count
+			}
+			streams[r.ID] = s
+		}
+	}
+	var erows []struct {
+		UserID int64 `db:"user_id"`
+		Emoji  string
+		Count  int64
+	}
+	if err := dbConn.SelectContext(ctx, &erows, "SELECT l.user_id,r.emoji_name emoji,COUNT(*) count FROM reactions r JOIN livestreams l ON l.id=r.livestream_id GROUP BY l.user_id,r.emoji_name"); err != nil {
+		return err
+	}
+	for _, r := range erows {
+		if emojis[r.UserID] == nil {
+			emojis[r.UserID] = make(map[string]int64)
+		}
+		emojis[r.UserID][r.Emoji] = r.Count
+	}
+	statistics.Lock()
+	statistics.streams = streams
+	statistics.emojis = emojis
+	statistics.Unlock()
+	return nil
+}
+func newStreamStats(m LivestreamModel) {
+	statistics.Lock()
+	statistics.streams[m.ID] = streamCounters{OwnerID: m.UserID}
+	statistics.Unlock()
+}
+func addCommentStats(id, tip int64) {
+	statistics.Lock()
+	s := statistics.streams[id]
+	s.Comments++
+	s.Tips += tip
+	if s.Comments == 1 || tip > s.MaxTip {
+		s.MaxTip = tip
+	}
+	statistics.streams[id] = s
+	statistics.Unlock()
+}
+func setCommentStats(id, count, tips, max int64) {
+	statistics.Lock()
+	s := statistics.streams[id]
+	s.Comments = count
+	s.Tips = tips
+	s.MaxTip = max
+	statistics.streams[id] = s
+	statistics.Unlock()
+}
+func addReactionStats(id int64, emoji string) {
+	statistics.Lock()
+	s := statistics.streams[id]
+	s.Reactions++
+	statistics.streams[id] = s
+	if statistics.emojis[s.OwnerID] == nil {
+		statistics.emojis[s.OwnerID] = make(map[string]int64)
+	}
+	statistics.emojis[s.OwnerID][emoji]++
+	statistics.Unlock()
+}
+func addViewerStats(id, n int64) {
+	statistics.Lock()
+	s, ok := statistics.streams[id]
+	if ok {
+		s.Viewers += n
+		statistics.streams[id] = s
+	}
+	statistics.Unlock()
+}
+func addReportStats(id int64) {
+	statistics.Lock()
+	s := statistics.streams[id]
+	s.Reports++
+	statistics.streams[id] = s
+	statistics.Unlock()
+}
