+        ).fetchone()
+
+        if row is None:
+            raise HTTPException(
+                status_code=HTTPStatus.UNAUTHORIZED, detail="invalid access token"
+            )
+
+        return Owner.model_validate(row)
+
+
+def chair_auth_middleware(
