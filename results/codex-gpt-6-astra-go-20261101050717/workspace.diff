--- /dev/null
+++ b/checkpoint-run13/go/coordinate_batch.go
@@ -0,0 +1,59 @@
+package main
+
+import (
+	"context"
+	"sort"
+	"strings"
+	"time"
+)
+
+type locationWrite struct {
+	id   string
+	p    Coordinate
+	at   time.Time
+	done chan error
+}
+
+var locationWrites = make(chan *locationWrite, 8192)
+
+func persistLocation(ctx context.Context, id string, p Coordinate, at time.Time) error {
+	w := &locationWrite{id: id, p: p, at: at, done: make(chan error, 1)}
+	select {
+	case locationWrites <- w:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	return <-w.done
+}
+func locationWriter() {
+	for first := range locationWrites {
+		batch := []*locationWrite{first}
+		timer := time.NewTimer(500 * time.Microsecond)
+	collect:
+		for len(batch) < 256 {
+			select {
+			case w := <-locationWrites:
+				batch = append(batch, w)
+			case <-timer.C:
+				break collect
+			}
+		}
+		timer.Stop()
+		sort.Slice(batch, func(i, j int) bool { return batch[i].id < batch[j].id })
+		var query strings.Builder
+		query.WriteString("INSERT INTO chair_state (chair_id,latitude,longitude,updated_at) VALUES ")
+		args := make([]interface{}, 0, len(batch)*4)
+		for i, w := range batch {
+			if i > 0 {
+				query.WriteByte(',')
+			}
+			query.WriteString("(?,?,?,?)")
+			args = append(args, w.id, w.p.Latitude, w.p.Longitude, w.at)
+		}
+		query.WriteString(" ON DUPLICATE KEY UPDATE total_distance=total_distance+ABS(latitude-VALUES(latitude))+ABS(longitude-VALUES(longitude)),latitude=VALUES(latitude),longitude=VALUES(longitude),updated_at=VALUES(updated_at)")
+		_, err := locationDB.Exec(query.String(), args...)
+		for _, w := range batch {
+			w.done <- err
+		}
+	}
+}
