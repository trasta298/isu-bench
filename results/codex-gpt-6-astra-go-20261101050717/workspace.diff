+
+    my $chair = $c->mysql->db->select_row(
+        'SELECT * FROM chairs WHERE access_token = ?',
+        $access_token
+    );
+
+    unless ($chair) {
+        return $c->halt_json(HTTP_UNAUTHORIZED, 'invalid access_token');
+    }
+
+    $c->stash(chair => $chair);
+}
