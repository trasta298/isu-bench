+        )
+
+        ride_count = conn.execute(
+            text("SELECT COUNT(*) FROM rides WHERE user_id = :user_id"),
+            {"user_id": user.id},
+        ).scalar()
+
+        if ride_count == 1:
+            # 初回利用で、初回利用クーポンがあれば必ず使う
+            coupon = conn.execute(
+                text(
+                    "SELECT * FROM coupons WHERE user_id = :user_id AND code = 'CP_NEW2024' AND used_by IS NULL FOR UPDATE"
+                ),
