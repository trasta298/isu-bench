+
+#  IsurideのKossyによる実装
+#  Kossy::Isuride名前空間のpackageを利用する
+#
+#  Mojolicious::Liteによる実装はapp.plを起動すること
+#
+
+use Plack::Builder;
+use Kossy::Isuride::Web;
+use File::Basename;
+
+my $root_dir = File::Basename::dirname(__FILE__);
+
+my $app = Kossy::Isuride::Web->psgi($root_dir);
+
+builder {
+    enable 'ReverseProxy';
+    $app;
+};
diff --git a/checkpoint-run11/perl/cpanfile b/checkpoint-run11/perl/cpanfile
new file mode 100644
index 0000000..499bb35
--- /dev/null
+++ b/checkpoint-run11/perl/cpanfile
@@ -0,0 +1,23 @@
+requires 'perl', '5.040';
+
+requires 'Kossy', '0.63';
+requires 'Starlet', '0.31';
+requires 'HTTP::Status', '7.00';
+requires 'Type::Tiny', '2.006000';
+requires 'Cpanel::JSON::XS', '4.38';
+requires 'Crypt::URandom','0.40';
+requires 'Time::Moment';
+requires 'Furl';
+requires 'HTTP::Parser::XS';
+requires 'Syntax::Keyword::Match';
+
+requires 'Mojolicious';
+requires 'Mojo::mysql';
