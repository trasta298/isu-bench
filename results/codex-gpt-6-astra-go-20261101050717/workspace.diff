+        public ?int $evaluation,
+        public int $requestedAt,
+        public ?int $matchedAt,
+        public ?int $dispatchedAt,
+        public ?int $rodeAt,
+        public ?string $arrivedAt,
+        public string $updatedAt
+    ) {
+    }
+}
