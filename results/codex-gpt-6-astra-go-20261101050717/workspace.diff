@@ -0,0 +1,44 @@
+package main
+
+import (
+	"strings"
+	"time"
+)
+
+type storedLocation struct {
+	ChairID   string    `db:"chair_id"`
+	Latitude  int       `db:"latitude"`
+	Longitude int       `db:"longitude"`
+	Distance  int       `db:"total_distance"`
+	UpdatedAt time.Time `db:"updated_at"`
+}
+
+func resetLocationStore() error {
+	if locationDB == db {
+		return nil
+	}
+	var positions []storedLocation
+	if err := db.Select(&positions, "SELECT * FROM chair_state"); err != nil {
+		return err
+	}
+	tx, err := locationDB.Beginx()
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	if _, err := tx.Exec("DELETE FROM chair_state"); err != nil {
+		return err
+	}
+	for start := 0; start < len(positions); start += 256 {
+		rows := positions[start:min(start+256, len(positions))]
+		args := make([]interface{}, 0, len(rows)*5)
+		for _, p := range rows {
+			args = append(args, p.ChairID, p.Latitude, p.Longitude, p.Distance, p.UpdatedAt)
+		}
+		query := "INSERT INTO chair_state (chair_id,latitude,longitude,total_distance,updated_at) VALUES " + strings.TrimSuffix(strings.Repeat("(?,?,?,?,?),", len(rows)), ",")
+		if _, err := tx.Exec(query, args...); err != nil {
+			return err
+		}
+	}
+	return tx.Commit()
+}
diff --git a/checkpoint-run13/go/main.go b/checkpoint-run13/go/main.go
