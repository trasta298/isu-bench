+    };
+    let access_token = c.value();
+    let Some(chair): Option<Chair> = sqlx::query_as("SELECT * FROM chairs WHERE access_token = ?")
+        .bind(access_token)
+        .fetch_optional(&pool)
+        .await?
+    else {
+        return Err(Error::Unauthorized("invalid access token"));
