+            continue;
+        }
+
+        let fare = calculate_discounted_fare(
+            &mut tx,
+            &user.id,
+            Some(&ride),
+            ride.pickup_latitude,
+            ride.pickup_longitude,
+            ride.destination_latitude,
+            ride.destination_longitude,
