+        value => $access_token,
+    };
+
+    my $res = $c->render_json({
+            id              => $user_id,
+            invitation_code => $invitation_code,
+    }, AppPostUsersResponse);
+
+    $res->status(HTTP_CREATED);
+    return $res;
+
