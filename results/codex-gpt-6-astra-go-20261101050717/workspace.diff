+  const rideId = ctx.req.param("ride_id");
+  const reqJson = await ctx.req.json<{ evaluation: number }>();
+  if (reqJson.evaluation < 1 || reqJson.evaluation > 5) {
+    return ctx.text("evaluation must be between 1 and 5", 400);
