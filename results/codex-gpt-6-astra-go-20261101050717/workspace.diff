+package main
+
+import (
+ "context"
+ "database/sql"
+ "errors"
+ "sync"
+)
+
+type chairRuntime struct { mu sync.Mutex; loaded bool; ride *Ride; status string }
+var chairRuntimes sync.Map
+func runtimeFor(id string) *chairRuntime {
+ v,_:=chairRuntimes.LoadOrStore(id,&chairRuntime{});return v.(*chairRuntime)
+}
+func (c *chairRuntime) load(ctx context.Context,id string) error {
+ if c.loaded {return nil}
+ ride:=&Ride{}
+ if err:=db.GetContext(ctx,ride,`SELECT * FROM rides WHERE chair_id=? ORDER BY updated_at DESC LIMIT 1`,id);err!=nil {
+  if errors.Is(err,sql.ErrNoRows) {c.loaded=true;return nil};return err
+ }
+ status,err:=getLatestRideStatus(ctx,db,ride.ID);if err!=nil{return err}
+ c.ride=ride;c.status=status;c.loaded=true;return nil
+}
+func setRuntimeRide(ride *Ride,status string) {
+ if !ride.ChairID.Valid{return};c:=runtimeFor(ride.ChairID.String);c.mu.Lock();defer c.mu.Unlock();copyRide:=*ride;c.ride=&copyRide;c.status=status;c.loaded=true
+}
diff --git a/checkpoint-run11/go/state.go b/checkpoint-run11/go/state.go
new file mode 100644
index 0000000..3c69f0f
--- /dev/null
+++ b/checkpoint-run11/go/state.go
@@ -0,0 +1,141 @@
+package main
+
+import (
+ "context"
+ "database/sql"
+ "fmt"
+ "net/http"
+ "sort"
+ "sync"
+ "time"
+)
+
+type liveRide struct { Ride; Fare int; Statuses []RideStatus }
+type liveChair struct { Chair; Location ChairLocation; HasLocation bool; Distance int; Count int; EvaluationSum int }
+var stateMu sync.RWMutex
+var liveRides=map[string]*liveRide{}
+var liveChairs=map[string]*liveChair{}
+var liveOwners=map[string]*Owner{}
+var liveUsers=map[string]*User{}
+var ridesByUser=map[string][]string{}
+var ridesByChair=map[string][]string{}
+var creationLocks sync.Map
+var rideLocks sync.Map
+var notificationLocks sync.Map
+func entityLock(m *sync.Map,id string) *sync.Mutex {v,_:=m.LoadOrStore(id,&sync.Mutex{});return v.(*sync.Mutex)}
+
+func loadState() error {
+ var rides []Ride;var statuses []RideStatus;var chairs []Chair;var users []User;var owners []Owner;var coupons []Coupon
+ var locations []struct { ChairID string `db:"chair_id"`; Latitude int `db:"latitude"`; Longitude int `db:"longitude"`; Distance int `db:"total_distance"`; UpdatedAt time.Time `db:"updated_at"` }
+ for _,q:=range []struct{dst interface{};sql string}{{&rides,"SELECT * FROM rides ORDER BY created_at,id"},{&statuses,"SELECT * FROM ride_statuses ORDER BY created_at,id"},{&chairs,"SELECT * FROM chairs"},{&users,"SELECT * FROM users"},{&owners,"SELECT * FROM owners"},{&coupons,"SELECT * FROM coupons WHERE used_by IS NOT NULL"},{&locations,"SELECT * FROM chair_state"}} {if err:=db.Select(q.dst,q.sql);err!=nil{return err}}
+ stateMu.Lock();defer stateMu.Unlock()
+ liveOwners=map[string]*Owner{};for _,o:=range owners {o:=o;liveOwners[o.ID]=&o}
+ liveRides=map[string]*liveRide{};liveChairs=map[string]*liveChair{};liveUsers=map[string]*User{};ridesByUser=map[string][]string{};ridesByChair=map[string][]string{}
+ discounts:=map[string]int{};for _,c:=range coupons {discounts[*c.UsedBy]=c.Discount}
+ for _,u:=range users {u:=u;liveUsers[u.ID]=&u}
+ for _,c:=range chairs {liveChairs[c.ID]=&liveChair{Chair:c}}
+ for _,l:=range locations {if c:=liveChairs[l.ChairID];c!=nil {c.HasLocation=true;c.Location=ChairLocation{ChairID:l.ChairID,Latitude:l.Latitude,Longitude:l.Longitude,CreatedAt:l.UpdatedAt};c.Distance=l.Distance}}
+ for _,r:=range rides {
+  liveRides[r.ID]=&liveRide{Ride:r,Fare:initialFare+max(0,calculateFare(r.PickupLatitude,r.PickupLongitude,r.DestinationLatitude,r.DestinationLongitude)-initialFare-discounts[r.ID])}
+  ridesByUser[r.UserID]=append(ridesByUser[r.UserID],r.ID)
+  if r.ChairID.Valid {ridesByChair[r.ChairID.String]=append(ridesByChair[r.ChairID.String],r.ID);if r.Evaluation!=nil {c:=liveChairs[r.ChairID.String];c.Count++;c.EvaluationSum+=*r.Evaluation}}
+ }
+ for _,s:=range statuses {if r:=liveRides[s.RideID];r!=nil {r.Statuses=append(r.Statuses,s)}}
+ return nil
+}
+
+func refreshRide(id string) error {
+ lock:=entityLock(&rideLocks,id);lock.Lock();defer lock.Unlock()
+ var r Ride;var statuses []RideStatus
+ if err:=db.Get(&r,`SELECT * FROM rides WHERE id=?`,id);err!=nil{return err}
+ if err:=db.Select(&statuses,`SELECT * FROM ride_statuses WHERE ride_id=? ORDER BY created_at,id`,id);err!=nil{return err}
+ stateMu.RLock();old:=liveRides[id];stateMu.RUnlock()
+ fare:=0
+ if old!=nil {fare=old.Fare} else {
+  discount:=0;err:=db.Get(&discount,`SELECT discount FROM coupons WHERE used_by=?`,id);if err!=nil&&err!=sql.ErrNoRows{return err}
+  fare=initialFare+max(0,calculateFare(r.PickupLatitude,r.PickupLongitude,r.DestinationLatitude,r.DestinationLongitude)-initialFare-discount)
+ }
+ stateMu.Lock();defer stateMu.Unlock()
+ old=liveRides[id]
+ if old!=nil {
+  for i:=range statuses {for _,s:=range old.Statuses {if s.ID==statuses[i].ID {if s.AppSentAt!=nil {statuses[i].AppSentAt=s.AppSentAt};if s.ChairSentAt!=nil {statuses[i].ChairSentAt=s.ChairSentAt};break}}}
+ } else {ridesByUser[r.UserID]=append(ridesByUser[r.UserID],id)}
+ if r.ChairID.Valid && (old==nil || !old.ChairID.Valid) {ridesByChair[r.ChairID.String]=append(ridesByChair[r.ChairID.String],id)}
+ if r.Evaluation!=nil && (old==nil || old.Evaluation==nil) {if c:=liveChairs[r.ChairID.String];c!=nil {c.Count++;c.EvaluationSum+=*r.Evaluation}}
+ liveRides[id]=&liveRide{Ride:r,Fare:fare,Statuses:statuses}
+ return nil
+}
+
+func liveNotification(w http.ResponseWriter,r *http.Request,chair bool) {
+ ctx:=r.Context();id:="";kind:="user:"
+ if chair {id=ctx.Value("chair").(*Chair).ID;kind="chair:"} else {id=ctx.Value("user").(*User).ID}
+ lock:=entityLock(&notificationLocks,kind+id);lock.Lock();defer lock.Unlock()
+ stateMu.RLock()
+ ids:=ridesByUser[id];if chair {ids=ridesByChair[id]}
+ var chosen *liveRide;var status RideStatus;pending:=false
+ for _,rid:=range ids {rr:=liveRides[rid];for _,s:=range rr.Statuses {sent:=s.AppSentAt;if chair {sent=s.ChairSentAt};if sent==nil {chosen=rr;status=s;pending=true;break}};if pending{break}}
+ if chosen==nil&&len(ids)>0 {chosen=liveRides[ids[len(ids)-1]];if len(chosen.Statuses)>0 {status=chosen.Statuses[len(chosen.Statuses)-1]}}
+ var data interface{}
+ if chosen!=nil {
+  if chair {
+   u:=liveUsers[chosen.UserID]
+   if u==nil {stateMu.RUnlock();writeError(w,500,fmt.Errorf("missing user %s",chosen.UserID));return}
+   data=&chairGetNotificationResponseData{RideID:chosen.ID,User:simpleUser{ID:u.ID,Name:u.Firstname+" "+u.Lastname},PickupCoordinate:Coordinate{chosen.PickupLatitude,chosen.PickupLongitude},DestinationCoordinate:Coordinate{chosen.DestinationLatitude,chosen.DestinationLongitude},Status:status.Status}
+  } else {
+   d:=&appGetNotificationResponseData{RideID:chosen.ID,PickupCoordinate:Coordinate{chosen.PickupLatitude,chosen.PickupLongitude},DestinationCoordinate:Coordinate{chosen.DestinationLatitude,chosen.DestinationLongitude},Fare:chosen.Fare,Status:status.Status,CreatedAt:chosen.CreatedAt.UnixMilli(),UpdateAt:chosen.UpdatedAt.UnixMilli()}
+   if c:=liveChairs[chosen.ChairID.String];c!=nil {stats:=appGetNotificationResponseChairStats{TotalRidesCount:c.Count};if c.Count>0 {stats.TotalEvaluationAvg=float64(c.EvaluationSum)/float64(c.Count)};d.Chair=&appGetNotificationResponseChair{ID:c.ID,Name:c.Name,Model:c.Model,Stats:stats}}
+   data=d
+  }
+ }
+ stateMu.RUnlock()
+ if pending {
+  if err:=persistAck(ctx,status.ID,chair);err!=nil {writeError(w,500,err);return}
+  now:=time.Now();stateMu.Lock();if current:=liveRides[chosen.ID];current!=nil {for i:=range current.Statuses {if current.Statuses[i].ID==status.ID {if chair {current.Statuses[i].ChairSentAt=&now} else {current.Statuses[i].AppSentAt=&now};break}}};stateMu.Unlock()
+ }
+ writeJSON(w,200,struct {Data interface{} `json:"data"`; Retry int `json:"retry_after_ms"`}{data,30})
+}
+func fastAppNotification(w http.ResponseWriter,r *http.Request) {liveNotification(w,r,false)}
+func fastChairNotification(w http.ResponseWriter,r *http.Request) {liveNotification(w,r,true)}
+
+func updateLiveLocation(id string,p Coordinate,now time.Time) {
+ stateMu.Lock();defer stateMu.Unlock();if c:=liveChairs[id];c!=nil {if c.HasLocation {c.Distance+=calculateDistance(c.Location.Latitude,c.Location.Longitude,p.Latitude,p.Longitude)};c.Location=ChairLocation{ChairID:id,Latitude:p.Latitude,Longitude:p.Longitude,CreatedAt:now};c.HasLocation=true}
+}
+func isAvailable(id string) bool {
+ ids:=ridesByChair[id];if len(ids)==0{return true};r:=liveRides[ids[len(ids)-1]];if len(r.Statuses)==0{return false};s:=r.Statuses[len(r.Statuses)-1];return s.Status=="COMPLETED"&&s.ChairSentAt!=nil
+}
+func snapshotPending() ([]Ride,[]matchChair) {
+ stateMu.RLock();defer stateMu.RUnlock()
+ rides:=[]Ride{};chairs:=[]matchChair{}
+ for _,r:=range liveRides {if !r.ChairID.Valid {rides=append(rides,r.Ride)}}
+ sort.Slice(rides,func(i,j int)bool{return rides[i].CreatedAt.Before(rides[j].CreatedAt)})
+ for _,c:=range liveChairs {if c.IsActive&&c.HasLocation&&isAvailable(c.ID) {chairs=append(chairs,matchChair{ID:c.ID,Latitude:c.Location.Latitude,Longitude:c.Location.Longitude,Speed:modelSpeeds[c.Model]})}}
+ return rides,chairs
+}
+var modelSpeeds=map[string]int{}
+func loadSpeeds() {var models []ChairModel;if err:=db.Select(&models,"SELECT * FROM chair_models");err!=nil {panic(err)};for _,m:=range models {modelSpeeds[m.Name]=m.Speed}}
+func addLiveUser(ctx context.Context,id string) error {u:=&User{};if err:=db.GetContext(ctx,u,"SELECT * FROM users WHERE id=?",id);err!=nil{return err};stateMu.Lock();liveUsers[id]=u;stateMu.Unlock();return nil}
+func addLiveChair(ctx context.Context,id string) error {c:=&Chair{};if err:=db.GetContext(ctx,c,"SELECT * FROM chairs WHERE id=?",id);err!=nil{return err};stateMu.Lock();liveChairs[id]=&liveChair{Chair:*c};stateMu.Unlock();return nil}
+
+func addLiveOwner(ctx context.Context,id string) error {o:=&Owner{};if err:=db.GetContext(ctx,o,"SELECT * FROM owners WHERE id=?",id);err!=nil{return err};stateMu.Lock();liveOwners[id]=o;stateMu.Unlock();return nil}
+
+func publishNewRide(ride Ride,fare int,statusID string){
+ stateMu.Lock()
+ liveRides[ride.ID]=&liveRide{Ride:ride,Fare:fare,Statuses:[]RideStatus{{ID:statusID,RideID:ride.ID,Status:"MATCHING",CreatedAt:ride.CreatedAt}}}
+ ridesByUser[ride.UserID]=append(ridesByUser[ride.UserID],ride.ID)
+ stateMu.Unlock()
+ notifyKey("user:"+ride.UserID)
+}
+func publishStatus(ride *Ride,statusID,status string){
+ stateMu.Lock()
+ old:=liveRides[ride.ID]
+ updated:=*old
+ updated.Statuses=append(append([]RideStatus(nil),old.Statuses...),RideStatus{ID:statusID,RideID:ride.ID,Status:status,CreatedAt:time.Now().UTC()})
+ if status=="COMPLETED" {
+  updated.Ride=*ride
+  if old.Evaluation==nil&&ride.Evaluation!=nil {c:=liveChairs[ride.ChairID.String];c.Count++;c.EvaluationSum+=*ride.Evaluation}
+ }
+ liveRides[ride.ID]=&updated
+ stateMu.Unlock()
+ notifyKey("user:"+ride.UserID)
+ if ride.ChairID.Valid{notifyKey("chair:"+ride.ChairID.String)}
+}
