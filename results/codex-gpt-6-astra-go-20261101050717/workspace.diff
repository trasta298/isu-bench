+        row = conn.execute(
+            text("SELECT * FROM chairs WHERE access_token = :access_token"),
+            {"access_token": chair_session},
+        ).fetchone()
+
+        if row is None:
+            raise HTTPException(
+                status_code=HTTPStatus.UNAUTHORIZED, detail="invalid access token"
+            )
