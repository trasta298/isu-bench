+                $response,
+                new AppPostRidesEstimatedFare200Response(
+                    [
+                        'fare' => $discounted,
+                        'discount' => $this->calculateFare(
+                            $pickupCoordinate->getLatitude(),
+                            $pickupCoordinate->getLongitude(),
+                            $destinationCoordinate->getLatitude(),
+                            $destinationCoordinate->getLongitude()
+                        ) - $discounted
+                    ]
