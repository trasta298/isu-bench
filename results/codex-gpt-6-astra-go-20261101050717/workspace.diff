+package main
+
+import (
+	"context"
+	"sort"
+	"strings"
+	"time"
+)
+
+type notificationAck struct {
+	id    string
+	chair bool
+	done  chan error
+}
+
+var notificationAcks = make(chan *notificationAck, 8192)
+
+func persistAck(ctx context.Context, id string, chair bool) error {
+	a := &notificationAck{id: id, chair: chair, done: make(chan error, 1)}
+	select {
+	case notificationAcks <- a:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	return <-a.done
+}
+func notificationWriterLoop() {
+	for first := range notificationAcks {
+		batch := []*notificationAck{first}
+		timer := time.NewTimer(500 * time.Microsecond)
+	collect:
+		for len(batch) < 512 {
+			select {
+			case a := <-notificationAcks:
+				batch = append(batch, a)
+			case <-timer.C:
+				break collect
+			}
+		}
+		timer.Stop()
+		sort.Slice(batch, func(i, j int) bool { return batch[i].id < batch[j].id })
+		for _, chair := range []bool{false, true} {
+			args := []interface{}{}
+			group := []*notificationAck{}
+			for _, a := range batch {
+				if a.chair == chair {
+					group = append(group, a)
+					args = append(args, a.id)
+				}
+			}
+			if len(args) == 0 {
+				continue
+			}
+			column := "app_sent_at"
+			if chair {
+				column = "chair_sent_at"
+			}
+			q := "UPDATE ride_statuses SET " + column + "=CURRENT_TIMESTAMP(6) WHERE id IN (" + strings.TrimSuffix(strings.Repeat("?,", len(args)), ",") + ")"
+			_, err := db.Exec(q, args...)
+			for _, a := range group {
+				a.done <- err
+			}
+		}
+	}
+}
