index 0000000..1a59b96
--- /dev/null
+++ b/checkpoint-run13/go/notification_batch.go
@@ -0,0 +1,65 @@
+package main
+
+import (
+	"context"
+	"sort"
+	"strings"
+	"time"
+)
+
+type notificationAck struct {
+	id    string
+	chair bool
+	done  chan error
+}
+
+var notificationAcks = make(chan *notificationAck, 8192)
+
+func persistAck(ctx context.Context, id string, chair bool) error {
+	a := &notificationAck{id: id, chair: chair, done: make(chan error, 1)}
+	select {
+	case notificationAcks <- a:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	return <-a.done
+}
+func notificationWriterLoop() {
+	for first := range notificationAcks {
+		batch := []*notificationAck{first}
+		timer := time.NewTimer(500 * time.Microsecond)
+	collect:
+		for len(batch) < 512 {
+			select {
+			case a := <-notificationAcks:
+				batch = append(batch, a)
+			case <-timer.C:
+				break collect
+			}
+		}
+		timer.Stop()
+		sort.Slice(batch, func(i, j int) bool { return batch[i].id < batch[j].id })
+		for _, chair := range []bool{false, true} {
+			args := []interface{}{}
+			group := []*notificationAck{}
+			for _, a := range batch {
+				if a.chair == chair {
+					group = append(group, a)
+					args = append(args, a.id)
+				}
+			}
+			if len(args) == 0 {
+				continue
+			}
+			column := "app_sent_at"
+			if chair {
+				column = "chair_sent_at"
+			}
+			q := "UPDATE ride_statuses SET " + column + "=CURRENT_TIMESTAMP(6) WHERE id IN (" + strings.TrimSuffix(strings.Repeat("?,", len(args)), ",") + ")"
+			_, err := db.Exec(q, args...)
+			for _, a := range group {
+				a.done <- err
+			}
+		}
+	}
+}
diff --git a/checkpoint-run13/go/notifications.go b/checkpoint-run13/go/notifications.go
new file mode 100644
index 0000000..2f67c48
--- /dev/null
+++ b/checkpoint-run13/go/notifications.go
@@ -0,0 +1,96 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"log/slog"
+	"net/http"
+	"sync"
+	"time"
+)
+
+var eventMu sync.Mutex
+var events = map[string]chan struct{}{}
+
+func watchKey(key string) <-chan struct{} {
+	eventMu.Lock()
+	defer eventMu.Unlock()
+	ch := events[key]
+	if ch == nil {
+		ch = make(chan struct{})
+		events[key] = ch
+	}
+	return ch
+}
+func notifyKey(key string) {
+	eventMu.Lock()
+	defer eventMu.Unlock()
+	if ch := events[key]; ch != nil {
+		close(ch)
+		events[key] = make(chan struct{})
+	}
+}
+func notifyRide(r *Ride) {
+	if err := refreshRide(r.ID); err != nil {
+		slog.Error("refresh ride", "error", err)
+	}
+	notifyKey("user:" + r.UserID)
+	if r.ChairID.Valid {
+		notifyKey("chair:" + r.ChairID.String)
+	}
+}
+
+type notificationWriter struct {
+	header http.Header
+	code   int
+	bytes.Buffer
+}
+
+func (w *notificationWriter) Header() http.Header  { return w.header }
+func (w *notificationWriter) WriteHeader(code int) { w.code = code }
+func streamNotification(fn http.HandlerFunc, kind string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		key := "user:"
+		if kind == "user" {
+			key += r.Context().Value("user").(*User).ID
+		} else {
+			key = "chair:" + r.Context().Value("chair").(*Chair).ID
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		w.Header().Set("Cache-Control", "no-cache")
+		w.Header().Set("X-Accel-Buffering", "no")
+		flush := w.(http.Flusher)
+		var prev []byte
+		timer := time.NewTicker(time.Second)
+		defer timer.Stop()
+		for {
+			changed := watchKey(key)
+			rec := &notificationWriter{header: make(http.Header), code: 200}
+			fn(rec, r)
+			if rec.code != 200 {
+				slog.Error("notification failed", "body", rec.String())
+				return
+			}
+			var envelope struct {
+				Data json.RawMessage `json:"data"`
+			}
+			if err := json.Unmarshal(rec.Bytes(), &envelope); err != nil {
+				return
+			}
+			if !bytes.Equal(envelope.Data, prev) {
+				if _, err := w.Write(append(append([]byte("data: "), envelope.Data...), '\n', '\n')); err != nil {
+					return
+				}
+				flush.Flush()
+				prev = append(prev[:0], envelope.Data...)
+				continue
+			}
+			select {
+			case <-changed:
+			case <-timer.C:
+			case <-r.Context().Done():
+				return
+			}
+		}
+	}
+}
diff --git a/checkpoint-run13/go/owner_handlers.go b/checkpoint-run13/go/owner_handlers.go
