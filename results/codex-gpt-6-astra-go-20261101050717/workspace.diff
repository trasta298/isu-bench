+
+        continuing_ride_count = 0
+        for ride in rides:
+            status = get_latest_ride_status(conn, ride.id)
+            if status != "COMPLETED":
+                continuing_ride_count += 1
+
+        if continuing_ride_count > 0:
+            raise HTTPException(
+                status_code=HTTPStatus.CONFLICT, detail="ride already exists"
+            )
+
+        conn.execute(
+            text(
