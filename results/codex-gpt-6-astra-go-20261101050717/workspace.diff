+};
+
+use constant AppGetNotificationResponseData => {
+    ride_id                => JSON_TYPE_STRING,
+    pickup_coordinate      => Coordinate,
+    destination_coordinate => Coordinate,
+    fare                   => JSON_TYPE_INT,
+    status                 => JSON_TYPE_STRING,
+    chair                  => AppGetNotificationResponseChair,
