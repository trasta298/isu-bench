+
+    my $counting_ride_count = 0;
+
+    for my $ride ($rides->@*) {
+        my $status = get_latest_ride_status($c, $ride->{id});
+
+        if ($status ne 'COMPLETED') {
+            $counting_ride_count++;
+        }
+    }
+
+    if ($counting_ride_count > 0) {
+        return $c->halt_json(HTTP_CONFLICT, 'ride already exists');
+    }
+
+    $db->query(
