diff --git a/config/nginx-final.py b/config/nginx-final.py
new file mode 100644
index 0000000..76747bf
--- /dev/null
+++ b/config/nginx-final.py
@@ -0,0 +1,18 @@
+from pathlib import Path
+import gzip
+root=Path('/home/isucon/webapp/public')
+for p in root.rglob('*'):
+    if p.is_file() and p.suffix in {'.html','.js','.css','.svg','.json'}:
+        p.with_name(p.name+'.gz').write_bytes(gzip.compress(p.read_bytes(),compresslevel=9,mtime=0))
+p=Path('/etc/nginx/nginx.conf')
+s=p.read_text().replace('http {','''http {
+ gzip_static on;
+ open_file_cache max=10000 inactive=60s;
+ open_file_cache_valid 60s;
+ open_file_cache_min_uses 1;
+ keepalive_requests 10000;
+ ssl_session_cache shared:SSL:20m;
+ ssl_session_timeout 1h;
+''',1)
+p.write_text(s)
+p=Path('/etc/nginx/sites-available/isuride.conf');s=p.read_text().replace('listen 443 ssl','listen 443 ssl http2');p.write_text(s)
diff --git a/config/reboot_check.py b/config/reboot_check.py
new file mode 100644
index 0000000..1971b89
--- /dev/null
+++ b/config/reboot_check.py
@@ -0,0 +1,32 @@
+import json,subprocess,urllib.request,sys,hashlib
+from pathlib import Path
+snapshot=Path('/home/isucon/reboot-snapshot.json')
+def sql(query):
+    return subprocess.check_output(['mysql','-h','10.0.1.116','-u','isucon','-pisucon','-N','-B','isuride','-e',query],stderr=subprocess.DEVNULL,text=True).splitlines()
+def canonical(x):
+    if isinstance(x,dict):return {k:canonical(v) for k,v in sorted(x.items())}
+    if isinstance(x,list):return sorted((canonical(v) for v in x),key=lambda v:json.dumps(v,sort_keys=True))
+    return x
+def fetch(path,cookie):
+    req=urllib.request.Request('http://127.0.0.1:8080'+path,headers={'Cookie':cookie})
+    with urllib.request.urlopen(req,timeout=20) as response:return canonical(json.load(response))
+if sys.argv[1]=='capture':
+    checks=[]
+    for row in sql('SELECT id,access_token FROM owners ORDER BY created_at DESC LIMIT 15'):
+        oid,token=row.split('\t')
+        for endpoint in ['chairs','sales']:
+            path='/api/owner/'+endpoint;cookie='owner_session='+token
+            checks.append(dict(path=path,cookie=cookie,result=fetch(path,cookie)))
+    for row in sql('SELECT u.id,u.access_token FROM users u WHERE EXISTS(SELECT 1 FROM rides r WHERE r.user_id=u.id AND r.evaluation IS NOT NULL) ORDER BY u.created_at DESC LIMIT 20'):
+        uid,token=row.split('\t');path='/api/app/rides';cookie='app_session='+token
+        checks.append(dict(path=path,cookie=cookie,result=fetch(path,cookie)))
+    snapshot.write_text(json.dumps(checks,ensure_ascii=False))
+    snapshot.chmod(0o600)
+    print('Captured',len(checks),'API responses for persistence verification')
+else:
+    checks=json.loads(snapshot.read_text());mismatches=[]
+    for i,c in enumerate(checks):
+        actual=fetch(c['path'],c['cookie'])
+        if actual!=c['result']:mismatches.append((i,c['path']))
+    print('Verified',len(checks),'API responses; mismatches:',mismatches)
+    sys.exit(bool(mismatches))
