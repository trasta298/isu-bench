new file mode 100644
index 0000000..2fd4541
--- /dev/null
+++ b/checkpoint-run13/go/internal_handlers.go
@@ -0,0 +1,135 @@
+package main
+
+import (
+	"container/heap"
+	"context"
+	"log/slog"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+)
+
+var matchingMu sync.Mutex
+
+type matchChair struct {
+	ID                         string
+	Latitude, Longitude, Speed int
+}
+type matchCandidate struct {
+	ride, chair int
+	cost        float64
+}
+type matchHeap []matchCandidate
+
+func (h matchHeap) Len() int            { return len(h) }
+func (h matchHeap) Less(i, j int) bool  { return h[i].cost < h[j].cost }
+func (h matchHeap) Swap(i, j int)       { h[i], h[j] = h[j], h[i] }
+func (h *matchHeap) Push(x interface{}) { *h = append(*h, x.(matchCandidate)) }
+func (h *matchHeap) Pop() interface{} {
+	old := *h
+	n := len(old)
+	v := old[n-1]
+	*h = old[:n-1]
+	return v
+}
+func internalGetMatching(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusNoContent) }
+
+var lastMatchLog time.Time
+
+func matchRides() {
+	if !matchingMu.TryLock() {
+		return
+	}
+	defer matchingMu.Unlock()
+	rides, chairs := snapshotPending()
+	now := time.Now().UTC()
+	if now.Sub(lastMatchLog) > 5*time.Second {
+		age := 0.0
+		if len(rides) > 0 {
+			age = now.Sub(rides[0].CreatedAt).Seconds()
+		}
+		slog.Info("matching queue", "pending", len(rides), "available", len(chairs), "oldest", age)
+		lastMatchLog = now
+	}
+	if len(rides) == 0 || len(chairs) == 0 {
+		return
+	}
+	used := make([]bool, len(chairs))
+	find := func(ri int) matchCandidate {
+		r := rides[ri]
+		best := matchCandidate{ride: ri, chair: -1, cost: 1e30}
+		age := now.Sub(r.CreatedAt).Seconds()
+		priority := 4 * age * age
+		trip := float64(calculateDistance(r.PickupLatitude, r.PickupLongitude, r.DestinationLatitude, r.DestinationLongitude))
+		for ci, c := range chairs {
+			if used[ci] {
+				continue
+			}
+			speed := max(c.Speed, 1)
+			cost := (float64(calculateDistance(r.PickupLatitude, r.PickupLongitude, c.Latitude, c.Longitude))+0.2*trip)/float64(speed) - priority
+			if cost < best.cost {
+				best.chair = ci
+				best.cost = cost
+			}
+		}
+		return best
+	}
+	candidates := &matchHeap{}
+	for ri := range rides {
+		heap.Push(candidates, find(ri))
+	}
+	pairs := []matchCandidate{}
+	for candidates.Len() > 0 && len(pairs) < len(chairs) {
+		p := heap.Pop(candidates).(matchCandidate)
+		if p.chair < 0 {
+			break
+		}
+		if used[p.chair] {
+			heap.Push(candidates, find(p.ride))
+			continue
+		}
+		used[p.chair] = true
+		pairs = append(pairs, p)
+	}
+	if len(pairs) == 0 {
+		return
+	}
+	var query strings.Builder
+	query.WriteString("UPDATE rides SET chair_id=CASE id")
+	args := make([]interface{}, 0, len(pairs)*3+1)
+	for _, p := range pairs {
+		query.WriteString(" WHEN ? THEN ?")
+		args = append(args, rides[p.ride].ID, chairs[p.chair].ID)
+	}
+	query.WriteString(" END, updated_at=? WHERE chair_id IS NULL AND id IN (")
+	args = append(args, now)
+	for i, p := range pairs {
+		if i > 0 {
+			query.WriteByte(',')
+		}
+		query.WriteByte('?')
+		args = append(args, rides[p.ride].ID)
+	}
+	query.WriteByte(')')
+	if _, err := db.ExecContext(context.Background(), query.String(), args...); err != nil {
+		slog.Error("matching update", "error", err)
+		return
+	}
+	for _, p := range pairs {
+		r := rides[p.ride]
+		r.ChairID.String = chairs[p.chair].ID
+		r.ChairID.Valid = true
+		r.UpdatedAt = now
+		setRuntimeRide(&r, "MATCHING")
+		stateMu.Lock()
+		old := liveRides[r.ID]
+		copyRide := *old
+		copyRide.Ride = r
+		liveRides[r.ID] = &copyRide
+		ridesByChair[r.ChairID.String] = append(ridesByChair[r.ChairID.String], r.ID)
+		stateMu.Unlock()
+		notifyKey("user:" + r.UserID)
+		notifyKey("chair:" + r.ChairID.String)
+	}
+}
