+    $app->dbh->query(
+        'INSERT INTO chair_locations (id, chair_id, latitude, longitude) VALUES (?, ?, ?, ?)',
+        $chair_location_id, $chair->{id}, $params->{latitude}, $params->{longitude},
+    );
