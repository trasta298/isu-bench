+
+    my $user = $c->mysql->db->select_row(
+        'SELECT * FROM users WHERE access_token = ?',
+        $access_token
+    );
+
+    unless ($user) {
+        return $c->halt_json(HTTP_UNAUTHORIZED, 'invalid access_token');
+    }
+
+    $c->stash(user => $user);
+    return;
