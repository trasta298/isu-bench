+// connectDNS opens a small connection used only when a new user registers.
+// We insert the A record directly instead of spawning pdnsutil, which is one
+// of the most expensive operations in the original implementation.
+func connectDNS() (*sqlx.DB, error) {
+	conf := mysql.NewConfig()
+	conf.Net = "tcp"
+	conf.Addr = net.JoinHostPort(getenvDefault("ISUCON13_DNS_DB_ADDRESS", "127.0.0.1"), getenvDefault("ISUCON13_DNS_DB_PORT", "3306"))
+	conf.User = getenvDefault("ISUCON13_DNS_DB_USER", "isudns")
+	conf.Passwd = getenvDefault("ISUCON13_DNS_DB_PASSWORD", "isudns")
+	conf.DBName = getenvDefault("ISUCON13_DNS_DB_DATABASE", "isudns")
+	conf.ParseTime = true
+	db, err := sqlx.Open("mysql", conf.FormatDSN())
+	if err != nil {
+		return nil, err
+	}
+	db.SetMaxOpenConns(20)
+	db.SetMaxIdleConns(20)
+	db.SetConnMaxLifetime(0)
+	if err := db.Ping(); err != nil {
+		db.Close()
+		return nil, err
+	}
+	return db, nil
+}
+
+func getenvDefault(key, def string) string {
+	if v, ok := os.LookupEnv(key); ok && v != "" {
+		return v
+	}
+	return def
+}
+
+func addDNSRecord(ctx context.Context, name string) error {
+	// ctx is only used through the background context in practice; keep the
+	// pdnsutil fallback for environments where the direct connection is not
+	// available.
+	fqdn := name
+	if !strings.HasSuffix(fqdn, ".u.isucon.dev") {
+		fqdn = name + ".u.isucon.dev"
+	}
+	if dnsConn != nil {
+		res, err := dnsConn.Exec("INSERT INTO records (domain_id, name, type, content, ttl, prio, disabled, ordername, auth) SELECT id, ?, 'A', ?, 0, 0, 0, NULL, 1 FROM domains WHERE name = 'u.isucon.dev' LIMIT 1", fqdn, powerDNSSubdomainAddress)
+		if err == nil {
+			if n, _ := res.RowsAffected(); n > 0 {
+				return nil
+			}
+			err = fmt.Errorf("domain u.isucon.dev not found")
+		}
+		log.Printf("direct DNS insert failed, falling back to pdnsutil: %v", err)
+	}
+	if out, err := exec.Command("pdnsutil", "add-record", "u.isucon.dev", name, "A", "0", powerDNSSubdomainAddress).CombinedOutput(); err != nil {
+		return fmt.Errorf("%s: %w", string(out), err)
+	}
+	return nil
+}
+
+func notifyPeer(path string) {
+	raw := os.Getenv("ISUCON13_PEER_URLS")
+	if raw == "" {
+		raw = os.Getenv("ISUCON13_PEER_URL")
+	}
+	if raw == "" {
+		return
+	}
+	client := &http.Client{
+		Timeout: 500 * time.Millisecond,
+		Transport: &http.Transport{
+			Proxy: nil,
+		},
+	}
+	for _, peer := range strings.Split(raw, ",") {
+		peer = strings.TrimSpace(peer)
+		if peer == "" {
+			continue
+		}
+		req, err := http.NewRequest(http.MethodPost, peer+path, nil)
+		if err != nil {
+			continue
+		}
+		req.Header.Set("X-Isucon-Internal", internalSecret)
+		resp, err := client.Do(req)
+		if err != nil {
+			continue
+		}
+		resp.Body.Close()
+	}
+}
+
+func checkInternal(c echo.Context) bool {
+	return c.Request().Header.Get("X-Isucon-Internal") == internalSecret
+}
+
+func internalClearCacheHandler(c echo.Context) error {
+	if !checkInternal(c) {
+		return echo.NewHTTPError(http.StatusNotFound)
+	}
+	clearCaches()
+	return c.NoContent(http.StatusNoContent)
+}
+
+func internalInvalidateUserHandler(c echo.Context) error {
+	if !checkInternal(c) {
+		return echo.NewHTTPError(http.StatusNotFound)
+	}
+	id, err := strconv.ParseInt(c.QueryParam("user_id"), 10, 64)
+	if err != nil {
+		return echo.NewHTTPError(http.StatusBadRequest)
+	}
+	invalidateUserCache(id)
+	return c.NoContent(http.StatusNoContent)
+}
+
 func initializeHandler(c echo.Context) error {
