+	if header == "" {
+		return false
+	}
+	for _, part := range strings.Split(header, ",") {
+		part = strings.TrimSpace(part)
+		if part == "*" {
+			return true
+		}
+		part = strings.TrimPrefix(part, "W/")
+		part = strings.Trim(part, "\"")
+		if part == hash {
+			return true
+		}
+	}
+	return false
