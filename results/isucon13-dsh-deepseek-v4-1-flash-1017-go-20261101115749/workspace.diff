diff --git a/webapp/go/cache.go b/webapp/go/cache.go
new file mode 100644
index 0000000..0548d3b
--- /dev/null
+++ b/webapp/go/cache.go
@@ -0,0 +1,495 @@
+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"errors"
+	"fmt"
+	"os"
+	"sync"
+
+	"github.com/jmoiron/sqlx"
+)
+
+// ---------------------------------------------------------------------------
+// In-process caches for immutable / rarely-changing rows.
+// The benchmark calls /api/initialize between runs, which resets the database.
+// Every cache is cleared from initializeHandler both before and after the reset.
+// ---------------------------------------------------------------------------
+
+type userCacheEntry struct {
+	Model      UserModel
+	Theme      ThemeModel
+	IconHash   string
+	IconData   []byte
+	IconLoaded bool
+}
+
+type livestreamCacheEntry struct {
+	Model  LivestreamModel
+	Tags   []Tag
+	TagIDs []int64
+}
+
+var (
+	cacheMu        sync.RWMutex
+	userByID       = make(map[int64]*userCacheEntry)
+	userByName     = make(map[string]int64)
+	livestreamByID = make(map[int64]*livestreamCacheEntry)
+
+	tagsMu     sync.Mutex
+	tagsLoaded bool
+	allTags    []*TagModel
+	tagByID    = make(map[int64]TagModel)
+	tagByName  = make(map[string]int64)
+
+	ngMu      sync.RWMutex
+	ngCache   = make(map[int64][]*NGWord)
+	ngApplied = make(map[int64]map[int64]bool)
+
+	fallbackOnce sync.Once
+	fallbackData []byte
+	fallbackHash string
+)
+
+func clearCaches() {
+	cacheMu.Lock()
+	userByID = make(map[int64]*userCacheEntry)
+	userByName = make(map[string]int64)
+	livestreamByID = make(map[int64]*livestreamCacheEntry)
+	cacheMu.Unlock()
+
+	tagsMu.Lock()
+	tagsLoaded = false
+	allTags = nil
+	tagByID = make(map[int64]TagModel)
+	tagByName = make(map[string]int64)
+	tagsMu.Unlock()
+
+	ngMu.Lock()
+	ngCache = make(map[int64][]*NGWord)
+	ngApplied = make(map[int64]map[int64]bool)
+	ngMu.Unlock()
+}
+
+func getFallbackImage() ([]byte, string) {
+	fallbackOnce.Do(func() {
+		data, err := os.ReadFile(fallbackImage)
+		if err == nil {
+			fallbackData = data
+			fallbackHash = fmt.Sprintf("%x", sha256.Sum256(data))
+		} else {
+			fallbackHash = fmt.Sprintf("%x", sha256.Sum256(nil))
+		}
+	})
+	return fallbackData, fallbackHash
+}
+
+func ensureTags(ctx context.Context) error {
+	tagsMu.Lock()
+	defer tagsMu.Unlock()
+	if tagsLoaded {
+		return nil
+	}
+	var models []*TagModel
+	if err := dbConn.SelectContext(ctx, &models, "SELECT * FROM tags ORDER BY id"); err != nil {
+		return err
+	}
+	allTags = models
+	tagByID = make(map[int64]TagModel, len(models))
+	tagByName = make(map[string]int64, len(models))
+	for _, t := range models {
+		tagByID[t.ID] = *t
+		tagByName[t.Name] = t.ID
+	}
+	tagsLoaded = true
+	return nil
+}
+
+func tagsResponse() []*Tag {
+	tagsMu.Lock()
+	defer tagsMu.Unlock()
+	out := make([]*Tag, len(allTags))
+	for i, t := range allTags {
+		out[i] = &Tag{ID: t.ID, Name: t.Name}
+	}
+	return out
+}
+
+func getTagIDByName(ctx context.Context, name string) (int64, error) {
+	if err := ensureTags(ctx); err != nil {
+		return 0, err
+	}
+	tagsMu.Lock()
+	id, ok := tagByName[name]
+	tagsMu.Unlock()
+	if !ok {
+		return 0, sql.ErrNoRows
+	}
+	return id, nil
+}
+
+func tagModelsByIDs(ctx context.Context, ids []int64) (map[int64]TagModel, error) {
+	if err := ensureTags(ctx); err != nil {
+		return nil, err
+	}
+	out := make(map[int64]TagModel, len(ids))
+	tagsMu.Lock()
+	for _, id := range ids {
+		if t, ok := tagByID[id]; ok {
+			out[id] = t
+		}
+	}
+	tagsMu.Unlock()
+	return out, nil
+}
+
+func putUserEntry(e *userCacheEntry) {
+	cacheMu.Lock()
+	userByID[e.Model.ID] = e
+	userByName[e.Model.Name] = e.Model.ID
+	cacheMu.Unlock()
+}
+
+func getUserEntryByID(ctx context.Context, id int64) (*userCacheEntry, error) {
+	cacheMu.RLock()
+	e := userByID[id]
+	cacheMu.RUnlock()
+	if e != nil {
+		return e, nil
+	}
+	if err := loadUsersByIDs(ctx, []int64{id}); err != nil {
+		return nil, err
+	}
+	cacheMu.RLock()
+	e = userByID[id]
+	cacheMu.RUnlock()
+	if e == nil {
+		return nil, sql.ErrNoRows
+	}
+	return e, nil
+}
+
+func getUserEntryByName(ctx context.Context, name string) (*userCacheEntry, error) {
+	cacheMu.RLock()
+	id, ok := userByName[name]
+	var e *userCacheEntry
+	if ok {
+		e = userByID[id]
+	}
+	cacheMu.RUnlock()
+	if e != nil {
+		return e, nil
+	}
+
+	var foundID int64
+	if err := dbConn.GetContext(ctx, &foundID, "SELECT id FROM users WHERE name = ?", name); err != nil {
+		return nil, err
+	}
+	return getUserEntryByID(ctx, foundID)
+}
+
+func loadUsersByIDs(ctx context.Context, ids []int64) error {
+	if len(ids) == 0 {
+		return nil
+	}
+	wanted := make(map[int64]struct{}, len(ids))
+	cacheMu.RLock()
+	for _, id := range ids {
+		if _, ok := userByID[id]; !ok {
+			wanted[id] = struct{}{}
+		}
+	}
+	cacheMu.RUnlock()
+	if len(wanted) == 0 {
+		return nil
+	}
+	missing := make([]int64, 0, len(wanted))
+	for id := range wanted {
+		missing = append(missing, id)
+	}
+
+	var models []UserModel
+	q, args, err := sqlx.In("SELECT * FROM users WHERE id IN (?)", missing)
+	if err != nil {
+		return err
+	}
+	if err := dbConn.SelectContext(ctx, &models, dbConn.Rebind(q), args...); err != nil {
+		return err
+	}
+
+	var themes []ThemeModel
+	q, args, err = sqlx.In("SELECT * FROM themes WHERE user_id IN (?)", missing)
+	if err != nil {
+		return err
+	}
+	if err := dbConn.SelectContext(ctx, &themes, dbConn.Rebind(q), args...); err != nil {
+		return err
+	}
+
+	type iconRow struct {
+		UserID int64  `db:"user_id"`
+		Image  []byte `db:"image"`
+	}
+	var icons []iconRow
+	q, args, err = sqlx.In("SELECT user_id, image FROM icons WHERE user_id IN (?)", missing)
+	if err != nil {
+		return err
+	}
+	if err := dbConn.SelectContext(ctx, &icons, dbConn.Rebind(q), args...); err != nil {
+		return err
+	}
+
+	themeMap := make(map[int64]ThemeModel, len(themes))
+	for _, t := range themes {
+		themeMap[t.UserID] = t
+	}
+	iconMap := make(map[int64][]byte, len(icons))
+	for _, i := range icons {
+		iconMap[i.UserID] = i.Image
+	}
+	_, fbHash := getFallbackImage()
+
+	cacheMu.Lock()
+	for i := range models {
+		m := models[i]
+		if _, exists := userByID[m.ID]; exists {
+			continue
+		}
+		e := &userCacheEntry{Model: m}
+		if t, ok := themeMap[m.ID]; ok {
+			e.Theme = t
+		}
+		if img, ok := iconMap[m.ID]; ok {
+			e.IconData = img
+			e.IconHash = fmt.Sprintf("%x", sha256.Sum256(img))
+			e.IconLoaded = true
+		} else {
+			e.IconHash = fbHash
+		}
+		userByID[m.ID] = e
+		userByName[m.Name] = m.ID
+	}
+	cacheMu.Unlock()
+	return nil
+}
+
+func fillUserResponseFromEntry(e *userCacheEntry) User {
+	return User{
+		ID:          e.Model.ID,
+		Name:        e.Model.Name,
+		DisplayName: e.Model.DisplayName,
+		Description: e.Model.Description,
+		Theme: Theme{
+			ID:       e.Theme.ID,
+			DarkMode: e.Theme.DarkMode,
+		},
+		IconHash: e.IconHash,
+	}
+}
+
+func invalidateUserCache(userID int64) {
+	cacheMu.Lock()
+	if e, ok := userByID[userID]; ok {
+		delete(userByName, e.Model.Name)
+	}
+	delete(userByID, userID)
+	cacheMu.Unlock()
+}
+
+func updateIconCache(userID int64, image []byte) {
+	cacheMu.Lock()
+	if old, ok := userByID[userID]; ok {
+		e := *old
+		e.IconData = image
+		e.IconHash = fmt.Sprintf("%x", sha256.Sum256(image))
+		e.IconLoaded = true
+		userByID[userID] = &e
+	}
+	cacheMu.Unlock()
+}
+
+func getLivestreamEntry(ctx context.Context, id int64) (*livestreamCacheEntry, error) {
+	cacheMu.RLock()
+	e := livestreamByID[id]
+	cacheMu.RUnlock()
+	if e != nil {
+		return e, nil
+	}
+	if err := loadLivestreamsByIDs(ctx, []int64{id}); err != nil {
+		return nil, err
+	}
+	cacheMu.RLock()
+	e = livestreamByID[id]
+	cacheMu.RUnlock()
+	if e == nil {
+		return nil, sql.ErrNoRows
+	}
+	return e, nil
+}
+
+func loadLivestreamsByIDs(ctx context.Context, ids []int64) error {
+	if len(ids) == 0 {
+		return nil
+	}
+	wanted := make(map[int64]struct{}, len(ids))
+	cacheMu.RLock()
+	for _, id := range ids {
+		if _, ok := livestreamByID[id]; !ok {
+			wanted[id] = struct{}{}
+		}
+	}
+	cacheMu.RUnlock()
+	if len(wanted) == 0 {
+		return nil
+	}
+	missing := make([]int64, 0, len(wanted))
+	for id := range wanted {
+		missing = append(missing, id)
+	}
+
+	var models []LivestreamModel
+	q, args, err := sqlx.In("SELECT * FROM livestreams WHERE id IN (?)", missing)
+	if err != nil {
+		return err
+	}
+	if err := dbConn.SelectContext(ctx, &models, dbConn.Rebind(q), args...); err != nil {
+		return err
+	}
+
+	type tagRow struct {
+		LivestreamID int64  `db:"livestream_id"`
+		ID           int64  `db:"id"`
+		Name         string `db:"name"`
+	}
+	var tagRows []tagRow
+	q, args, err = sqlx.In(`SELECT lt.livestream_id, t.id, t.name
+		FROM livestream_tags lt INNER JOIN tags t ON t.id = lt.tag_id
+		WHERE lt.livestream_id IN (?) ORDER BY lt.id`, missing)
+	if err != nil {
+		return err
+	}
+	if err := dbConn.SelectContext(ctx, &tagRows, dbConn.Rebind(q), args...); err != nil {
+		return err
+	}
+	tagMap := make(map[int64][]Tag, len(missing))
+	tagIDMap := make(map[int64][]int64, len(missing))
+	for _, tr := range tagRows {
+		tagMap[tr.LivestreamID] = append(tagMap[tr.LivestreamID], Tag{ID: tr.ID, Name: tr.Name})
+		tagIDMap[tr.LivestreamID] = append(tagIDMap[tr.LivestreamID], tr.ID)
+	}
+
+	cacheMu.Lock()
+	for i := range models {
+		m := models[i]
+		if _, exists := livestreamByID[m.ID]; exists {
+			continue
+		}
+		livestreamByID[m.ID] = &livestreamCacheEntry{
+			Model:  m,
+			Tags:   tagMap[m.ID],
+			TagIDs: tagIDMap[m.ID],
+		}
+	}
+	cacheMu.Unlock()
+	return nil
+}
+
+func cacheNewLivestream(model LivestreamModel, tagIDs []int64) {
+	tagModels, _ := tagModelsByIDs(context.Background(), tagIDs)
+	tags := make([]Tag, 0, len(tagIDs))
+	for _, id := range tagIDs {
+		if t, ok := tagModels[id]; ok {
+			tags = append(tags, Tag{ID: t.ID, Name: t.Name})
+		}
+	}
+	cacheMu.Lock()
+	livestreamByID[model.ID] = &livestreamCacheEntry{
+		Model:  model,
+		Tags:   tags,
+		TagIDs: append([]int64(nil), tagIDs...),
+	}
+	cacheMu.Unlock()
+}
+
+func fillLivestreamResponse(ctx context.Context, id int64) (Livestream, error) {
+	ls, err := getLivestreamEntry(ctx, id)
+	if err != nil {
+		return Livestream{}, err
+	}
+	owner, err := getUserEntryByID(ctx, ls.Model.UserID)
+	if err != nil {
+		return Livestream{}, err
+	}
+	tags := make([]Tag, len(ls.Tags))
+	copy(tags, ls.Tags)
+	return Livestream{
+		ID:           ls.Model.ID,
+		Owner:        fillUserResponseFromEntry(owner),
+		Title:        ls.Model.Title,
+		Description:  ls.Model.Description,
+		PlaylistUrl:  ls.Model.PlaylistUrl,
+		ThumbnailUrl: ls.Model.ThumbnailUrl,
+		Tags:         tags,
+		StartAt:      ls.Model.StartAt,
+		EndAt:        ls.Model.EndAt,
+	}, nil
+}
+
+func getNGWordsForLivestream(ctx context.Context, livestreamID int64) ([]*NGWord, error) {
+	ngMu.RLock()
+	words, ok := ngCache[livestreamID]
+	ngMu.RUnlock()
+	if ok {
+		return words, nil
+	}
+	var loaded []*NGWord
+	if err := dbConn.SelectContext(ctx, &loaded, "SELECT * FROM ng_words WHERE livestream_id = ? ORDER BY created_at DESC, id DESC", livestreamID); err != nil {
+		return nil, err
+	}
+	ngMu.Lock()
+	if existing, ok2 := ngCache[livestreamID]; ok2 {
+		words = existing
+	} else {
+		ngCache[livestreamID] = loaded
+		words = loaded
+	}
+	ngMu.Unlock()
+	return words, nil
+}
+
+func addNGWordToCache(word *NGWord) {
+	ngMu.Lock()
+	old := ngCache[word.LivestreamID]
+	next := make([]*NGWord, 0, len(old)+1)
+	next = append(next, word)
+	for _, w := range old {
+		if w.ID != word.ID {
+			next = append(next, w)
+		}
+	}
+	ngCache[word.LivestreamID] = next
+	ngMu.Unlock()
+}
+
+func isNGWord(word string, comment string) bool {
+	// The original implementation uses SQL LIKE '%word%'. These terms are
+	// ordinary literal strings, so a substring check has the same result and
+	// avoids a database round trip for every comment.
+	return len(word) > 0 && contains(comment, word)
+}
+
+func contains(s, sub string) bool {
+	if len(sub) == 0 || len(sub) > len(s) {
+		return false
+	}
+	for i := 0; i+len(sub) <= len(s); i++ {
+		if s[i:i+len(sub)] == sub {
+			return true
+		}
+	}
+	return false
+}
+
+var _ = errors.Is
