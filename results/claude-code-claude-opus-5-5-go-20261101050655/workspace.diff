--- /dev/null
+++ b/webapp/go/state.go
@@ -0,0 +1,581 @@
+package main
+
+import (
+	"database/sql"
+	"encoding/json"
+	"sort"
+	"sync"
+	"time"
+)
+
+const (
+	initialFare     = 500
+	farePerDistance = 100
+)
+
+var mu sync.Mutex
+
+type Coupon struct {
+	Code      string
+	Discount  int
+	CreatedAt time.Time
+	UsedBy    string
+}
+
+type User struct {
+	ID             string
+	Username       string
+	Firstname      string
+	Lastname       string
+	DateOfBirth    string
+	AccessToken    string
+	InvitationCode string
+	CreatedAt      time.Time
+	PaymentToken   string
+	Rides          []*Ride // created order
+	Coupons        []*Coupon
+	notif          *Notifier
+}
+
+type Owner struct {
+	ID                 string
+	Name               string
+	AccessToken        string
+	ChairRegisterToken string
+	CreatedAt          time.Time
+	Chairs             []*Chair
+}
+
+type Chair struct {
+	ID          string
+	OwnerID     string
+	Name        string
+	Model       string
+	Speed       int
+	IsActive    bool
+	AccessToken string
+	CreatedAt   time.Time
+
+	HasLoc       bool
+	Lat, Lon     int
+	TotalDist    int
+	LocUpdatedAt time.Time
+
+	CurrentRide *Ride
+	CompletedAt time.Time
+	RideCount   int
+	EvalSum     int
+	Completed   []*Ride // completed rides (for sales)
+
+	notif *Notifier
+}
+
+type Ride struct {
+	ID         string
+	UserID     string
+	ChairID    string
+	PickupLat  int
+	PickupLon  int
+	DestLat    int
+	DestLon    int
+	Evaluation int
+	Discount   int
+	Status     string
+	CreatedAt  time.Time
+	UpdatedAt  time.Time
+	evaluating bool
+}
+
+func (r *Ride) Fare() int {
+	metered := farePerDistance * calculateDistance(r.PickupLat, r.PickupLon, r.DestLat, r.DestLon)
+	return initialFare + max(metered-r.Discount, 0)
+}
+
+func (r *Ride) Sale() int {
+	return calculateFare(r.PickupLat, r.PickupLon, r.DestLat, r.DestLon)
+}
+
+var (
+	usersByID      map[string]*User
+	usersByToken   map[string]*User
+	usersByInvCode map[string]*User
+	usernames      map[string]bool
+	invCount       map[string]int // invitation code -> number of times used
+
+	ownersByID       map[string]*Owner
+	ownersByToken    map[string]*Owner
+	ownersByRegToken map[string]*Owner
+	ownerNames       map[string]bool
+
+	chairsByID    map[string]*Chair
+	chairsByToken map[string]*Chair
+	chairList     []*Chair // id order
+
+	ridesByID map[string]*Ride
+
+	modelSpeed map[string]int
+
+	waitingRides []*Ride
+	dirtyChairs  = map[*Chair]struct{}{}
+
+	paymentGatewayURL string
+)
+
+func calculateDistance(aLatitude, aLongitude, bLatitude, bLongitude int) int {
+	return abs(aLatitude-bLatitude) + abs(aLongitude-bLongitude)
+}
+
+func abs(a int) int {
+	if a < 0 {
+		return -a
+	}
+	return a
+}
+
+func calculateFare(pickupLatitude, pickupLongitude, destLatitude, destLongitude int) int {
+	meteredFare := farePerDistance * calculateDistance(pickupLatitude, pickupLongitude, destLatitude, destLongitude)
+	return initialFare + meteredFare
+}
+
+// next unused coupon (CP_NEW2024 first, then oldest)
+func (u *User) nextCoupon() *Coupon {
+	for _, c := range u.Coupons {
+		if c.UsedBy == "" && c.Code == "CP_NEW2024" {
+			return c
+		}
+	}
+	var best *Coupon
+	for _, c := range u.Coupons {
+		if c.UsedBy != "" {
+			continue
+		}
+		if best == nil || c.CreatedAt.Before(best.CreatedAt) {
+			best = c
+		}
+	}
+	return best
+}
+
+func (u *User) latestRide() *Ride {
+	if len(u.Rides) == 0 {
+		return nil
+	}
+	return u.Rides[len(u.Rides)-1]
+}
+
+func (c *Chair) isFree() bool {
+	return c.CurrentRide == nil || c.CurrentRide.Status == "COMPLETED"
+}
+
+// ---- notification payloads ----
+
+type Coordinate struct {
+	Latitude  int `json:"latitude"`
+	Longitude int `json:"longitude"`
+}
+
+type appNotifData struct {
+	RideID                string          `json:"ride_id"`
+	PickupCoordinate      Coordinate      `json:"pickup_coordinate"`
+	DestinationCoordinate Coordinate      `json:"destination_coordinate"`
+	Fare                  int             `json:"fare"`
+	Status                string          `json:"status"`
+	Chair                 *appNotifChair  `json:"chair,omitempty"`
+	CreatedAt             int64           `json:"created_at"`
+	UpdateAt              int64           `json:"updated_at"`
+}
+
+type appNotifChair struct {
+	ID    string             `json:"id"`
+	Name  string             `json:"name"`
+	Model string             `json:"model"`
+	Stats appNotifChairStats `json:"stats"`
+}
+
+type appNotifChairStats struct {
+	TotalRidesCount    int     `json:"total_rides_count"`
+	TotalEvaluationAvg float64 `json:"total_evaluation_avg"`
+}
+
+type simpleUser struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+}
+
+type chairNotifData struct {
+	RideID                string     `json:"ride_id"`
+	User                  simpleUser `json:"user"`
+	PickupCoordinate      Coordinate `json:"pickup_coordinate"`
+	DestinationCoordinate Coordinate `json:"destination_coordinate"`
+	Status                string     `json:"status"`
+}
+
+// must hold mu
+func buildAppNotif(r *Ride) []byte {
+	d := appNotifData{
+		RideID:                r.ID,
+		PickupCoordinate:      Coordinate{r.PickupLat, r.PickupLon},
+		DestinationCoordinate: Coordinate{r.DestLat, r.DestLon},
+		Fare:                  r.Fare(),
+		Status:                r.Status,
+		CreatedAt:             r.CreatedAt.UnixMilli(),
+		UpdateAt:              r.UpdatedAt.UnixMilli(),
+	}
+	if r.ChairID != "" {
+		if c := chairsByID[r.ChairID]; c != nil {
+			st := appNotifChairStats{TotalRidesCount: c.RideCount}
+			if c.RideCount > 0 {
+				st.TotalEvaluationAvg = float64(c.EvalSum) / float64(c.RideCount)
+			}
+			d.Chair = &appNotifChair{ID: c.ID, Name: c.Name, Model: c.Model, Stats: st}
+		}
+	}
+	b, _ := json.Marshal(d)
+	return b
+}
+
+// must hold mu
+func buildChairNotif(r *Ride) []byte {
+	u := usersByID[r.UserID]
+	d := chairNotifData{
+		RideID:                r.ID,
+		PickupCoordinate:      Coordinate{r.PickupLat, r.PickupLon},
+		DestinationCoordinate: Coordinate{r.DestLat, r.DestLon},
+		Status:                r.Status,
+	}
+	if u != nil {
+		d.User = simpleUser{ID: u.ID, Name: u.Firstname + " " + u.Lastname}
+	}
+	b, _ := json.Marshal(d)
+	return b
+}
+
+// must hold mu. called after ride status changed.
+func notifyUser(r *Ride) {
+	u := usersByID[r.UserID]
+	if u == nil {
+		return
+	}
+	u.notif.push(buildAppNotif(r))
+}
+
+func notifyChair(r *Ride) {
+	c := chairsByID[r.ChairID]
+	if c == nil {
+		return
+	}
+	c.notif.push(buildChairNotif(r))
+}
+
+// ---- load from DB ----
+
+func loadAll() error {
+	mu.Lock()
+	defer mu.Unlock()
+
+	usersByID = map[string]*User{}
+	usersByToken = map[string]*User{}
+	usersByInvCode = map[string]*User{}
+	usernames = map[string]bool{}
+	invCount = map[string]int{}
+	ownersByID = map[string]*Owner{}
+	ownersByToken = map[string]*Owner{}
+	ownersByRegToken = map[string]*Owner{}
+	ownerNames = map[string]bool{}
+	chairsByID = map[string]*Chair{}
+	chairsByToken = map[string]*Chair{}
+	chairList = nil
+	ridesByID = map[string]*Ride{}
+	modelSpeed = map[string]int{}
+	waitingRides = nil
+	dirtyChairs = map[*Chair]struct{}{}
+
+	if err := db.Get(&paymentGatewayURL, "SELECT value FROM settings WHERE name = 'payment_gateway_url'"); err != nil {
+		return err
+	}
+
+	type cm struct {
+		Name  string `db:"name"`
+		Speed int    `db:"speed"`
+	}
+	var cms []cm
+	if err := db.Select(&cms, "SELECT name, speed FROM chair_models"); err != nil {
+		return err
+	}
+	for _, m := range cms {
+		modelSpeed[m.Name] = m.Speed
+	}
+
+	// users
+	{
+		rows, err := db.Query("SELECT id, username, firstname, lastname, date_of_birth, access_token, invitation_code, created_at FROM users")
+		if err != nil {
+			return err
+		}
+		for rows.Next() {
+			u := &User{notif: newNotifier()}
+			if err := rows.Scan(&u.ID, &u.Username, &u.Firstname, &u.Lastname, &u.DateOfBirth, &u.AccessToken, &u.InvitationCode, &u.CreatedAt); err != nil {
+				rows.Close()
+				return err
+			}
+			usersByID[u.ID] = u
+			usersByToken[u.AccessToken] = u
+			usersByInvCode[u.InvitationCode] = u
+			usernames[u.Username] = true
+		}
+		rows.Close()
+	}
+	{
+		rows, err := db.Query("SELECT user_id, token FROM payment_tokens")
+		if err != nil {
+			return err
+		}
+		for rows.Next() {
+			var uid, tok string
+			if err := rows.Scan(&uid, &tok); err != nil {
+				rows.Close()
+				return err
+			}
+			if u := usersByID[uid]; u != nil {
+				u.PaymentToken = tok
+			}
+		}
+		rows.Close()
+	}
+	{
+		rows, err := db.Query("SELECT user_id, code, discount, created_at, used_by FROM coupons ORDER BY created_at")
+		if err != nil {
+			return err
+		}
+		for rows.Next() {
+			var uid string
+			var usedBy sql.NullString
+			c := &Coupon{}
+			if err := rows.Scan(&uid, &c.Code, &c.Discount, &c.CreatedAt, &usedBy); err != nil {
+				rows.Close()
+				return err
+			}
+			c.UsedBy = usedBy.String
+			if u := usersByID[uid]; u != nil {
+				u.Coupons = append(u.Coupons, c)
+			}
+			if len(c.Code) > 4 && c.Code[:4] == "INV_" {
+				invCount[c.Code[4:]]++
+			}
+		}
+		rows.Close()
+	}
+	// owners
+	{
+		rows, err := db.Query("SELECT id, name, access_token, chair_register_token, created_at FROM owners")
+		if err != nil {
+			return err
+		}
+		for rows.Next() {
+			o := &Owner{}
+			if err := rows.Scan(&o.ID, &o.Name, &o.AccessToken, &o.ChairRegisterToken, &o.CreatedAt); err != nil {
+				rows.Close()
+				return err
+			}
+			ownersByID[o.ID] = o
+			ownersByToken[o.AccessToken] = o
+			ownersByRegToken[o.ChairRegisterToken] = o
+			ownerNames[o.Name] = true
+		}
+		rows.Close()
+	}
+	// chairs
+	{
+		rows, err := db.Query("SELECT id, owner_id, name, model, is_active, access_token, created_at FROM chairs ORDER BY id")
+		if err != nil {
+			return err
+		}
+		for rows.Next() {
+			c := &Chair{notif: newNotifier()}
+			if err := rows.Scan(&c.ID, &c.OwnerID, &c.Name, &c.Model, &c.IsActive, &c.AccessToken, &c.CreatedAt); err != nil {
+				rows.Close()
+				return err
+			}
+			c.Speed = modelSpeed[c.Model]
+			if c.Speed == 0 {
+				c.Speed = 1
+			}
+			chairsByID[c.ID] = c
+			chairsByToken[c.AccessToken] = c
+			chairList = append(chairList, c)
+			if o := ownersByID[c.OwnerID]; o != nil {
+				o.Chairs = append(o.Chairs, c)
+			}
+		}
+		rows.Close()
+	}
+	// chair locations
+	{
+		rows, err := db.Query("SELECT chair_id, latitude, longitude, created_at FROM chair_locations ORDER BY chair_id, created_at")
+		if err != nil {
+			return err
+		}
+		for rows.Next() {
+			var cid string
+			var lat, lon int
+			var t time.Time
+			if err := rows.Scan(&cid, &lat, &lon, &t); err != nil {
+				rows.Close()
+				return err
+			}
+			c := chairsByID[cid]
+			if c == nil {
+				continue
+			}
+			if c.HasLoc {
+				c.TotalDist += calculateDistance(c.Lat, c.Lon, lat, lon)
+			}
+			c.HasLoc = true
+			c.Lat, c.Lon = lat, lon
+			c.LocUpdatedAt = t
+		}
+		rows.Close()
+	}
+	// aggregated locations (override)
+	{
+		rows, err := db.Query("SELECT chair_id, latitude, longitude, total_distance, updated_at FROM chair_loc_agg")
+		if err != nil {
+			return err
+		}
+		for rows.Next() {
+			var cid string
+			var lat, lon, total int
+			var t time.Time
+			if err := rows.Scan(&cid, &lat, &lon, &total, &t); err != nil {
+				rows.Close()
+				return err
+			}
+			c := chairsByID[cid]
+			if c == nil {
+				continue
+			}
+			c.HasLoc = true
+			c.Lat, c.Lon = lat, lon
+			c.TotalDist = total
+			c.LocUpdatedAt = t
+		}
+		rows.Close()
+	}
+	// rides
+	{
+		rows, err := db.Query("SELECT id, user_id, chair_id, pickup_latitude, pickup_longitude, destination_latitude, destination_longitude, evaluation, created_at, updated_at FROM rides ORDER BY created_at")
+		if err != nil {
+			return err
+		}
+		for rows.Next() {
+			r := &Ride{}
+			var chairID sql.NullString
+			var eval sql.NullInt64
+			if err := rows.Scan(&r.ID, &r.UserID, &chairID, &r.PickupLat, &r.PickupLon, &r.DestLat, &r.DestLon, &eval, &r.CreatedAt, &r.UpdatedAt); err != nil {
+				rows.Close()
+				return err
+			}
+			r.ChairID = chairID.String
+			r.Evaluation = int(eval.Int64)
+			ridesByID[r.ID] = r
+			if u := usersByID[r.UserID]; u != nil {
+				u.Rides = append(u.Rides, r)
+				for _, c := range u.Coupons {
+					if c.UsedBy == r.ID {
+						r.Discount = c.Discount
+					}
+				}
+			}
+		}
+		rows.Close()
+	}
+	// ride statuses
+	type rsInfo struct {
+		carrying, arrived, completed bool
+	}
+	infos := map[string]*rsInfo{}
+	{
+		rows, err := db.Query("SELECT ride_id, status FROM ride_statuses ORDER BY created_at")
+		if err != nil {
+			return err
+		}
+		for rows.Next() {
+			var rid, st string
+			if err := rows.Scan(&rid, &st); err != nil {
+				rows.Close()
+				return err
+			}
+			r := ridesByID[rid]
+			if r == nil {
+				continue
+			}
+			r.Status = st
+			inf := infos[rid]
+			if inf == nil {
+				inf = &rsInfo{}
+				infos[rid] = inf
+			}
+			switch st {
+			case "CARRYING":
+				inf.carrying = true
+			case "ARRIVED":
+				inf.arrived = true
+			case "COMPLETED":
+				inf.completed = true
+			}
+		}
+		rows.Close()
+	}
+	// chair current ride (latest by updated_at), stats, sales
+	allRides := make([]*Ride, 0, len(ridesByID))
+	for _, r := range ridesByID {
+		allRides = append(allRides, r)
+	}
+	sort.Slice(allRides, func(i, j int) bool {
+		if allRides[i].UpdatedAt.Equal(allRides[j].UpdatedAt) {
+			return allRides[i].CreatedAt.Before(allRides[j].CreatedAt)
+		}
+		return allRides[i].UpdatedAt.Before(allRides[j].UpdatedAt)
+	})
+	for _, r := range allRides {
+		if r.Status == "" {
+			r.Status = "MATCHING"
+		}
+		if r.ChairID == "" {
+			if r.Status == "MATCHING" {
+				waitingRides = append(waitingRides, r)
+			}
+			continue
+		}
+		c := chairsByID[r.ChairID]
+		if c == nil {
+			continue
+		}
+		// prefer a non-completed ride as current
+		if c.CurrentRide == nil || c.CurrentRide.Status == "COMPLETED" || r.Status != "COMPLETED" {
+			c.CurrentRide = r
+		}
+		inf := infos[r.ID]
+		if r.Status == "COMPLETED" {
+			c.Completed = append(c.Completed, r)
+			if inf != nil && inf.carrying && inf.arrived && inf.completed {
+				c.RideCount++
+				c.EvalSum += r.Evaluation
+			}
+		}
+	}
+	sort.Slice(waitingRides, func(i, j int) bool { return waitingRides[i].CreatedAt.Before(waitingRides[j].CreatedAt) })
+
+	// last notifications
+	for _, u := range usersByID {
+		if r := u.latestRide(); r != nil {
+			u.notif.last = buildAppNotif(r)
+		}
+	}
+	for _, c := range chairList {
+		if c.CurrentRide != nil {
+			c.notif.last = buildChairNotif(c.CurrentRide)
+		}
+	}
+	return nil
+}
