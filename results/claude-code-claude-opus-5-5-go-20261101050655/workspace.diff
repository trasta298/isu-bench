+type appPostRidesEstimatedFareResponse struct {
+	Fare     int `json:"fare"`
+	Discount int `json:"discount"`
+}
+
+func appPostRidesEstimatedFare(w http.ResponseWriter, r *http.Request, user *User) {
+	req := &appPostRidesRequest{}
+	if err := bindJSON(r, req); err != nil {
+		writeError(w, http.StatusBadRequest, err)
+		return
+	}
+	if req.PickupCoordinate == nil || req.DestinationCoordinate == nil {
+		writeError(w, http.StatusBadRequest, errors.New("required fields(pickup_coordinate, destination_coordinate) are empty"))
+		return
+	}
+	discount := 0
+	mu.Lock()
+	if c := user.nextCoupon(); c != nil {
+		discount = c.Discount
+	}
+	mu.Unlock()
+	full := calculateFare(req.PickupCoordinate.Latitude, req.PickupCoordinate.Longitude, req.DestinationCoordinate.Latitude, req.DestinationCoordinate.Longitude)
+	metered := full - initialFare
+	discounted := initialFare + max(metered-discount, 0)
+	writeJSON(w, http.StatusOK, &appPostRidesEstimatedFareResponse{Fare: discounted, Discount: full - discounted})
+}
