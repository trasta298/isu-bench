diff --git a/webapp/go/matcher.go b/webapp/go/matcher.go
new file mode 100644
index 0000000..78e1e26
--- /dev/null
+++ b/webapp/go/matcher.go
@@ -0,0 +1,135 @@
+package main
+
+import (
+	"os"
+	"sort"
+	"strconv"
+	"time"
+)
+
+func matcherLoop() {
+	interval := 50 * time.Millisecond
+	if v := os.Getenv("MATCH_INTERVAL_MS"); v != "" {
+		if n, err := strconv.Atoi(v); err == nil && n > 0 {
+			interval = time.Duration(n) * time.Millisecond
+		}
+	}
+	t := time.NewTicker(interval)
+	for range t.C {
+		runMatching()
+	}
+}
+
+type pair struct {
+	ri, ci int
+	cost   float64
+}
+
+const noLocDist = 400
+
+func chairCost(c *Chair, r *Ride) float64 {
+	d := noLocDist
+	if c.HasLoc {
+		d = calculateDistance(c.Lat, c.Lon, r.PickupLat, r.PickupLon)
+	}
+	return float64(d) / float64(c.Speed)
+}
+
+func runMatching() {
+	mu.Lock()
+	defer mu.Unlock()
+
+	// clean waiting list
+	rides := waitingRides[:0]
+	for _, r := range waitingRides {
+		if r.ChairID == "" && r.Status == "MATCHING" {
+			rides = append(rides, r)
+		}
+	}
+	waitingRides = rides
+	if len(rides) == 0 {
+		return
+	}
+	var chairs []*Chair
+	for _, c := range chairList {
+		if c.IsActive && c.isFree() {
+			chairs = append(chairs, c)
+		}
+	}
+	if len(chairs) == 0 {
+		return
+	}
+	now := nowMicro()
+	rideUsed := make([]bool, len(rides))
+	chairUsed := make([]bool, len(chairs))
+
+	assign := func(ri, ci int) {
+		r := rides[ri]
+		c := chairs[ci]
+		rideUsed[ri] = true
+		chairUsed[ci] = true
+		r.ChairID = c.ID
+		r.UpdatedAt = now
+		c.CurrentRide = r
+		enqueue("UPDATE rides SET chair_id = ?, updated_at = ? WHERE id = ?", c.ID, now, r.ID)
+		notifyChair(r)
+	}
+
+	// starving rides first (oldest first)
+	for ri, r := range rides {
+		if now.Sub(r.CreatedAt) < 20*time.Second {
+			break
+		}
+		best := -1
+		bestCost := 0.0
+		for ci, c := range chairs {
+			if chairUsed[ci] {
+				continue
+			}
+			cost := chairCost(c, r)
+			if best < 0 || cost < bestCost {
+				best, bestCost = ci, cost
+			}
+		}
+		if best < 0 {
+			break
+		}
+		assign(ri, best)
+	}
+
+	pairs := make([]pair, 0, len(rides)*len(chairs))
+	for ri, r := range rides {
+		if rideUsed[ri] {
+			continue
+		}
+		radius := 100 + int(50*now.Sub(r.CreatedAt).Seconds())
+		for ci, c := range chairs {
+			if chairUsed[ci] {
+				continue
+			}
+			d := noLocDist
+			if c.HasLoc {
+				d = calculateDistance(c.Lat, c.Lon, r.PickupLat, r.PickupLon)
+			}
+			if d > radius {
+				continue
+			}
+			pairs = append(pairs, pair{ri, ci, float64(d) / float64(c.Speed)})
+		}
+	}
+	sort.Slice(pairs, func(i, j int) bool { return pairs[i].cost < pairs[j].cost })
+	for _, p := range pairs {
+		if rideUsed[p.ri] || chairUsed[p.ci] {
+			continue
+		}
+		assign(p.ri, p.ci)
+	}
+
+	rest := waitingRides[:0]
+	for i, r := range rides {
+		if !rideUsed[i] {
+			rest = append(rest, r)
+		}
+	}
+	waitingRides = rest
+}
