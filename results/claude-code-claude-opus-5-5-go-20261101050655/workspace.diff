+type appPostRideEvaluationRequest struct {
+	Evaluation int `json:"evaluation"`
+}
+
+type appPostRideEvaluationResponse struct {
+	CompletedAt int64 `json:"completed_at"`
+}
+
+func appPostRideEvaluation(w http.ResponseWriter, r *http.Request, user *User) {
+	rideID := r.PathValue("ride_id")
+	req := &appPostRideEvaluationRequest{}
+	if err := bindJSON(r, req); err != nil {
+		writeError(w, http.StatusBadRequest, err)
+		return
+	}
+	if req.Evaluation < 1 || req.Evaluation > 5 {
+		writeError(w, http.StatusBadRequest, errors.New("evaluation must be between 1 and 5"))
+		return
+	}
+
+	mu.Lock()
+	ride := ridesByID[rideID]
+	if ride == nil {
+		mu.Unlock()
+		writeError(w, http.StatusNotFound, errors.New("ride not found"))
+		return
+	}
+	if ride.Status != "ARRIVED" || ride.evaluating {
+		mu.Unlock()
+		writeError(w, http.StatusBadRequest, errors.New("not arrived yet"))
+		return
+	}
+	owner := usersByID[ride.UserID]
+	token := ""
+	if owner != nil {
+		token = owner.PaymentToken
+	}
+	if token == "" {
+		mu.Unlock()
+		writeError(w, http.StatusBadRequest, errors.New("payment token not registered"))
+		return
+	}
+	fare := ride.Fare()
+	ride.evaluating = true
+	url := paymentGatewayURL
+	mu.Unlock()
+
+	paymentWG.Add(1)
+	err := requestPayment(nil, url, token, fare, ride.ID)
+	paymentWG.Done()
+	if err != nil {
+		mu.Lock()
+		ride.evaluating = false
+		mu.Unlock()
+		writeError(w, http.StatusBadGateway, err)
+		return
+	}
+
+	now := nowMicro()
+	mu.Lock()
+	ride.evaluating = false
+	ride.Evaluation = req.Evaluation
+	ride.Status = "COMPLETED"
+	ride.UpdatedAt = now
+	if c := chairsByID[ride.ChairID]; c != nil {
+		c.RideCount++
+		c.CompletedAt = time.Now()
+		c.EvalSum += req.Evaluation
+		c.Completed = append(c.Completed, ride)
+	}
+	enqueue("UPDATE rides SET evaluation = ?, updated_at = ? WHERE id = ?", req.Evaluation, now, ride.ID)
+	enqueue("INSERT INTO ride_statuses (id, ride_id, status, created_at) VALUES (?, ?, ?, ?)", ulid.Make().String(), ride.ID, "COMPLETED", now)
+	notifyUser(ride)
+	notifyChair(ride)
+	mu.Unlock()
+
+	writeJSON(w, http.StatusOK, &appPostRideEvaluationResponse{CompletedAt: now.UnixMilli()})
+}
