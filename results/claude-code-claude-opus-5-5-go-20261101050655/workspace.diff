+++ b/webapp/go/infra.go
@@ -0,0 +1,331 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"log"
+	"net/http"
+	"strings"
+	"time"
+)
+
+// ---------------- Notifier (SSE) ----------------
+
+type Notifier struct {
+	pending [][]byte
+	last    []byte
+	ch      chan struct{}
+}
+
+func newNotifier() *Notifier { return &Notifier{} }
+
+// must hold mu
+func (n *Notifier) push(b []byte) {
+	n.pending = append(n.pending, b)
+	n.last = b
+	if n.ch != nil {
+		select {
+		case n.ch <- struct{}{}:
+		default:
+		}
+	}
+}
+
+func serveSSE(w http.ResponseWriter, r *http.Request, n *Notifier) {
+	flusher, _ := w.(http.Flusher)
+	h := w.Header()
+	h.Set("Content-Type", "text/event-stream")
+	h.Set("Cache-Control", "no-cache")
+	h.Set("X-Accel-Buffering", "no")
+	w.WriteHeader(http.StatusOK)
+
+	mu.Lock()
+	if n.ch != nil {
+		close(n.ch)
+	}
+	myCh := make(chan struct{}, 1)
+	n.ch = myCh
+	var msgs [][]byte
+	if len(n.pending) > 0 {
+		msgs = n.pending
+		n.pending = nil
+	} else if n.last != nil {
+		msgs = [][]byte{n.last}
+	}
+	mu.Unlock()
+
+	var buf bytes.Buffer
+	write := func(msgs [][]byte) error {
+		if len(msgs) == 0 {
+			return nil
+		}
+		buf.Reset()
+		for _, m := range msgs {
+			buf.WriteString("data: ")
+			buf.Write(m)
+			buf.WriteString("\n\n")
+		}
+		if _, err := w.Write(buf.Bytes()); err != nil {
+			return err
+		}
+		if flusher != nil {
+			flusher.Flush()
+		}
+		return nil
+	}
+	if err := write(msgs); err != nil {
+		requeue(n, myCh, msgs)
+		return
+	}
+	if flusher != nil && len(msgs) == 0 {
+		flusher.Flush()
+	}
+	ctx := r.Context()
+	for {
+		select {
+		case _, ok := <-myCh:
+			if !ok {
+				return
+			}
+			mu.Lock()
+			msgs = n.pending
+			n.pending = nil
+			mu.Unlock()
+			if err := write(msgs); err != nil {
+				requeue(n, myCh, msgs)
+				return
+			}
+		case <-ctx.Done():
+			mu.Lock()
+			if n.ch == myCh {
+				n.ch = nil
+			}
+			mu.Unlock()
+			return
+		}
+	}
+}
+
+func requeue(n *Notifier, myCh chan struct{}, msgs [][]byte) {
+	mu.Lock()
+	n.pending = append(append([][]byte{}, msgs...), n.pending...)
+	if n.ch == myCh {
+		n.ch = nil
+	}
+	mu.Unlock()
+}
+
+// ---------------- async DB writer ----------------
+
+type dbOp struct {
+	query string
+	args  []any
+	loc   *locRow
+	done  chan struct{}
+}
+
+type locRow struct {
+	id       string
+	chairID  string
+	lat, lon int
+	t        time.Time
+}
+
+var writeCh = make(chan dbOp, 1000000)
+
+func enqueue(query string, args ...any) {
+	writeCh <- dbOp{query: query, args: args}
+}
+
+func enqueueLoc(l *locRow) {
+	writeCh <- dbOp{loc: l}
+}
+
+func flushWriter() {
+	done := make(chan struct{})
+	writeCh <- dbOp{done: done}
+	<-done
+}
+
+func dbWriter() {
+	for {
+		o := <-writeCh
+		batch := []dbOp{o}
+	drain:
+		for len(batch) < 2000 {
+			select {
+			case o2 := <-writeCh:
+				batch = append(batch, o2)
+			default:
+				break drain
+			}
+		}
+		execBatch(batch)
+	}
+}
+
+func execBatch(batch []dbOp) {
+	var locs []*locRow
+	var dones []chan struct{}
+	tx, err := db.Begin()
+	if err != nil {
+		log.Printf("writer begin: %v", err)
+		time.Sleep(100 * time.Millisecond)
+		// retry without tx
+	}
+	for _, o := range batch {
+		if o.done != nil {
+			dones = append(dones, o.done)
+			continue
+		}
+		if o.loc != nil {
+			locs = append(locs, o.loc)
+			continue
+		}
+		var e error
+		if tx != nil {
+			_, e = tx.Exec(o.query, o.args...)
+		} else {
+			_, e = db.Exec(o.query, o.args...)
+		}
+		if e != nil {
+			log.Printf("writer exec %q: %v", o.query, e)
+		}
+	}
+	for i := 0; i < len(locs); i += 500 {
+		end := min(i+500, len(locs))
+		var sb strings.Builder
+		sb.WriteString("INSERT INTO chair_locations (id, chair_id, latitude, longitude, created_at) VALUES ")
+		args := make([]any, 0, (end-i)*5)
+		for j := i; j < end; j++ {
+			if j > i {
+				sb.WriteString(",")
+			}
+			sb.WriteString("(?,?,?,?,?)")
+			l := locs[j]
+			args = append(args, l.id, l.chairID, l.lat, l.lon, l.t)
+		}
+		var e error
+		if tx != nil {
+			_, e = tx.Exec(sb.String(), args...)
+		} else {
+			_, e = db.Exec(sb.String(), args...)
+		}
+		if e != nil {
+			log.Printf("writer loc insert: %v", e)
+		}
+	}
+	if tx != nil {
+		if err := tx.Commit(); err != nil {
+			log.Printf("writer commit: %v", err)
+		}
+	}
+	for _, d := range dones {
+		close(d)
+	}
+}
+
+// ---------------- payment ----------------
+
+var paymentClient = &http.Client{
+	Timeout: 5 * time.Second,
+	Transport: &http.Transport{
+		MaxIdleConns:        200,
+		MaxIdleConnsPerHost: 200,
+		IdleConnTimeout:     60 * time.Second,
+	},
+}
+
+func requestPayment(ctx context.Context, url, token string, amount int, key string) error {
+	b, _ := json.Marshal(map[string]int{"amount": amount})
+	deadline := time.Now().Add(9 * time.Second)
+	var lastErr error
+	for i := 0; ; i++ {
+		err := func() error {
+			req, err := http.NewRequest(http.MethodPost, url+"/payments", bytes.NewReader(b))
+			if err != nil {
+				return err
+			}
+			req.Header.Set("Content-Type", "application/json")
+			req.Header.Set("Authorization", "Bearer "+token)
+			req.Header.Set("Idempotency-Key", key)
+			res, err := paymentClient.Do(req)
+			if err != nil {
+				statMu.Lock()
+				payStatus[-1]++
+				statMu.Unlock()
+				return err
+			}
+			defer res.Body.Close()
+			var sink [512]byte
+			for {
+				if _, e := res.Body.Read(sink[:]); e != nil {
+					break
+				}
+			}
+			statMu.Lock()
+			payStatus[res.StatusCode]++
+			statMu.Unlock()
+			if res.StatusCode == http.StatusNoContent {
+				return nil
+			}
+			return fmt.Errorf("payment status %d", res.StatusCode)
+		}()
+		if err == nil {
+			return nil
+		}
+		lastErr = err
+		if time.Now().After(deadline) {
+			return lastErr
+		}
+		sleep := time.Duration(5*(i+1)) * time.Millisecond
+		if sleep > 50*time.Millisecond {
+			sleep = 50 * time.Millisecond
+		}
+		time.Sleep(sleep)
+	}
+}
+
+// periodically persist aggregated chair locations
+func locFlusher() {
+	for range time.Tick(time.Second) {
+		flushLocs()
+	}
+}
+
+func flushLocs() {
+	mu.Lock()
+	if len(dirtyChairs) == 0 {
+		mu.Unlock()
+		return
+	}
+	type row struct {
+		id              string
+		lat, lon, total int
+		t               time.Time
+	}
+	rows := make([]row, 0, len(dirtyChairs))
+	for c := range dirtyChairs {
+		rows = append(rows, row{c.ID, c.Lat, c.Lon, c.TotalDist, c.LocUpdatedAt})
+	}
+	dirtyChairs = map[*Chair]struct{}{}
+	for i := 0; i < len(rows); i += 500 {
+		end := min(i+500, len(rows))
+		var sb strings.Builder
+		sb.WriteString("INSERT INTO chair_loc_agg (chair_id, latitude, longitude, total_distance, updated_at) VALUES ")
+		args := make([]any, 0, (end-i)*5)
+		for j := i; j < end; j++ {
+			if j > i {
+				sb.WriteString(",")
+			}
+			sb.WriteString("(?,?,?,?,?)")
+			r := rows[j]
+			args = append(args, r.id, r.lat, r.lon, r.total, r.t)
+		}
+		sb.WriteString(" ON DUPLICATE KEY UPDATE latitude=VALUES(latitude), longitude=VALUES(longitude), total_distance=VALUES(total_distance), updated_at=VALUES(updated_at)")
+		enqueue(sb.String(), args...)
+	}
+	mu.Unlock()
+}
