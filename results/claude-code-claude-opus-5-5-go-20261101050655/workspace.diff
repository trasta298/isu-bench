+	owner := ownersByRegToken[req.ChairRegisterToken]
+	if owner == nil {
+		mu.Unlock()
+		writeError(w, http.StatusUnauthorized, errors.New("invalid chair_register_token"))
+		return
+	}
+	speed := modelSpeed[req.Model]
+	if speed == 0 {
+		speed = 1
+	}
+	c := &Chair{
+		ID: chairID, OwnerID: owner.ID, Name: req.Name, Model: req.Model, Speed: speed,
+		AccessToken: accessToken, CreatedAt: now, notif: newNotifier(),
