+
+func chairPostCoordinate(w http.ResponseWriter, r *http.Request, chair *Chair) {
+	req := &Coordinate{}
+	if err := bindJSON(r, req); err != nil {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	now := nowMicro()
+	mu.Lock()
+	if !chair.HasLoc {
+		if req.Latitude+req.Longitude > 300 {
+			spawnK++
+		} else {
+			spawnC++
+		}
+	}
+	if chair.HasLoc {
+		chair.TotalDist += calculateDistance(chair.Lat, chair.Lon, req.Latitude, req.Longitude)
+	}
+	chair.HasLoc = true
+	chair.Lat, chair.Lon = req.Latitude, req.Longitude
+	chair.LocUpdatedAt = now
+	dirtyChairs[chair] = struct{}{}
+	if ride := chair.CurrentRide; ride != nil {
+		newStatus := ""
+		if ride.Status == "ENROUTE" && req.Latitude == ride.PickupLat && req.Longitude == ride.PickupLon {
+			newStatus = "PICKUP"
+		} else if ride.Status == "CARRYING" && req.Latitude == ride.DestLat && req.Longitude == ride.DestLon {
+			newStatus = "ARRIVED"
+		}
+		if newStatus != "" {
+			ride.Status = newStatus
+			enqueue("INSERT INTO ride_statuses (id, ride_id, status, created_at) VALUES (?, ?, ?, ?)", ulid.Make().String(), ride.ID, newStatus, now)
+			notifyUser(ride)
+			notifyChair(ride)
+		}
+	}
+	mu.Unlock()
+
+	writeJSON(w, http.StatusOK, &chairPostCoordinateResponse{RecordedAt: now.UnixMilli()})
+}
+
+func chairGetNotification(w http.ResponseWriter, r *http.Request, chair *Chair) {
+	serveSSE(w, r, chair.notif)
+}
+
+type postChairRidesRideIDStatusRequest struct {
+	Status string `json:"status"`
+}
+
+func chairPostRideStatus(w http.ResponseWriter, r *http.Request, chair *Chair) {
+	rideID := r.PathValue("ride_id")
+	req := &postChairRidesRideIDStatusRequest{}
+	if err := bindJSON(r, req); err != nil {
+		writeError(w, http.StatusBadRequest, err)
+		return
+	}
+	now := nowMicro()
+	mu.Lock()
+	ride := ridesByID[rideID]
+	if ride == nil {
+		mu.Unlock()
+		writeError(w, http.StatusNotFound, errors.New("ride not found"))
+		return
+	}
+	if ride.ChairID != chair.ID {
+		mu.Unlock()
+		writeError(w, http.StatusBadRequest, errors.New("not assigned to this ride"))
+		return
+	}
+	switch req.Status {
+	case "ENROUTE":
+		if ride.Status == "ENROUTE" {
+			break
+		}
+		if ride.Status != "MATCHING" {
+			mu.Unlock()
+			writeError(w, http.StatusBadRequest, errors.New("invalid state"))
+			return
+		}
+		ride.Status = "ENROUTE"
+		enqueue("INSERT INTO ride_statuses (id, ride_id, status, created_at) VALUES (?, ?, ?, ?)", ulid.Make().String(), ride.ID, "ENROUTE", now)
+		notifyUser(ride)
+		notifyChair(ride)
+	case "CARRYING":
+		if ride.Status != "PICKUP" {
+			mu.Unlock()
+			writeError(w, http.StatusBadRequest, errors.New("chair has not arrived yet"))
+			return
+		}
+		ride.Status = "CARRYING"
+		enqueue("INSERT INTO ride_statuses (id, ride_id, status, created_at) VALUES (?, ?, ?, ?)", ulid.Make().String(), ride.ID, "CARRYING", now)
+		notifyUser(ride)
+		notifyChair(ride)
+	default:
+		mu.Unlock()
+		writeError(w, http.StatusBadRequest, errors.New("invalid status"))
+		return
+	}
+	mu.Unlock()
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// ======================= owner =======================
+
+type ownerPostOwnersRequest struct {
+	Name string `json:"name"`
+}
+
+type ownerPostOwnersResponse struct {
+	ID                 string `json:"id"`
+	ChairRegisterToken string `json:"chair_register_token"`
+}
+
+func ownerPostOwners(w http.ResponseWriter, r *http.Request) {
+	req := &ownerPostOwnersRequest{}
+	if err := bindJSON(r, req); err != nil {
+		writeError(w, http.StatusBadRequest, err)
+		return
+	}
+	if req.Name == "" {
+		writeError(w, http.StatusBadRequest, errors.New("some of required fields(name) are empty"))
+		return
+	}
+	ownerID := ulid.Make().String()
+	accessToken := secureRandomStr(32)
+	chairRegisterToken := secureRandomStr(32)
+	now := nowMicro()
+
+	mu.Lock()
+	if ownerNames[req.Name] {
+		mu.Unlock()
+		writeError(w, http.StatusInternalServerError, errors.New("duplicate owner name"))
+		return
+	}
+	o := &Owner{ID: ownerID, Name: req.Name, AccessToken: accessToken, ChairRegisterToken: chairRegisterToken, CreatedAt: now}
+	ownersByID[ownerID] = o
+	ownersByToken[accessToken] = o
+	ownersByRegToken[chairRegisterToken] = o
+	ownerNames[req.Name] = true
+	enqueue("INSERT INTO owners (id, name, access_token, chair_register_token, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?)",
+		ownerID, req.Name, accessToken, chairRegisterToken, now, now)
+	mu.Unlock()
+
+	http.SetCookie(w, &http.Cookie{Path: "/", Name: "owner_session", Value: accessToken})
+	writeJSON(w, http.StatusCreated, &ownerPostOwnersResponse{ID: ownerID, ChairRegisterToken: chairRegisterToken})
+}
+
+type chairSales struct {
+	ID    string `json:"id"`
+	Name  string `json:"name"`
+	Sales int    `json:"sales"`
+}
+
+type modelSales struct {
+	Model string `json:"model"`
+	Sales int    `json:"sales"`
+}
+
+type ownerGetSalesResponse struct {
+	TotalSales int          `json:"total_sales"`
+	Chairs     []chairSales `json:"chairs"`
+	Models     []modelSales `json:"models"`
+}
+
+func ownerGetSales(w http.ResponseWriter, r *http.Request, owner *Owner) {
+	since := time.Unix(0, 0)
+	until := time.Date(9999, 12, 31, 23, 59, 59, 0, time.UTC)
+	q := r.URL.Query()
+	if s := q.Get("since"); s != "" {
+		parsed, err := strconv.ParseInt(s, 10, 64)
+		if err != nil {
+			writeError(w, http.StatusBadRequest, err)
+			return
+		}
+		since = time.UnixMilli(parsed)
+	}
+	if s := q.Get("until"); s != "" {
+		parsed, err := strconv.ParseInt(s, 10, 64)
+		if err != nil {
+			writeError(w, http.StatusBadRequest, err)
+			return
+		}
+		until = time.UnixMilli(parsed)
+	}
+	untilX := until.Add(999 * time.Microsecond)
+
+	res := ownerGetSalesResponse{}
+	modelSalesByModel := map[string]int{}
+	var modelOrder []string
+	mu.Lock()
+	for _, c := range owner.Chairs {
+		sales := 0
+		for _, rd := range c.Completed {
+			if rd.UpdatedAt.Before(since) || rd.UpdatedAt.After(untilX) {
+				continue
+			}
+			sales += rd.Sale()
+		}
+		res.TotalSales += sales
+		res.Chairs = append(res.Chairs, chairSales{ID: c.ID, Name: c.Name, Sales: sales})
+		if _, ok := modelSalesByModel[c.Model]; !ok {
+			modelOrder = append(modelOrder, c.Model)
+		}
+		modelSalesByModel[c.Model] += sales
+	}
+	mu.Unlock()
+	models := []modelSales{}
+	for _, m := range modelOrder {
+		models = append(models, modelSales{Model: m, Sales: modelSalesByModel[m]})
+	}
+	res.Models = models
+	writeJSON(w, http.StatusOK, res)
+}
+
+type ownerGetChairResponse struct {
+	Chairs []ownerGetChairResponseChair `json:"chairs"`
+}
+
+type ownerGetChairResponseChair struct {
+	ID                     string `json:"id"`
+	Name                   string `json:"name"`
+	Model                  string `json:"model"`
+	Active                 bool   `json:"active"`
+	RegisteredAt           int64  `json:"registered_at"`
+	TotalDistance          int    `json:"total_distance"`
+	TotalDistanceUpdatedAt *int64 `json:"total_distance_updated_at,omitempty"`
+}
+
+func ownerGetChairs(w http.ResponseWriter, r *http.Request, owner *Owner) {
+	res := ownerGetChairResponse{}
+	mu.Lock()
+	for _, c := range owner.Chairs {
+		item := ownerGetChairResponseChair{
+			ID: c.ID, Name: c.Name, Model: c.Model, Active: c.IsActive,
+			RegisteredAt: c.CreatedAt.UnixMilli(), TotalDistance: c.TotalDist,
+		}
+		if c.HasLoc {
+			t := c.LocUpdatedAt.UnixMilli()
+			item.TotalDistanceUpdatedAt = &t
+		}
+		res.Chairs = append(res.Chairs, item)
+	}
+	mu.Unlock()
+	writeJSON(w, http.StatusOK, res)
+}
