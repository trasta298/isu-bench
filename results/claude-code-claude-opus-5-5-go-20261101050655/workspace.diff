+type appPostUsersRequest struct {
+	Username       string  `json:"username"`
+	FirstName      string  `json:"firstname"`
+	LastName       string  `json:"lastname"`
+	DateOfBirth    string  `json:"date_of_birth"`
+	InvitationCode *string `json:"invitation_code"`
+}
+
+type appPostUsersResponse struct {
+	ID             string `json:"id"`
+	InvitationCode string `json:"invitation_code"`
+}
+
+func appPostUsers(w http.ResponseWriter, r *http.Request) {
+	req := &appPostUsersRequest{}
+	if err := bindJSON(r, req); err != nil {
+		writeError(w, http.StatusBadRequest, err)
+		return
+	}
+	if req.Username == "" || req.FirstName == "" || req.LastName == "" || req.DateOfBirth == "" {
+		writeError(w, http.StatusBadRequest, errors.New("required fields(username, firstname, lastname, date_of_birth) are empty"))
+		return
+	}
+	userID := ulid.Make().String()
+	accessToken := secureRandomStr(32)
+	invitationCode := secureRandomStr(15)
+	now := nowMicro()
+
+	mu.Lock()
+	var inviter *User
+	inv := ""
+	if req.InvitationCode != nil && *req.InvitationCode != "" {
+		inv = *req.InvitationCode
+		if invCount[inv] >= 3 {
+			mu.Unlock()
+			writeError(w, http.StatusBadRequest, errors.New("この招待コードは使用できません。"))
+			return
+		}
+		inviter = usersByInvCode[inv]
+		if inviter == nil {
+			mu.Unlock()
+			writeError(w, http.StatusBadRequest, errors.New("この招待コードは使用できません。"))
+			return
+		}
+	}
+	u := &User{
+		ID: userID, Username: req.Username, Firstname: req.FirstName, Lastname: req.LastName,
+		DateOfBirth: req.DateOfBirth, AccessToken: accessToken, InvitationCode: invitationCode,
+		CreatedAt: now, notif: newNotifier(),
+	}
+	usersByID[userID] = u
+	usersByToken[accessToken] = u
+	usersByInvCode[invitationCode] = u
+	usernames[req.Username] = true
+	enqueue("INSERT INTO users (id, username, firstname, lastname, date_of_birth, access_token, invitation_code, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
+		userID, req.Username, req.FirstName, req.LastName, req.DateOfBirth, accessToken, invitationCode, now, now)
+	u.Coupons = append(u.Coupons, &Coupon{Code: "CP_NEW2024", Discount: 3000, CreatedAt: now})
+	enqueue("INSERT INTO coupons (user_id, code, discount, created_at) VALUES (?, ?, ?, ?)", userID, "CP_NEW2024", 3000, now)
+	if inviter != nil {
+		invCount[inv]++
+		u.Coupons = append(u.Coupons, &Coupon{Code: "INV_" + inv, Discount: 1500, CreatedAt: now})
+		enqueue("INSERT INTO coupons (user_id, code, discount, created_at) VALUES (?, ?, ?, ?)", userID, "INV_"+inv, 1500, now)
+		code := "RWD_" + inv + "_" + strconv.FormatInt(now.UnixMilli(), 10)
+		inviter.Coupons = append(inviter.Coupons, &Coupon{Code: code, Discount: 1000, CreatedAt: now})
+		enqueue("INSERT INTO coupons (user_id, code, discount, created_at) VALUES (?, ?, ?, ?)", inviter.ID, code, 1000, now)
+	}
+	mu.Unlock()
+
+	http.SetCookie(w, &http.Cookie{Path: "/", Name: "app_session", Value: accessToken})
+	writeJSON(w, http.StatusCreated, &appPostUsersResponse{ID: userID, InvitationCode: invitationCode})
+}
