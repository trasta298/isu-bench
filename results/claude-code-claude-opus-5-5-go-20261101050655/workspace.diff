+func appGetRides(w http.ResponseWriter, r *http.Request, user *User) {
+	items := []getAppRidesResponseItem{}
+	mu.Lock()
+	for i := len(user.Rides) - 1; i >= 0; i-- {
+		ride := user.Rides[i]
+		if ride.Status != "COMPLETED" {
+			continue
+		}
+		item := getAppRidesResponseItem{
+			ID:                    ride.ID,
+			PickupCoordinate:      Coordinate{ride.PickupLat, ride.PickupLon},
+			DestinationCoordinate: Coordinate{ride.DestLat, ride.DestLon},
+			Fare:                  ride.Fare(),
+			Evaluation:            ride.Evaluation,
+			RequestedAt:           ride.CreatedAt.UnixMilli(),
+			CompletedAt:           ride.UpdatedAt.UnixMilli(),
+		}
+		if c := chairsByID[ride.ChairID]; c != nil {
+			item.Chair.ID = c.ID
+			item.Chair.Name = c.Name
+			item.Chair.Model = c.Model
+			if o := ownersByID[c.OwnerID]; o != nil {
+				item.Chair.Owner = o.Name
+			}
+		}
+		items = append(items, item)
+	}
+	mu.Unlock()
+	writeJSON(w, http.StatusOK, &getAppRidesResponse{Rides: items})
