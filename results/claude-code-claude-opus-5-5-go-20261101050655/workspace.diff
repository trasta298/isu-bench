+type appPostRidesRequest struct {
+	PickupCoordinate      *Coordinate `json:"pickup_coordinate"`
+	DestinationCoordinate *Coordinate `json:"destination_coordinate"`
+}
+
+type appPostRidesResponse struct {
+	RideID string `json:"ride_id"`
+	Fare   int    `json:"fare"`
+}
+
+func appPostRides(w http.ResponseWriter, r *http.Request, user *User) {
+	req := &appPostRidesRequest{}
+	if err := bindJSON(r, req); err != nil {
+		writeError(w, http.StatusBadRequest, err)
+		return
+	}
+	if req.PickupCoordinate == nil || req.DestinationCoordinate == nil {
+		writeError(w, http.StatusBadRequest, errors.New("required fields(pickup_coordinate, destination_coordinate) are empty"))
+		return
+	}
+	rideID := ulid.Make().String()
+	statusID := ulid.Make().String()
+	now := nowMicro()
+
+	mu.Lock()
+	for _, rd := range user.Rides {
+		if rd.Status != "COMPLETED" {
+			mu.Unlock()
+			writeError(w, http.StatusConflict, errors.New("ride already exists"))
+			return
+		}
+	}
+	ride := &Ride{
+		ID: rideID, UserID: user.ID,
+		PickupLat: req.PickupCoordinate.Latitude, PickupLon: req.PickupCoordinate.Longitude,
+		DestLat: req.DestinationCoordinate.Latitude, DestLon: req.DestinationCoordinate.Longitude,
+		Status: "MATCHING", CreatedAt: now, UpdatedAt: now,
+	}
+	var coupon *Coupon
+	if len(user.Rides) == 0 {
+		coupon = user.nextCoupon()
+	} else {
+		for _, c := range user.Coupons {
+			if c.UsedBy != "" {
+				continue
+			}
+			if coupon == nil || c.CreatedAt.Before(coupon.CreatedAt) {
+				coupon = c
+			}
+		}
+	}
+	user.Rides = append(user.Rides, ride)
+	ridesByID[rideID] = ride
+	enqueue("INSERT INTO rides (id, user_id, pickup_latitude, pickup_longitude, destination_latitude, destination_longitude, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+		rideID, user.ID, ride.PickupLat, ride.PickupLon, ride.DestLat, ride.DestLon, now, now)
+	enqueue("INSERT INTO ride_statuses (id, ride_id, status, created_at) VALUES (?, ?, ?, ?)", statusID, rideID, "MATCHING", now)
+	if coupon != nil {
+		coupon.UsedBy = rideID
+		ride.Discount = coupon.Discount
+		enqueue("UPDATE coupons SET used_by = ? WHERE user_id = ? AND code = ?", rideID, user.ID, coupon.Code)
+	}
+	fare := ride.Fare()
+	notifyUser(ride)
+	waitingRides = append(waitingRides, ride)
+	mu.Unlock()
+
+	writeJSON(w, http.StatusAccepted, &appPostRidesResponse{RideID: rideID, Fare: fare})
+}
