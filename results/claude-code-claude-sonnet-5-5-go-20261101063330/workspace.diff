+#!/usr/bin/env python3
+# end-to-end latency probe through the NAT path: python3 probe.py <seconds> <outfile>
+import http.client, ssl, time, sys
+ctx = ssl._create_unverified_context()
+dur = int(sys.argv[1]); out = open(sys.argv[2], "w")
+TOK = "34ea320039fc61ae2558176607a2e12ca402cbba22ea21e8c28a46df63f4fd25"
