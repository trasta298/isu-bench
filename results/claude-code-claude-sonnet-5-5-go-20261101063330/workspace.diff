@@ -0,0 +1,21 @@
+#!/usr/bin/env python3
+import sys, time
+n = int(sys.argv[1]); out = open(sys.argv[2], "w")
+def rd():
+    d = {}
+    for l in open("/proc/stat"):
+        if l.startswith("cpu") and l[3].isdigit():
+            p = l.split(); d[p[0]] = [int(x) for x in p[1:9]]
+    return d
+prev = rd()
+for _ in range(n):
+    time.sleep(2)
+    cur = rd(); parts = []
+    for k in sorted(cur):
+        a, b = prev[k], cur[k]
+        tot = sum(b) - sum(a)
+        idle = (b[3] + b[4]) - (a[3] + a[4])
+        si = b[6] - a[6]
+        parts.append("%s busy=%d%% si=%d%%" % (k, 100 * (tot - idle) / tot, 100 * si / tot))
+    out.write(time.strftime("%H:%M:%S ") + " | ".join(parts) + "\n"); out.flush()
+    prev = cur
diff --git a/tools/cpustat.sh b/tools/cpustat.sh
new file mode 100755
index 0000000..681b5cc
--- /dev/null
+++ b/tools/cpustat.sh
@@ -0,0 +1,17 @@
+#!/bin/bash
+# per-cpu utilisation each 2s: cpustat.sh <count> <outfile>
+n=$1; out=$2
+read_stat() { grep '^cpu[0-9]' /proc/stat; }
+prev=$(read_stat)
+for i in $(seq $n); do
+  sleep 2
+  cur=$(read_stat)
+  paste <(echo "$prev") <(echo "$cur") | awk -v ts="$(date +%H:%M:%S)" '{
+    # fields: name user nice sys idle iowait irq softirq steal ...
+    tot1=0; tot2=0; for(i=2;i<=9;i++){tot1+=$i}; for(i=12;i<=19;i++){tot2+=$i}
+    idle=$(13+3)-$5; busy=(tot2-tot1)-($16-$5-0)
+    id1=$5+$6; id2=$16+$17;
+    printf "%s %s busy=%.0f%% si=%.0f%% ", ts, $1, 100*((tot2-tot1)-(id2-id1))/(tot2-tot1), 100*($19-$9)/(tot2-tot1)
+  }'; echo
+  prev=$cur
+done > $out
