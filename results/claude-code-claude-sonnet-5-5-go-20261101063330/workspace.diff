diff --git a/webapp/go/payment.go b/webapp/go/payment.go
new file mode 100644
index 0000000..239e184
--- /dev/null
+++ b/webapp/go/payment.go
@@ -0,0 +1,130 @@
+package main
+
+import (
+	"bytes"
+	"errors"
+	"log/slog"
+	"net/http"
+	"strconv"
+	"sync/atomic"
+	"time"
+)
+
+type payJob struct {
+	rideID string
+	url    string
+	token  string
+	amount int
+	gen    int
+}
+
+var (
+	payClient = &http.Client{
+		Timeout: 5 * time.Second,
+		Transport: &http.Transport{
+			MaxIdleConns:        512,
+			MaxIdleConnsPerHost: 512,
+			IdleConnTimeout:     60 * time.Second,
+		},
+	}
+	payCount, payFail, payNanos, payMaxNanos int64
+	payInflight                              int64
+	payBucketOK, payBucketFail               [6]int64
+	payAttemptNanos                          int64
+	payAttempts                              int64
+)
+
+func bucketOf(n int64) int {
+	switch {
+	case n <= 2:
+		return 0
+	case n <= 5:
+		return 1
+	case n <= 10:
+		return 2
+	case n <= 20:
+		return 3
+	case n <= 40:
+		return 4
+	}
+	return 5
+}
+
+func drainPayments() {}
+
+func startPayWorkers() {
+	go func() {
+		t := time.NewTicker(5 * time.Second)
+		for range t.C {
+			n := atomic.SwapInt64(&payCount, 0)
+			f := atomic.SwapInt64(&payFail, 0)
+			ns := atomic.SwapInt64(&payNanos, 0)
+			mx := atomic.SwapInt64(&payMaxNanos, 0)
+			if n > 0 || f > 0 {
+				avg := time.Duration(0)
+				if n > 0 {
+					avg = time.Duration(ns / n)
+				}
+				var bo, bf [6]int64
+				for i := range bo {
+					bo[i] = atomic.SwapInt64(&payBucketOK[i], 0)
+					bf[i] = atomic.SwapInt64(&payBucketFail[i], 0)
+				}
+				at := atomic.SwapInt64(&payAttempts, 0)
+				an := atomic.SwapInt64(&payAttemptNanos, 0)
+				aavg := time.Duration(0)
+				if at > 0 {
+					aavg = time.Duration(an / at)
+				}
+				slog.Info("payment stats", "ok", n, "fail", f, "avg", avg, "max", time.Duration(mx), "attempt_avg", aavg, "bucket_ok", bo, "bucket_fail", bf)
+			}
+		}
+	}()
+}
+
+// doPayment posts the payment synchronously, retrying with an Idempotency-Key.
+func doPayment(j *payJob) error {
+	body := []byte(`{"amount":` + strconv.Itoa(j.amount) + `}`)
+	start := time.Now()
+	deadline := start.Add(8 * time.Second)
+	for attempt := 0; ; attempt++ {
+		req, err := http.NewRequest(http.MethodPost, j.url+"/payments", bytes.NewReader(body))
+		if err != nil {
+			return err
+		}
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("Authorization", "Bearer "+j.token)
+		req.Header.Set("Idempotency-Key", j.rideID)
+		inf := atomic.AddInt64(&payInflight, 1)
+		t0 := time.Now()
+		res, err := payClient.Do(req)
+		atomic.AddInt64(&payInflight, -1)
+		atomic.AddInt64(&payAttempts, 1)
+		atomic.AddInt64(&payAttemptNanos, int64(time.Since(t0)))
+		if err == nil {
+			res.Body.Close()
+			if res.StatusCode == http.StatusNoContent {
+				atomic.AddInt64(&payBucketOK[bucketOf(inf)], 1)
+				el := int64(time.Since(start))
+				atomic.AddInt64(&payCount, 1)
+				atomic.AddInt64(&payNanos, el)
+				for {
+					m := atomic.LoadInt64(&payMaxNanos)
+					if el <= m || atomic.CompareAndSwapInt64(&payMaxNanos, m, el) {
+						break
+					}
+				}
+				return nil
+			}
+			atomic.AddInt64(&payBucketFail[bucketOf(inf)], 1)
+		} else {
+			atomic.AddInt64(&payBucketFail[bucketOf(inf)], 1)
+			slog.Warn("payment error", "err", err, "attempt", attempt)
+		}
+		atomic.AddInt64(&payFail, 1)
+		if time.Now().After(deadline) {
+			return errors.New("payment failed")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
diff --git a/webapp/go/stats.go b/webapp/go/stats.go
new file mode 100644
index 0000000..38e7daf
--- /dev/null
+++ b/webapp/go/stats.go
@@ -0,0 +1,135 @@
+package main
+
+import (
+	"fmt"
+	"log/slog"
+	"net/http"
+	"os"
+	"runtime"
+	"runtime/pprof"
+	"strings"
+	"sync/atomic"
+	"time"
+)
+
+type namedCounter struct {
+	name string
+	n    int64
+	last int64
+}
+
+var counters []*namedCounter
+
+func counted(name string, h http.HandlerFunc) http.HandlerFunc {
+	c := &namedCounter{name: name}
+	counters = append(counters, c)
+	return func(w http.ResponseWriter, r *http.Request) {
+		atomic.AddInt64(&c.n, 1)
+		h(w, r)
+	}
+}
+
+func startStats() {
+	go func() {
+		t := time.NewTicker(5 * time.Second)
+		for range t.C {
+			var sb strings.Builder
+			total := int64(0)
+			for _, c := range counters {
+				n := atomic.LoadInt64(&c.n)
+				d := n - c.last
+				c.last = n
+				total += d
+				if d > 0 {
+					fmt.Fprintf(&sb, " %s=%d", c.name, d)
+				}
+			}
+			if total > 0 {
+				mu.RLock()
+				nw, nc := len(waiting), len(allChairs)
+				mu.RUnlock()
+				slog.Info("reqs/5s", "total", total, "waiting", nw, "chairs", nc, "detail", sb.String())
+			}
+		}
+	}()
+}
+
+var profiling int32
+
+// maybeProfile captures a CPU profile in the middle of a benchmark run.
+func maybeProfile() {
+	if os.Getenv("PROFILE") != "1" || !atomic.CompareAndSwapInt32(&profiling, 0, 1) {
+		return
+	}
+	go func() {
+		defer atomic.StoreInt32(&profiling, 0)
+		time.Sleep(38 * time.Second)
+		name := fmt.Sprintf("/tmp/cpu-%d.prof", time.Now().Unix())
+		f, err := os.Create(name)
+		if err != nil {
+			return
+		}
+		defer f.Close()
+		if err := pprof.StartCPUProfile(f); err != nil {
+			return
+		}
+		time.Sleep(12 * time.Second)
+		pprof.StopCPUProfile()
+		slog.Info("cpu profile written", "file", name)
+	}()
+}
+
+// ---- latency instrumentation (all atomics; reset every 5s window)
+type lagStat struct {
+	n, sum, max, over50ms int64
+}
+
+func (l *lagStat) rec(ns int64) {
+	atomic.AddInt64(&l.n, 1)
+	atomic.AddInt64(&l.sum, ns)
+	if ns > 50e6 {
+		atomic.AddInt64(&l.over50ms, 1)
+	}
+	for {
+		m := atomic.LoadInt64(&l.max)
+		if ns <= m || atomic.CompareAndSwapInt64(&l.max, m, ns) {
+			break
+		}
+	}
+}
+
+func (l *lagStat) snap() string {
+	n := atomic.SwapInt64(&l.n, 0)
+	sum := atomic.SwapInt64(&l.sum, 0)
+	mx := atomic.SwapInt64(&l.max, 0)
+	o := atomic.SwapInt64(&l.over50ms, 0)
+	if n == 0 {
+		return "n=0"
+	}
+	return fmt.Sprintf("n=%d avg=%.2fms max=%.1fms >50ms=%d", n, float64(sum)/float64(n)/1e6, float64(mx)/1e6, o)
+}
+
+var sseLag, lockWait, tickStat lagStat
+
+func recordLag(ns int64)      { sseLag.rec(ns) }
+func recordLockWait(ns int64) { lockWait.rec(ns) }
+func recordTick(ns int64)     { tickStat.rec(ns) }
+
+var lastNumGC uint32
+var lastPause uint64
+
+func startLatencyLog() {
+	go func() {
+		t := time.NewTicker(5 * time.Second)
+		for range t.C {
+			var ms runtime.MemStats
+			runtime.ReadMemStats(&ms)
+			dg := ms.NumGC - lastNumGC
+			dp := ms.PauseTotalNs - lastPause
+			lastNumGC, lastPause = ms.NumGC, ms.PauseTotalNs
+			slog.Info("latency",
+				"sse_lag", sseLag.snap(), "lock_wait", lockWait.snap(), "chair_tick", tickStat.snap(),
+				"tau_ms", tauHat*1000, "gc", dg, "gc_pause_ms", float64(dp)/1e6, "goroutines", runtime.NumGoroutine(), "heap_mb", ms.HeapAlloc>>20)
+		}
+	}()
+}
diff --git a/webapp/go/store.go b/webapp/go/store.go
new file mode 100644
index 0000000..80eea8c
--- /dev/null
+++ b/webapp/go/store.go
@@ -0,0 +1,505 @@
+package main
+
+import (
+	"database/sql"
+	"fmt"
+	"sync"
+	"time"
+)
+
+const (
+	StMatching  = "MATCHING"
+	StEnroute   = "ENROUTE"
+	StPickup    = "PICKUP"
+	StCarrying  = "CARRYING"
+	StArrived   = "ARRIVED"
+	StCompleted = "COMPLETED"
+
+	initialFare     = 500
+	farePerDistance = 100
+)
+
+type Coupon struct {
+	UserID    string
+	Code      string
+	Discount  int
+	CreatedAt time.Time
+	UsedBy    string
+}
+
+type StatusEntry struct {
+	ID     string
+	Status string
+	At     time.Time
+}
+
+type Ride struct {
+	ID         string
+	User       *User
+	Chair      *Chair
+	PickupLat  int
+	PickupLon  int
+	DestLat    int
+	DestLon    int
+	Evaluation int
+	CreatedAt  time.Time
+	UpdatedAt  time.Time
+	Statuses   []StatusEntry
+	Status     string
+	Fare       int
+}
+
+type evt struct {
+	ride   *Ride
+	status string
+	at     int64
+}
+
+// Notifier holds undelivered events for one recipient (user or chair).
+type Notifier struct {
+	q   []evt
+	sub chan struct{}
+}
+
+func (n *Notifier) push(e evt) {
+	e.at = time.Now().UnixNano()
+	n.q = append(n.q, e)
+	n.wake()
+}
+
+func (n *Notifier) wake() {
+	if n.sub != nil {
+		select {
+		case n.sub <- struct{}{}:
+		default:
+		}
+	}
+}
+
+type User struct {
+	ID        string
+	Username  string
+	Firstname string
+	Lastname  string
+	DOB       string
+	Token     string
+	InvCode   string
+	CreatedAt time.Time
+	PayToken  string
+	Coupons   []*Coupon
+	Rides     []*Ride
+	N         Notifier
+}
+
+type Owner struct {
+	ID        string
+	Name      string
+	Token     string
+	RegToken  string
+	CreatedAt time.Time
+	Chairs    []*Chair
+}
+
+type Chair struct {
+	ID            string
+	Owner         *Owner
+	Name          string
+	Model         string
+	Token         string
+	IsActive      bool
+	CreatedAt     time.Time
+	Speed         int
+	HasLoc        bool
+	Lat           int
+	Lon           int
+	LocAt         time.Time
+	TotalDistance int
+	Cur           *Ride
+	Busy          bool
+	StatCount     int
+	StatEvalSum   int
+	Completed     []*Ride
+	FreeAt        time.Time
+	LastPostAt    int64
+	LocDirty      bool
+	N             Notifier
+}
+
+var (
+	mu sync.RWMutex
+
+	usersByID    map[string]*User
+	usersByToken map[string]*User
+	usersByName  map[string]*User
+	usersByInv   map[string]*User
+
+	ownersByToken    map[string]*Owner
+	ownersByRegToken map[string]*Owner
+	ownersByName     map[string]*Owner
+
+	chairsByToken map[string]*Chair
+	chairsByID    map[string]*Chair
+	allChairs     []*Chair
+
+	ridesByID map[string]*Ride
+	waiting   []*Ride
+	invCount  map[string]int
+
+	chairSpeeds map[string]int
+	paymentURL  string
+	loadGen     int
+
+	// write-behind dirty sets (guarded by mu)
+	dirtyRides   = map[*Ride]struct{}{}
+	dirtyCoupons = map[*Coupon]struct{}{}
+	newStatuses  []statusRow
+)
+
+type statusRow struct {
+	id, rideID, status string
+	at                 time.Time
+}
+
+func speedOf(model string) int {
+	if s, ok := chairSpeeds[model]; ok {
+		return s
+	}
+	return 3
+}
+
+func abs(a int) int {
+	if a < 0 {
+		return -a
+	}
+	return a
+}
+
+func dist(aLat, aLon, bLat, bLon int) int {
+	return abs(aLat-bLat) + abs(aLon-bLon)
+}
+
+func calcFare(pLat, pLon, dLat, dLon int) int {
+	return initialFare + farePerDistance*dist(pLat, pLon, dLat, dLon)
+}
+
+func discountedFare(pLat, pLon, dLat, dLon, discount int) int {
+	m := farePerDistance*dist(pLat, pLon, dLat, dLon) - discount
+	if m < 0 {
+		m = 0
+	}
+	return initialFare + m
+}
+
+// loadAll rebuilds the whole in-memory state from MySQL. Caller must hold mu (write).
+func loadAll() error {
+	usersByID = map[string]*User{}
+	usersByToken = map[string]*User{}
+	usersByName = map[string]*User{}
+	usersByInv = map[string]*User{}
+	ownersByToken = map[string]*Owner{}
+	ownersByRegToken = map[string]*Owner{}
+	ownersByName = map[string]*Owner{}
+	chairsByToken = map[string]*Chair{}
+	chairsByID = map[string]*Chair{}
+	allChairs = nil
+	ridesByID = map[string]*Ride{}
+	waiting = nil
+	dirtyRides = map[*Ride]struct{}{}
+	dirtyCoupons = map[*Coupon]struct{}{}
+	newStatuses = nil
+	invCount = map[string]int{}
+	chairSpeeds = map[string]int{}
+	loadGen++
+
+	// settings
+	var pu string
+	if err := db.QueryRow("SELECT value FROM settings WHERE name = 'payment_gateway_url'").Scan(&pu); err == nil {
+		paymentURL = pu
+	}
+
+	rows, err := db.Query("SELECT name, speed FROM chair_models")
+	if err != nil {
+		return err
+	}
+	for rows.Next() {
+		var n string
+		var s int
+		if err := rows.Scan(&n, &s); err != nil {
+			rows.Close()
+			return err
+		}
+		chairSpeeds[n] = s
+	}
+	rows.Close()
+
+	// owners
+	rows, err = db.Query("SELECT id, name, access_token, chair_register_token, created_at FROM owners ORDER BY id")
+	if err != nil {
+		return err
+	}
+	ownersByID := map[string]*Owner{}
+	for rows.Next() {
+		o := &Owner{}
+		if err := rows.Scan(&o.ID, &o.Name, &o.Token, &o.RegToken, &o.CreatedAt); err != nil {
+			rows.Close()
+			return err
+		}
+		ownersByID[o.ID] = o
+		ownersByToken[o.Token] = o
+		ownersByRegToken[o.RegToken] = o
+		ownersByName[o.Name] = o
+	}
+	rows.Close()
+
+	// chairs
+	rows, err = db.Query("SELECT id, owner_id, name, model, is_active, access_token, created_at FROM chairs ORDER BY id")
+	if err != nil {
+		return err
+	}
+	for rows.Next() {
+		c := &Chair{}
+		var ownerID string
+		if err := rows.Scan(&c.ID, &ownerID, &c.Name, &c.Model, &c.IsActive, &c.Token, &c.CreatedAt); err != nil {
+			rows.Close()
+			return err
+		}
+		o := ownersByID[ownerID]
+		if o == nil {
+			continue
+		}
+		c.Owner = o
+		c.Speed = speedOf(c.Model)
+		o.Chairs = append(o.Chairs, c)
+		chairsByID[c.ID] = c
+		chairsByToken[c.Token] = c
+		allChairs = append(allChairs, c)
+	}
+	rows.Close()
+
+	// chair locations: aggregate
+	rows, err = db.Query("SELECT chair_id, latitude, longitude, created_at FROM chair_locations ORDER BY chair_id, created_at")
+	if err != nil {
+		return err
+	}
+	for rows.Next() {
+		var cid string
+		var lat, lon int
+		var at time.Time
+		if err := rows.Scan(&cid, &lat, &lon, &at); err != nil {
+			rows.Close()
+			return err
+		}
+		c := chairsByID[cid]
+		if c == nil {
+			continue
+		}
+		if c.HasLoc {
+			c.TotalDistance += dist(c.Lat, c.Lon, lat, lon)
+		}
+		c.HasLoc = true
+		c.Lat, c.Lon, c.LocAt = lat, lon, at
+	}
+	rows.Close()
+
+	// persisted aggregate state (supersedes the raw rows above)
+	rows, err = db.Query("SELECT chair_id, latitude, longitude, total_distance, updated_at FROM chair_state")
+	if err != nil {
+		return err
+	}
+	for rows.Next() {
+		var cid string
+		var lat, lon, td int
+		var at time.Time
+		if err := rows.Scan(&cid, &lat, &lon, &td, &at); err != nil {
+			rows.Close()
+			return err
+		}
+		if c := chairsByID[cid]; c != nil {
+			c.HasLoc = true
+			c.Lat, c.Lon, c.TotalDistance, c.LocAt = lat, lon, td, at
+		}
+	}
+	rows.Close()
+
+	// users
+	rows, err = db.Query("SELECT id, username, firstname, lastname, date_of_birth, access_token, invitation_code, created_at FROM users ORDER BY id")
+	if err != nil {
+		return err
+	}
+	for rows.Next() {
+		u := &User{}
+		if err := rows.Scan(&u.ID, &u.Username, &u.Firstname, &u.Lastname, &u.DOB, &u.Token, &u.InvCode, &u.CreatedAt); err != nil {
+			rows.Close()
+			return err
+		}
+		usersByID[u.ID] = u
+		usersByToken[u.Token] = u
+		usersByName[u.Username] = u
+		usersByInv[u.InvCode] = u
+	}
+	rows.Close()
+
+	rows, err = db.Query("SELECT user_id, token FROM payment_tokens")
+	if err != nil {
+		return err
+	}
+	for rows.Next() {
+		var uid, tok string
+		if err := rows.Scan(&uid, &tok); err != nil {
+			rows.Close()
+			return err
+		}
+		if u := usersByID[uid]; u != nil {
+			u.PayToken = tok
+		}
+	}
+	rows.Close()
+
+	// coupons
+	couponByRide := map[string]*Coupon{}
+	rows, err = db.Query("SELECT user_id, code, discount, created_at, used_by FROM coupons ORDER BY created_at")
+	if err != nil {
+		return err
+	}
+	for rows.Next() {
+		var uid string
+		cp := &Coupon{UserID: ""}
+		var usedBy sql.NullString
+		if err := rows.Scan(&uid, &cp.Code, &cp.Discount, &cp.CreatedAt, &usedBy); err != nil {
+			rows.Close()
+			return err
+		}
+		cp.UserID = uid
+		if usedBy.Valid {
+			cp.UsedBy = usedBy.String
+			couponByRide[cp.UsedBy] = cp
+		}
+		if len(cp.Code) > 4 && cp.Code[:4] == "INV_" {
+			invCount[cp.Code]++
+		}
+		if u := usersByID[uid]; u != nil {
+			u.Coupons = append(u.Coupons, cp)
+		}
+	}
+	rows.Close()
+
+	// rides
+	rows, err = db.Query("SELECT id, user_id, chair_id, pickup_latitude, pickup_longitude, destination_latitude, destination_longitude, evaluation, created_at, updated_at FROM rides ORDER BY created_at, id")
+	if err != nil {
+		return err
+	}
+	for rows.Next() {
+		r := &Ride{}
+		var uid string
+		var cid sql.NullString
+		var ev sql.NullInt64
+		if err := rows.Scan(&r.ID, &uid, &cid, &r.PickupLat, &r.PickupLon, &r.DestLat, &r.DestLon, &ev, &r.CreatedAt, &r.UpdatedAt); err != nil {
+			rows.Close()
+			return err
+		}
+		u := usersByID[uid]
+		if u == nil {
+			continue
+		}
+		r.User = u
+		if ev.Valid {
+			r.Evaluation = int(ev.Int64)
+		}
+		discount := 0
+		if cp := couponByRide[r.ID]; cp != nil {
+			discount = cp.Discount
+		}
+		r.Fare = discountedFare(r.PickupLat, r.PickupLon, r.DestLat, r.DestLon, discount)
+		if cid.Valid {
+			r.Chair = chairsByID[cid.String]
+		}
+		u.Rides = append(u.Rides, r)
+		ridesByID[r.ID] = r
+	}
+	rows.Close()
+
+	rows, err = db.Query("SELECT id, ride_id, status, created_at FROM ride_statuses ORDER BY created_at, id")
+	if err != nil {
+		return err
+	}
+	for rows.Next() {
+		var rid string
+		s := StatusEntry{}
+		if err := rows.Scan(&s.ID, &rid, &s.Status, &s.At); err != nil {
+			rows.Close()
+			return err
+		}
+		r := ridesByID[rid]
+		if r == nil {
+			continue
+		}
+		r.Statuses = append(r.Statuses, s)
+		r.Status = s.Status
+	}
+	rows.Close()
+
+	for _, r := range ridesByID {
+		if r.Status == "" {
+			r.Status = StMatching
+		}
+	}
+	// per-chair derived state (rides iterate in creation order per user; use global order)
+	for _, u := range usersByID {
+		for _, r := range u.Rides {
+			c := r.Chair
+			if c == nil {
+				continue
+			}
+			if c.Cur == nil || !r.UpdatedAt.Before(c.Cur.UpdatedAt) {
+				c.Cur = r
+			}
+			var carrying, arrived, completed bool
+			for _, s := range r.Statuses {
+				switch s.Status {
+				case StCarrying:
+					carrying = true
+				case StArrived:
+					arrived = true
+				case StCompleted:
+					completed = true
+				}
+			}
+			if completed {
+				c.Completed = append(c.Completed, r)
+				if carrying && arrived {
+					c.StatCount++
+					c.StatEvalSum += r.Evaluation
+				}
+			}
+		}
+	}
+	for _, c := range allChairs {
+		if c.Cur != nil && c.Cur.Status != StCompleted {
+			c.Busy = true
+		}
+	}
+	// waiting rides in creation order
+	var ws []*Ride
+	for _, r := range ridesByID {
+		if r.Chair == nil {
+			ws = append(ws, r)
+		}
+	}
+	sortRidesByCreated(ws)
+	waiting = ws
+	return nil
+}
+
+func sortRidesByCreated(rs []*Ride) {
+	// simple insertion/merge via sort.Slice
+	sortSlice(rs, func(a, b *Ride) bool {
+		if a.CreatedAt.Equal(b.CreatedAt) {
+			return a.ID < b.ID
+		}
+		return a.CreatedAt.Before(b.CreatedAt)
+	})
+}
+
+func logf(format string, a ...any) {
+	fmt.Printf(format+"\n", a...)
+}
