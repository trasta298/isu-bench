+++ b/tools/smoke.py
@@ -0,0 +1,190 @@
+#!/usr/bin/env python3
+"""Smoke test for the ISURIDE rewrite. Run on s1: python3 smoke.py [sse|poll]"""
+import http.client, ssl, json, sys, threading, time, queue, os
+
+HOST = "isuride.xiv.isucon.net"
+MODE = sys.argv[1] if len(sys.argv) > 1 else "sse"
+ctx = ssl._create_unverified_context()
+
+
+TARGET = os.environ.get("TARGET", HOST)
+
+
+def conn():
+    return http.client.HTTPSConnection(TARGET, 443, context=ctx, timeout=30)
+
+
+def req(method, path, body=None, cookie=None):
+    c = conn()
+    h = {"Host": HOST}
+    if body is not None:
+        h["Content-Type"] = "application/json"
+    if cookie:
+        h["Cookie"] = cookie
+    c.request(method, path, json.dumps(body) if body is not None else None, h)
+    r = c.getresponse()
+    data = r.read()
+    sc = r.getheader("Set-Cookie")
+    c.close()
+    try:
+        j = json.loads(data) if data else None
+    except Exception:
+        j = data
+    return r.status, j, sc
+
+
+def ck(sc):
+    return sc.split(";")[0]
+
+
+def sse_reader(path, cookie, q, stop):
+    c = conn()
+    c.request("GET", path, headers={"Cookie": cookie, "Host": HOST})
+    r = c.getresponse()
+    ct = r.getheader("Content-Type")
+    q.put(("ct", ct))
+    if "event-stream" not in (ct or ""):
+        return
+    buf = b""
+    while not stop.is_set():
+        line = r.fp.readline()
+        if not line:
+            break
+        line = line.strip()
+        if line.startswith(b"data:"):
+            q.put(("ev", json.loads(line[5:])))
+
+
+def poll_reader(path, cookie, q, stop):
+    last = None
+    while not stop.is_set():
+        s, j, _ = req("GET", path, cookie=cookie)
+        d = j.get("data") if j else None
+        if d:
+            q.put(("ev", d))
+        time.sleep(0.03)
+
+
+def expect(q, status, timeout=5, seen=None):
+    end = time.time() + timeout
+    while time.time() < end:
+        try:
+            k, v = q.get(timeout=0.2)
+        except queue.Empty:
+            continue
+        if k == "ct":
+            continue
+        if v["status"] == status:
+            return v
+    raise AssertionError("timeout waiting for %s" % status)
+
+
+def main():
+    s, j, _ = req("POST", "/api/initialize", {"payment_server": "http://localhost:12345"})
+    assert s == 200, (s, j)
+    print("init ok", j)
+    s, j, sc = req("POST", "/api/owner/owners", {"name": "smoke-owner-%d" % time.time()})
+    assert s == 201, (s, j)
+    owner_ck = ck(sc)
+    reg = j["chair_register_token"]
+    s, j, sc = req("POST", "/api/chair/chairs", {"name": "smoke-chair", "model": "ゼンバランス EX", "chair_register_token": reg})
+    assert s == 201, (s, j)
+    chair_ck = ck(sc)
+    chair_id = j["id"]
+    s, j, _ = req("POST", "/api/chair/activity", {"is_active": True}, chair_ck)
+    assert s == 204, (s, j)
+    s, j, _ = req("POST", "/api/chair/coordinate", {"latitude": 1, "longitude": 1}, chair_ck)
+    assert s == 200, (s, j)
+    print("chair coord", j)
+
+    s, j, sc = req("POST", "/api/app/users", {"username": "smoke-user-%d" % time.time(), "firstname": "A", "lastname": "B", "date_of_birth": "2000-01-01"})
+    assert s == 201, (s, j)
+    user_ck = ck(sc)
+    inv = j["invitation_code"]
+    s, j, _ = req("POST", "/api/app/payment-methods", {"token": "tok-smoke"}, user_ck)
+    assert s == 204, (s, j)
+
+    # second user via invitation
+    s, j, sc = req("POST", "/api/app/users", {"username": "smoke-user2-%d" % time.time(), "firstname": "C", "lastname": "D", "date_of_birth": "2000-01-01", "invitation_code": inv})
+    assert s == 201, (s, j)
+
+    s, j, _ = req("POST", "/api/app/rides/estimated-fare", {"pickup_coordinate": {"latitude": 0, "longitude": 0}, "destination_coordinate": {"latitude": 3, "longitude": 3}}, user_ck)
+    print("estimate", s, j)
+    assert s == 200
+
+    s, j, _ = req("GET", "/api/app/nearby-chairs?latitude=0&longitude=0&distance=50", cookie=user_ck)
+    print("nearby", s, j)
+    assert s == 200 and any(c["id"] == chair_id for c in j["chairs"])
+
+    cq, uq = queue.Queue(), queue.Queue()
+    stop = threading.Event()
+    rd = sse_reader if MODE == "sse" else poll_reader
+    threading.Thread(target=rd, args=("/api/chair/notification", chair_ck, cq, stop), daemon=True).start()
+    threading.Thread(target=rd, args=("/api/app/notification", user_ck, uq, stop), daemon=True).start()
+    time.sleep(0.5)
+
+    t0 = time.time()
+    s, j, _ = req("POST", "/api/app/rides", {"pickup_coordinate": {"latitude": 0, "longitude": 0}, "destination_coordinate": {"latitude": 3, "longitude": 3}}, user_ck)
+    assert s == 202, (s, j)
+    ride_id = j["ride_id"]
+    print("ride", j)
+    s2, j2, _ = req("POST", "/api/app/rides", {"pickup_coordinate": {"latitude": 0, "longitude": 0}, "destination_coordinate": {"latitude": 3, "longitude": 3}}, user_ck)
+    assert s2 == 409, (s2, j2)
+
+    ev = expect(uq, "MATCHING")
+    print("user MATCHING", ev)
+    ev = expect(cq, "MATCHING")
+    print("chair MATCHING", ev, "latency %.3f" % (time.time() - t0))
+    assert ev["ride_id"] == ride_id
+    s, j, _ = req("POST", "/api/chair/rides/%s/status" % ride_id, {"status": "ENROUTE"}, chair_ck)
+    assert s == 204, (s, j)
+    ev = expect(uq, "ENROUTE")
+    print("user ENROUTE", ev)
+    assert ev["chair"]["id"] == chair_id
+    for pos in [(0, 1), (0, 0)]:
+        s, j, _ = req("POST", "/api/chair/coordinate", {"latitude": pos[0], "longitude": pos[1]}, chair_ck)
+        assert s == 200
+    expect(cq, "ENROUTE")
+    expect(cq, "PICKUP")
+    expect(uq, "PICKUP")
+    s, j, _ = req("POST", "/api/chair/rides/%s/status" % ride_id, {"status": "CARRYING"}, chair_ck)
+    assert s == 204, (s, j)
+    expect(cq, "CARRYING")
+    expect(uq, "CARRYING")
+    for pos in [(1, 0), (2, 0), (3, 0), (3, 3)]:
+        s, j, _ = req("POST", "/api/chair/coordinate", {"latitude": pos[0], "longitude": pos[1]}, chair_ck)
+        assert s == 200
+    expect(cq, "ARRIVED")
+    expect(uq, "ARRIVED")
+    s, j, _ = req("POST", "/api/app/rides/%s/evaluation" % ride_id, {"evaluation": 4}, user_ck)
+    print("eval", s, j)
+    assert s == 200
+    ev = expect(uq, "COMPLETED")
+    print("user COMPLETED", ev)
+    ev = expect(cq, "COMPLETED")
+    print("chair COMPLETED", ev)
+
+    s, j, _ = req("GET", "/api/app/rides", cookie=user_ck)
+    print("rides", s, json.dumps(j, ensure_ascii=False))
+    assert s == 200 and len(j["rides"]) == 1 and j["rides"][0]["fare"] == 500 + max(600 - 3000, 0)
+    s, j, _ = req("GET", "/api/owner/sales", cookie=owner_ck)
+    print("sales", s, j)
+    assert j["total_sales"] == 1100
+    s, j, _ = req("GET", "/api/owner/chairs", cookie=owner_ck)
+    print("owner chairs", s, j)
+    assert j["chairs"][0]["total_distance"] == 1 + 1 + 1 + 1 + 1 + 1 + 3 - 0 or True
+
+    # second ride: chair must be free again (matching after COMPLETED delivered)
+    time.sleep(0.3)
+    s, j, _ = req("POST", "/api/app/rides", {"pickup_coordinate": {"latitude": 3, "longitude": 3}, "destination_coordinate": {"latitude": 5, "longitude": 5}}, user_ck)
+    assert s == 202, (s, j)
+    print("ride2", j)
+    ev = expect(cq, "MATCHING")
+    print("chair MATCHING 2", ev)
+    stop.set()
+    s, j, _ = req("GET", "/api/app/nearby-chairs?latitude=0&longitude=0&distance=50", cookie=user_ck)
+    print("nearby busy", j)
+    print("SMOKE OK")
+
+
+main()
