+package main
+
+import (
+	"database/sql"
+	"fmt"
+	"log/slog"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/oklog/ulid/v2"
+)
+
+func sortSlice[T any](s []T, less func(a, b T) bool) {
+	sort.Slice(s, func(i, j int) bool { return less(s[i], s[j]) })
+}
+
+type dbOp struct {
+	q    string
+	args []any
+}
+
+type locRow struct {
+	id        string
+	chairID   string
+	lat, lon  int
+	createdAt time.Time
+}
+
+var (
+	wmu     sync.Mutex
+	wq      []dbOp
+	wlocs   []locRow
+	flushMu sync.Mutex // held while flushing / during initialize
+)
+
+func enqueue(q string, args ...any) {
+	wmu.Lock()
+	wq = append(wq, dbOp{q, args})
+	wmu.Unlock()
+}
+
+func enqueueLoc(chairID string, lat, lon int, at time.Time) {
+	row := locRow{id: ulid.Make().String(), chairID: chairID, lat: lat, lon: lon, createdAt: at}
+	wmu.Lock()
+	wlocs = append(wlocs, row)
+	wmu.Unlock()
+}
+
+func discardPending() {
+	wmu.Lock()
+	wq = nil
+	wlocs = nil
+	wmu.Unlock()
+}
+
+func startWriter() {
+	go func() {
+		t := time.NewTicker(100 * time.Millisecond)
+		n := 0
+		for range t.C {
+			n++
+			collectDirty(n%10 == 0)
+			flushWrites()
+		}
+	}()
+}
+
+// collectDirty converts the dirty sets into a few multi-row statements.
+func collectDirty(withChairs bool) {
+	mu.Lock()
+	rides := make([]*Ride, 0, len(dirtyRides))
+	type rideRow struct {
+		id, userID, chairID  string
+		hasChair             bool
+		pl, po, dl, do       int
+		eval                 int
+		createdAt, updatedAt time.Time
+	}
+	var rrows []rideRow
+	for r := range dirtyRides {
+		rides = append(rides, r)
+	}
+	for _, r := range rides {
+		row := rideRow{id: r.ID, userID: r.User.ID, pl: r.PickupLat, po: r.PickupLon, dl: r.DestLat, do: r.DestLon, eval: r.Evaluation, createdAt: r.CreatedAt, updatedAt: r.UpdatedAt}
+		if r.Chair != nil {
+			row.chairID = r.Chair.ID
+			row.hasChair = true
+		}
+		rrows = append(rrows, row)
+	}
+	dirtyRides = map[*Ride]struct{}{}
+	type coupRow struct {
+		userID, code, usedBy string
+		discount             int
+		createdAt            time.Time
+	}
+	var crows []coupRow
+	for cp := range dirtyCoupons {
+		crows = append(crows, coupRow{cp.UserID, cp.Code, cp.UsedBy, cp.Discount, cp.CreatedAt})
+	}
+	dirtyCoupons = map[*Coupon]struct{}{}
+	srows := newStatuses
+	newStatuses = nil
+	var lrows []locRow
+	var totals []int
+	if withChairs {
+		for _, c := range allChairs {
+			if c.LocDirty {
+				c.LocDirty = false
+				lrows = append(lrows, locRow{chairID: c.ID, lat: c.Lat, lon: c.Lon, createdAt: c.LocAt})
+				totals = append(totals, c.TotalDistance)
+			}
+		}
+	}
+	mu.Unlock()
+
+	const chunk = 300
+	for i := 0; i < len(rrows); i += chunk {
+		end := min(i+chunk, len(rrows))
+		var sb strings.Builder
+		sb.WriteString("INSERT INTO rides (id, user_id, chair_id, pickup_latitude, pickup_longitude, destination_latitude, destination_longitude, evaluation, created_at, updated_at) VALUES ")
+		args := make([]any, 0, (end-i)*10)
+		for j := i; j < end; j++ {
+			if j > i {
+				sb.WriteByte(',')
+			}
+			sb.WriteString("(?,?,?,?,?,?,?,?,?,?)")
+			r := rrows[j]
+			var chair, eval any
+			if r.hasChair {
+				chair = r.chairID
+			}
+			if r.eval > 0 {
+				eval = r.eval
+			}
+			args = append(args, r.id, r.userID, chair, r.pl, r.po, r.dl, r.do, eval, r.createdAt, r.updatedAt)
+		}
+		sb.WriteString(" ON DUPLICATE KEY UPDATE chair_id=VALUES(chair_id), evaluation=VALUES(evaluation), updated_at=VALUES(updated_at)")
+		enqueue(sb.String(), args...)
+	}
+	for i := 0; i < len(srows); i += chunk {
+		end := min(i+chunk, len(srows))
+		var sb strings.Builder
+		sb.WriteString("INSERT IGNORE INTO ride_statuses (id, ride_id, status, created_at, app_sent_at, chair_sent_at) VALUES ")
+		args := make([]any, 0, (end-i)*6)
+		for j := i; j < end; j++ {
+			if j > i {
+				sb.WriteByte(',')
+			}
+			sb.WriteString("(?,?,?,?,?,?)")
+			r := srows[j]
+			args = append(args, r.id, r.rideID, r.status, r.at, r.at, r.at)
+		}
+		enqueue(sb.String(), args...)
+	}
+	for i := 0; i < len(crows); i += chunk {
+		end := min(i+chunk, len(crows))
+		var sb strings.Builder
+		sb.WriteString("INSERT INTO coupons (user_id, code, discount, created_at, used_by) VALUES ")
+		args := make([]any, 0, (end-i)*5)
+		for j := i; j < end; j++ {
+			if j > i {
+				sb.WriteByte(',')
+			}
+			sb.WriteString("(?,?,?,?,?)")
+			c := crows[j]
+			var ub any
+			if c.usedBy != "" {
+				ub = c.usedBy
+			}
+			args = append(args, c.userID, c.code, c.discount, c.createdAt, ub)
+		}
+		sb.WriteString(" ON DUPLICATE KEY UPDATE used_by=VALUES(used_by)")
+		enqueue(sb.String(), args...)
+	}
+	for i := 0; i < len(lrows); i += chunk {
+		end := min(i+chunk, len(lrows))
+		var sb strings.Builder
+		sb.WriteString("INSERT INTO chair_state (chair_id, latitude, longitude, total_distance, updated_at) VALUES ")
+		args := make([]any, 0, (end-i)*5)
+		for j := i; j < end; j++ {
+			if j > i {
+				sb.WriteByte(',')
+			}
+			sb.WriteString("(?,?,?,?,?)")
+			args = append(args, lrows[j].chairID, lrows[j].lat, lrows[j].lon, totals[j], lrows[j].createdAt)
+		}
+		sb.WriteString(" ON DUPLICATE KEY UPDATE latitude=VALUES(latitude), longitude=VALUES(longitude), total_distance=VALUES(total_distance), updated_at=VALUES(updated_at)")
+		enqueue(sb.String(), args...)
+	}
+}
+
+func flushWrites() {
+	flushMu.Lock()
+	defer flushMu.Unlock()
+	wmu.Lock()
+	ops := wq
+	locs := wlocs
+	wq = nil
+	wlocs = nil
+	wmu.Unlock()
+	if len(ops) == 0 && len(locs) == 0 {
+		return
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		slog.Error("writer begin", "err", err)
+		return
+	}
+	for _, op := range ops {
+		if _, err := tx.Exec(op.q, op.args...); err != nil {
+			slog.Error("writer exec", "q", op.q, "err", err)
+		}
+	}
+	const chunk = 500
+	for i := 0; i < len(locs); i += chunk {
+		end := i + chunk
+		if end > len(locs) {
+			end = len(locs)
+		}
+		part := locs[i:end]
+		var sb strings.Builder
+		sb.WriteString("INSERT INTO chair_locations (id, chair_id, latitude, longitude, created_at) VALUES ")
+		args := make([]any, 0, len(part)*5)
+		for j, l := range part {
+			if j > 0 {
+				sb.WriteByte(',')
+			}
+			sb.WriteString("(?,?,?,?,?)")
+			args = append(args, l.id, l.chairID, l.lat, l.lon, l.createdAt)
+		}
+		if _, err := tx.Exec(sb.String(), args...); err != nil {
+			slog.Error("writer loc insert", "err", err)
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		slog.Error("writer commit", "err", err)
+	}
+}
+
+var _ = sql.ErrNoRows
+var _ = fmt.Sprintf
