diff --git a/conf/nat-guard.sh b/conf/nat-guard.sh
new file mode 100644
index 0000000..e80cc63
--- /dev/null
+++ b/conf/nat-guard.sh
@@ -0,0 +1,39 @@
+#!/bin/bash
+# Offload TLS termination: DNAT :443 to healthy TLS terminators (s2/s3), fall back to local nginx.
+BACKENDS=(10.0.1.71 10.0.1.151)
+PORT=443
+sysctl -qw net.ipv4.ip_forward=1
+iptables -t nat -N ISUCON_NAT 2>/dev/null
+iptables -t nat -C PREROUTING -p tcp --dport $PORT -j ISUCON_NAT 2>/dev/null || iptables -t nat -I PREROUTING -p tcp --dport $PORT -j ISUCON_NAT
+iptables -t nat -C POSTROUTING -p tcp --dport $PORT -m conntrack --ctstate DNAT -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING -p tcp --dport $PORT -m conntrack --ctstate DNAT -j MASQUERADE
+cur="init"
+while true; do
+  healthy=()
+  for b in "${BACKENDS[@]}"; do
+    if timeout 1 bash -c "exec 3<>/dev/tcp/$b/$PORT" 2>/dev/null; then healthy+=("$b"); fi
+  done
+  key="${healthy[*]}"
+  if [ "$key" != "$cur" ]; then
+    {
+      echo "*nat"
+      echo ":ISUCON_NAT - [0:0]"
+      echo "-F ISUCON_NAT"
+      n=${#healthy[@]}
+      i=0
+      for b in "${healthy[@]}"; do
+        left=$((n - i))
+        if [ $left -gt 1 ]; then
+          p=$(awk -v l=$left 'BEGIN{printf "%.5f", 1.0/l}')
+          echo "-A ISUCON_NAT -p tcp --dport $PORT -m statistic --mode random --probability $p -j DNAT --to-destination $b:$PORT"
+        else
+          echo "-A ISUCON_NAT -p tcp --dport $PORT -j DNAT --to-destination $b:$PORT"
+        fi
+        i=$((i + 1))
+      done
+      echo "COMMIT"
+    } | iptables-restore -n
+    echo "nat-guard: healthy backends: [${key}]"
+    cur="$key"
+  fi
+  sleep 2
+done
diff --git a/conf/nginx.cap10k.conf b/conf/nginx.cap10k.conf
new file mode 100644
index 0000000..494c531
--- /dev/null
+++ b/conf/nginx.cap10k.conf
@@ -0,0 +1,52 @@
+user www-data;
+worker_processes auto;
+worker_rlimit_nofile 100000;
+pid /run/nginx.pid;
+error_log /var/log/nginx/error.log warn;
+include /etc/nginx/modules-enabled/*.conf;
+
+events {
+	worker_connections 16384;
+	multi_accept on;
+}
+
+http {
+	sendfile on;
+	tcp_nopush on;
+	tcp_nodelay on;
+	types_hash_max_size 2048;
+	keepalive_timeout 120;
+	keepalive_requests 100000;
+
+	include /etc/nginx/mime.types;
+	default_type application/octet-stream;
+
+	ssl_protocols TLSv1.2 TLSv1.3;
+	ssl_prefer_server_ciphers off;
+	ssl_session_cache shared:SSL:20m;
+	ssl_session_timeout 1h;
+
+	access_log off;
+
+	open_file_cache max=4000 inactive=600s;
+	open_file_cache_valid 600s;
+	open_file_cache_min_uses 1;
+	open_file_cache_errors on;
+
+	split_clients $request_id $sample {
+		1%  1;
+		*   0;
+	}
+	limit_req_zone $server_name zone=static_zone:1m rate=10000r/s;
+	log_format brief '$request_method $uri $status $body_bytes_sent $request_time $http_if_none_match $ssl_session_reused';
+
+	gzip off;
+
+	upstream app {
+		server 10.0.1.69:8080;
+		keepalive 1024;
+	}
+
+	include /etc/nginx/conf.d/*.conf;
+	include /etc/nginx/sites-enabled/*;
+}
