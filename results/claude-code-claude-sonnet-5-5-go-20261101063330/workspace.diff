diff --git a/webapp/go/matching.go b/webapp/go/matching.go
new file mode 100644
index 0000000..8b6e27c
--- /dev/null
+++ b/webapp/go/matching.go
@@ -0,0 +1,166 @@
+package main
+
+import (
+	"os"
+	"strconv"
+	"time"
+)
+
+var matchCh = make(chan struct{}, 1)
+
+var matchBeta = func() float64 {
+	if v := os.Getenv("MATCH_BETA"); v != "" {
+		if f, err := strconv.ParseFloat(v, 64); err == nil {
+			return f
+		}
+	}
+	return 1.0
+}()
+
+func triggerMatch() {
+	select {
+	case matchCh <- struct{}{}:
+	default:
+	}
+}
+
+func startMatcher() {
+	go func() {
+		t := time.NewTicker(100 * time.Millisecond)
+		for {
+			select {
+			case <-matchCh:
+			case <-t.C:
+			}
+			mu.Lock()
+			runMatchingLocked()
+			mu.Unlock()
+		}
+	}()
+}
+
+type cand struct {
+	ri, ci int
+	cost   float64
+}
+
+// tauHat is a running estimate (seconds) of the benchmarker's per-step chair tick.
+// Updated from coordinate POST gaps of moving chairs (mu held).
+var tauHat = 0.031
+
+func updateTau(gapSec float64) {
+	hi := 1.5*tauHat + 0.01
+	if gapSec > hi {
+		gapSec = hi
+	}
+	if gapSec < 0.015 {
+		gapSec = 0.015
+	}
+	tauHat += 0.01 * (gapSec - tauHat)
+}
+
+// Satisfaction thresholds learned from the benchmarker's reports:
+//
+//	pickup: unhappy when ceil(d/speed) steps exceed ~10 (0.32s at 30.7ms/step)
+//	travel: unhappy when real travel time exceeds ~1.6s
+func penPickup(steps int) float64 {
+	switch {
+	case steps <= 9:
+		return 0
+	case steps == 10:
+		return 0.3
+	case steps == 11:
+		return 0.9
+	}
+	return 1.0
+}
+
+func penTravel(sec float64) float64 {
+	x := (sec - 1.4) / 0.4
+	if x < 0 {
+		return 0
+	}
+	if x > 1 {
+		return 1
+	}
+	return x
+}
+
+func ceilDiv(a, b int) int {
+	if a <= 0 {
+		return 0
+	}
+	return (a + b - 1) / b
+}
+
+func matchCost(d, L, speed int, tau, age float64) float64 {
+	sp := ceilDiv(d, speed)
+	st := ceilDiv(L, speed)
+	c := penPickup(sp) + penTravel(float64(st)*tau)
+	c += 0.1 * float64(speed-2) / 5
+	c += 0.01 * float64(sp+st)
+	c -= 0.2 * age
+	return c
+}
+
+func runMatchingLocked() {
+	if len(waiting) == 0 {
+		return
+	}
+	var free []*Chair
+	for _, c := range allChairs {
+		if c.IsActive && !c.Busy && c.HasLoc {
+			free = append(free, c)
+		}
+	}
+	if len(free) == 0 {
+		return
+	}
+	rides := waiting
+	if max := 40000 / len(free); len(rides) > max {
+		rides = rides[:max]
+	}
+	now := time.Now()
+	cands := make([]cand, 0, len(rides)*len(free))
+	for ri, r := range rides {
+		L := dist(r.PickupLat, r.PickupLon, r.DestLat, r.DestLon)
+		age := now.Sub(r.CreatedAt).Seconds()
+		for ci, c := range free {
+			d := dist(c.Lat, c.Lon, r.PickupLat, r.PickupLon)
+			cost := matchCost(d, L, c.Speed, tauHat, age)
+			cands = append(cands, cand{ri, ci, cost})
+		}
+	}
+	sortSlice(cands, func(a, b cand) bool { return a.cost < b.cost })
+	usedR := make([]bool, len(rides))
+	usedC := make([]bool, len(free))
+	matched := 0
+	at := nowUS()
+	for _, cd := range cands {
+		if usedR[cd.ri] || usedC[cd.ci] {
+			continue
+		}
+		usedR[cd.ri] = true
+		usedC[cd.ci] = true
+		matched++
+		r, c := rides[cd.ri], free[cd.ci]
+		r.Chair = c
+		r.UpdatedAt = at
+		c.Cur = r
+		c.Busy = true
+		dirtyRides[r] = struct{}{}
+		c.N.push(evt{ride: r, status: StMatching})
+		if matched == len(rides) || matched == len(free) {
+			break
+		}
+	}
+	if matched > 0 {
+		nw := waiting[:0:0]
+		for _, r := range waiting {
+			if r.Chair == nil {
+				nw = append(nw, r)
+			}
+		}
+		waiting = nw
+	}
+}
diff --git a/webapp/go/notify.go b/webapp/go/notify.go
new file mode 100644
index 0000000..677cfa2
--- /dev/null
+++ b/webapp/go/notify.go
@@ -0,0 +1,266 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"os"
+	"strconv"
+	"time"
+)
+
+var useSSE = os.Getenv("NOTIFY_SSE") != "0"
+
+var nearbyGrace = func() time.Duration {
+	if v := os.Getenv("NEARBY_GRACE_MS"); v != "" {
+		if n, err := strconv.Atoi(v); err == nil {
+			return time.Duration(n) * time.Millisecond
+		}
+	}
+	return 1500 * time.Millisecond
+}()
+
+type userNotifChairStats struct {
+	TotalRidesCount    int     `json:"total_rides_count"`
+	TotalEvaluationAvg float64 `json:"total_evaluation_avg"`
+}
+
+type userNotifChair struct {
+	ID    string              `json:"id"`
+	Name  string              `json:"name"`
+	Model string              `json:"model"`
+	Stats userNotifChairStats `json:"stats"`
+}
+
+type userNotifData struct {
+	RideID                string          `json:"ride_id"`
+	PickupCoordinate      Coordinate      `json:"pickup_coordinate"`
+	DestinationCoordinate Coordinate      `json:"destination_coordinate"`
+	Fare                  int             `json:"fare"`
+	Status                string          `json:"status"`
+	Chair                 *userNotifChair `json:"chair,omitempty"`
+	CreatedAt             int64           `json:"created_at"`
+	UpdateAt              int64           `json:"updated_at"`
+}
+
+type simpleUser struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+}
+
+type chairNotifData struct {
+	RideID                string     `json:"ride_id"`
+	User                  simpleUser `json:"user"`
+	PickupCoordinate      Coordinate `json:"pickup_coordinate"`
+	DestinationCoordinate Coordinate `json:"destination_coordinate"`
+	Status                string     `json:"status"`
+}
+
+func userPayloadLocked(ride *Ride, status string) []byte {
+	d := &userNotifData{
+		RideID:                ride.ID,
+		PickupCoordinate:      Coordinate{ride.PickupLat, ride.PickupLon},
+		DestinationCoordinate: Coordinate{ride.DestLat, ride.DestLon},
+		Fare:                  ride.Fare,
+		Status:                status,
+		CreatedAt:             ride.CreatedAt.UnixMilli(),
+		UpdateAt:              ride.UpdatedAt.UnixMilli(),
+	}
+	if c := ride.Chair; c != nil {
+		st := userNotifChairStats{TotalRidesCount: c.StatCount}
+		if c.StatCount > 0 {
+			st.TotalEvaluationAvg = float64(c.StatEvalSum) / float64(c.StatCount)
+		}
+		d.Chair = &userNotifChair{ID: c.ID, Name: c.Name, Model: c.Model, Stats: st}
+	}
+	b, _ := json.Marshal(d)
+	return b
+}
+
+func chairPayloadLocked(ride *Ride, status string) []byte {
+	d := &chairNotifData{
+		RideID:                ride.ID,
+		User:                  simpleUser{ID: ride.User.ID, Name: ride.User.Firstname + " " + ride.User.Lastname},
+		PickupCoordinate:      Coordinate{ride.PickupLat, ride.PickupLon},
+		DestinationCoordinate: Coordinate{ride.DestLat, ride.DestLon},
+		Status:                status,
+	}
+	b, _ := json.Marshal(d)
+	return b
+}
+
+type streamer struct {
+	n         *Notifier
+	build     func(e evt) []byte // mu held
+	latest    func() []byte      // mu held; nil when nothing to send
+	delivered func(e evt)        // mu (write) held
+}
+
+func userStreamer(u *User) *streamer {
+	return &streamer{
+		n:     &u.N,
+		build: func(e evt) []byte { return userPayloadLocked(e.ride, e.status) },
+		latest: func() []byte {
+			if len(u.Rides) == 0 {
+				return nil
+			}
+			r := u.Rides[len(u.Rides)-1]
+			return userPayloadLocked(r, r.Status)
+		},
+	}
+}
+
+func chairStreamer(c *Chair) *streamer {
+	return &streamer{
+		n:     &c.N,
+		build: func(e evt) []byte { return chairPayloadLocked(e.ride, e.status) },
+		latest: func() []byte {
+			if c.Cur == nil {
+				return nil
+			}
+			return chairPayloadLocked(c.Cur, c.Cur.Status)
+		},
+		delivered: func(e evt) {
+			if e.status == StCompleted && c.Cur == e.ride {
+				c.Busy = false
+				triggerMatch()
+			}
+		},
+	}
+}
+
+func appGetNotification(w http.ResponseWriter, r *http.Request) {
+	user := authUser(w, r)
+	if user == nil {
+		return
+	}
+	s := userStreamer(user)
+	if useSSE {
+		serveStream(w, r, s)
+	} else {
+		servePoll(w, s)
+	}
+}
+
+func chairGetNotification(w http.ResponseWriter, r *http.Request) {
+	chair := authChair(w, r)
+	if chair == nil {
+		return
+	}
+	s := chairStreamer(chair)
+	if useSSE {
+		serveStream(w, r, s)
+	} else {
+		servePoll(w, s)
+	}
+}
+
+func servePoll(w http.ResponseWriter, s *streamer) {
+	var payload []byte
+	mu.Lock()
+	if len(s.n.q) > 0 {
+		e := s.n.q[0]
+		s.n.q = s.n.q[1:]
+		payload = s.build(e)
+		if s.delivered != nil {
+			s.delivered(e)
+		}
+	} else {
+		payload = s.latest()
+	}
+	mu.Unlock()
+	var buf bytes.Buffer
+	buf.WriteString(`{"data":`)
+	if payload == nil {
+		buf.WriteString("null")
+	} else {
+		buf.Write(payload)
+	}
+	buf.WriteString(`,"retry_after_ms":30}`)
+	w.Header().Set("Content-Type", "application/json;charset=utf-8")
+	w.WriteHeader(http.StatusOK)
+	w.Write(buf.Bytes())
+}
+
+func serveStream(w http.ResponseWriter, r *http.Request, s *streamer) {
+	h := w.Header()
+	h.Set("Content-Type", "text/event-stream")
+	h.Set("Cache-Control", "no-cache")
+	h.Set("X-Accel-Buffering", "no")
+	w.WriteHeader(http.StatusOK)
+	rc := http.NewResponseController(w)
+	rc.Flush()
+
+	mine := make(chan struct{}, 1)
+	mu.Lock()
+	if s.n.sub != nil {
+		close(s.n.sub)
+	}
+	s.n.sub = mine
+	mu.Unlock()
+	defer func() {
+		mu.Lock()
+		if s.n.sub == mine {
+			s.n.sub = nil
+		}
+		mu.Unlock()
+	}()
+
+	ctx := r.Context()
+	first := true
+	var buf bytes.Buffer
+	for {
+		mu.Lock()
+		evs := s.n.q
+		s.n.q = nil
+		buf.Reset()
+		if first && len(evs) == 0 {
+			if p := s.latest(); p != nil {
+				fmt.Fprintf(&buf, "data: %s\n\n", p)
+			}
+		}
+		first = false
+		for _, e := range evs {
+			fmt.Fprintf(&buf, "data: %s\n\n", s.build(e))
+		}
+		mu.Unlock()
+
+		if buf.Len() > 0 {
+			_, err := w.Write(buf.Bytes())
+			if err == nil {
+				err = rc.Flush()
+			}
+			if err != nil {
+				if len(evs) > 0 {
+					mu.Lock()
+					s.n.q = append(evs, s.n.q...)
+					mu.Unlock()
+				}
+				return
+			}
+			if len(evs) > 0 {
+				nowN := time.Now().UnixNano()
+				for _, e := range evs {
+					recordLag(nowN - e.at)
+				}
+			}
+			if s.delivered != nil && len(evs) > 0 {
+				mu.Lock()
+				for _, e := range evs {
+					s.delivered(e)
+				}
+				mu.Unlock()
+			}
+		}
+
+		select {
+		case _, ok := <-mine:
+			if !ok {
+				return
+			}
+		case <-ctx.Done():
+			return
+		}
+	}
+}
