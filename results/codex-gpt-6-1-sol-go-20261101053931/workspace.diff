new file mode 100644
index 0000000..d5dab37
--- /dev/null
+++ b/webapp/go/acknowledgments.go
@@ -0,0 +1,59 @@
+package main
+
+import (
+	"strings"
+	"time"
+)
+
+type notificationAck struct {
+	ID    string
+	Chair bool
+}
+
+var acknowledgmentQueue = make(chan notificationAck, 65536)
+
+func acknowledgmentLoop() {
+	ticker := time.NewTicker(5 * time.Millisecond)
+	defer ticker.Stop()
+	app := make(map[string]bool)
+	chair := make(map[string]bool)
+	flush := func(column string, ids map[string]bool) {
+		if len(ids) == 0 {
+			return
+		}
+		batch := make([]interface{}, 0, len(ids))
+		for id := range ids {
+			batch = append(batch, id)
+		}
+		query := "UPDATE ride_statuses SET " + column + "=COALESCE(" + column + ",CURRENT_TIMESTAMP(6)) WHERE id IN (" + strings.TrimRight(strings.Repeat("?,", len(batch)), ",") + ")"
+		if _, err := db.Exec(query, batch...); err == nil {
+			clear(ids)
+		}
+	}
+	for {
+		select {
+		case ack := <-acknowledgmentQueue:
+			if ack.Chair {
+				chair[ack.ID] = true
+			} else {
+				app[ack.ID] = true
+			}
+		case <-ticker.C:
+		drain:
+			for i := 0; i < 8192; i++ {
+				select {
+				case ack := <-acknowledgmentQueue:
+					if ack.Chair {
+						chair[ack.ID] = true
+					} else {
+						app[ack.ID] = true
+					}
+				default:
+					break drain
+				}
+			}
+			flush("app_sent_at", app)
+			flush("chair_sent_at", chair)
+		}
+	}
+}
