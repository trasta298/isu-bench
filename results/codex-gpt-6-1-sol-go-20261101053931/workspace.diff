new file mode 100644
index 0000000..944ec83
--- /dev/null
+++ b/webapp/go/state.go
@@ -0,0 +1,443 @@
+package main
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"github.com/jmoiron/sqlx"
+	"hash/crc32"
+	"net/http"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/oklog/ulid/v2"
+)
+
+type cachedRide struct {
+	Ride     Ride
+	Statuses []RideStatus
+	Fare     int
+}
+type locationSummary struct {
+	ChairID       string    `db:"chair_id"`
+	Latitude      int       `db:"latitude"`
+	Longitude     int       `db:"longitude"`
+	TotalDistance int       `db:"total_distance"`
+	UpdatedAt     time.Time `db:"updated_at"`
+}
+
+var state = struct {
+	sync.RWMutex
+	rides      map[string]*cachedRide
+	userRides  map[string][]string
+	chairRides map[string][]string
+	chairs     map[string]Chair
+	users      map[string]User
+	locations  map[string]locationSummary
+	speeds     map[string]int
+}{}
+var entityLocks sync.Map
+
+func entityLock(key string) *sync.Mutex {
+	v, _ := entityLocks.LoadOrStore(key, &sync.Mutex{})
+	return v.(*sync.Mutex)
+}
+
+func loadState() error {
+	var rides []Ride
+	var statuses []RideStatus
+	var coupons []Coupon
+	var chairs []Chair
+	var users []User
+	var locations []locationSummary
+	var models []ChairModel
+	for _, task := range []struct {
+		dest  interface{}
+		query string
+	}{{&rides, `SELECT * FROM rides ORDER BY created_at`}, {&statuses, `SELECT * FROM ride_statuses ORDER BY created_at,id`}, {&coupons, `SELECT * FROM coupons WHERE used_by IS NOT NULL`}, {&chairs, `SELECT * FROM chairs`}, {&users, `SELECT * FROM users`}, {&models, `SELECT * FROM chair_models`}} {
+		if err := db.Select(task.dest, task.query); err != nil {
+			return err
+		}
+	}
+	locationQuery := `SELECT chair_id, MAX(CASE WHEN rn=1 THEN latitude END) latitude,MAX(CASE WHEN rn=1 THEN longitude END) longitude,SUM(distance) total_distance,MAX(created_at) updated_at
+FROM (SELECT chair_id,latitude,longitude,created_at,ROW_NUMBER() OVER (PARTITION BY chair_id ORDER BY created_at DESC,id DESC) rn,
+COALESCE(ABS(latitude-LAG(latitude) OVER (PARTITION BY chair_id ORDER BY created_at,id))+ABS(longitude-LAG(longitude) OVER (PARTITION BY chair_id ORDER BY created_at,id)),0) distance FROM chair_locations WHERE MOD(CRC32(chair_id),2)=?) t GROUP BY chair_id`
+	if locationDB == db {
+		locationQuery = strings.ReplaceAll(locationQuery, " WHERE MOD(CRC32(chair_id),2)=?", "")
+		if err := db.Select(&locations, locationQuery); err != nil {
+			return err
+		}
+	} else {
+		var mainLocations []locationSummary
+		if err := db.Select(&mainLocations, locationQuery, 0); err != nil {
+			return err
+		}
+		if err := locationDB.Select(&locations, locationQuery, 1); err != nil {
+			return err
+		}
+		locations = append(locations, mainLocations...)
+	}
+
+	state.Lock()
+	defer state.Unlock()
+	state.rides = make(map[string]*cachedRide)
+	state.userRides = make(map[string][]string)
+	state.chairRides = make(map[string][]string)
+	state.chairs = make(map[string]Chair)
+	state.users = make(map[string]User)
+	state.locations = make(map[string]locationSummary)
+	state.speeds = make(map[string]int)
+	discounts := make(map[string]int)
+	for _, c := range coupons {
+		discounts[*c.UsedBy] = c.Discount
+	}
+	for _, ride := range rides {
+		fare := initialFare + max(0, calculateFare(ride.PickupLatitude, ride.PickupLongitude, ride.DestinationLatitude, ride.DestinationLongitude)-initialFare-discounts[ride.ID])
+		state.rides[ride.ID] = &cachedRide{Ride: ride, Fare: fare}
+		state.userRides[ride.UserID] = append(state.userRides[ride.UserID], ride.ID)
+		if ride.ChairID.Valid {
+			state.chairRides[ride.ChairID.String] = append(state.chairRides[ride.ChairID.String], ride.ID)
+		}
+	}
+	for _, s := range statuses {
+		if cr := state.rides[s.RideID]; cr != nil {
+			cr.Statuses = append(cr.Statuses, s)
+		}
+	}
+	for _, c := range chairs {
+		state.chairs[c.ID] = c
+	}
+	for _, u := range users {
+		state.users[u.ID] = u
+	}
+	for _, l := range locations {
+		state.locations[l.ChairID] = l
+	}
+	for _, m := range models {
+		state.speeds[m.Name] = m.Speed
+	}
+	return nil
+}
+
+func refreshRide(id string) (Ride, error) {
+	var ride Ride
+	var statuses []RideStatus
+	var discount int
+	if err := db.Get(&ride, `SELECT * FROM rides WHERE id=?`, id); err != nil {
+		return ride, err
+	}
+	if err := db.Select(&statuses, `SELECT * FROM ride_statuses WHERE ride_id=? ORDER BY created_at,id`, id); err != nil {
+		return ride, err
+	}
+	if err := db.Get(&discount, `SELECT discount FROM coupons WHERE used_by=?`, id); err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return ride, err
+	}
+	state.Lock()
+	defer state.Unlock()
+	old := state.rides[id]
+	newRide := old == nil
+	if old == nil {
+		old = &cachedRide{Ride: ride}
+		state.rides[id] = old
+		state.userRides[ride.UserID] = append(state.userRides[ride.UserID], id)
+		sort.Slice(state.userRides[ride.UserID], func(i, j int) bool {
+			return state.rides[state.userRides[ride.UserID][i]].Ride.CreatedAt.Before(state.rides[state.userRides[ride.UserID][j]].Ride.CreatedAt)
+		})
+	}
+	if ride.ChairID.Valid && (newRide || !old.Ride.ChairID.Valid) {
+		state.chairRides[ride.ChairID.String] = append(state.chairRides[ride.ChairID.String], id)
+	}
+	if !ride.UpdatedAt.Before(old.Ride.UpdatedAt) {
+		old.Ride = ride
+	}
+	old.Fare = initialFare + max(0, calculateFare(ride.PickupLatitude, ride.PickupLongitude, ride.DestinationLatitude, ride.DestinationLongitude)-initialFare-discount)
+	merged := make(map[string]RideStatus)
+	for _, s := range old.Statuses {
+		merged[s.ID] = s
+	}
+	for _, s := range statuses {
+		if prev, ok := merged[s.ID]; ok {
+			if prev.AppSentAt != nil {
+				s.AppSentAt = prev.AppSentAt
+			}
+			if prev.ChairSentAt != nil {
+				s.ChairSentAt = prev.ChairSentAt
+			}
+		}
+		merged[s.ID] = s
+	}
+	old.Statuses = old.Statuses[:0]
+	for _, s := range merged {
+		old.Statuses = append(old.Statuses, s)
+	}
+	sort.Slice(old.Statuses, func(i, j int) bool {
+		a, b := old.Statuses[i], old.Statuses[j]
+		if a.CreatedAt.Equal(b.CreatedAt) {
+			return a.ID < b.ID
+		}
+		return a.CreatedAt.Before(b.CreatedAt)
+	})
+	return ride, nil
+}
+func refreshChair(id string) {
+	var c Chair
+	if err := db.Get(&c, `SELECT * FROM chairs WHERE id=?`, id); err == nil {
+		state.Lock()
+		state.chairs[id] = c
+		state.Unlock()
+	}
+}
+func cachedUser(id string) (User, error) {
+	state.RLock()
+	u, ok := state.users[id]
+	state.RUnlock()
+	if ok {
+		return u, nil
+	}
+	err := db.Get(&u, `SELECT * FROM users WHERE id=?`, id)
+	if err == nil {
+		state.Lock()
+		state.users[id] = u
+		state.Unlock()
+	}
+	return u, err
+}
+func snapshotLatestChairRide(id string) (Ride, string) {
+	state.RLock()
+	defer state.RUnlock()
+	ids := state.chairRides[id]
+	if len(ids) == 0 {
+		return Ride{}, ""
+	}
+	cr := state.rides[ids[len(ids)-1]]
+	s := ""
+	if len(cr.Statuses) > 0 {
+		s = cr.Statuses[len(cr.Statuses)-1].Status
+	}
+	return cr.Ride, s
+}
+func chairAvailableLocked(id string, requireDelivered bool) bool {
+	ids := state.chairRides[id]
+	if len(ids) == 0 {
+		return true
+	}
+	cr := state.rides[ids[len(ids)-1]]
+	if cr.Ride.Evaluation == nil {
+		return false
+	}
+	if requireDelivered {
+		for _, s := range cr.Statuses {
+			if s.ChairSentAt == nil {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func chooseNotificationLocked(id string, chair bool) (cachedRide, RideStatus, bool) {
+	ids := state.userRides[id]
+	if chair {
+		ids = state.chairRides[id]
+	}
+	if len(ids) == 0 {
+		return cachedRide{}, RideStatus{}, false
+	}
+	for _, rid := range ids {
+		cr := state.rides[rid]
+		for _, s := range cr.Statuses {
+			if (!chair && s.AppSentAt == nil) || (chair && s.ChairSentAt == nil) {
+				return *cr, s, true
+			}
+		}
+	}
+	cr := state.rides[ids[len(ids)-1]]
+	if len(cr.Statuses) == 0 {
+		return *cr, RideStatus{}, false
+	}
+	return *cr, cr.Statuses[len(cr.Statuses)-1], false
+}
+func markNotification(ctx context.Context, s RideStatus, chair bool) error {
+	now := time.Now()
+	state.Lock()
+	if cr := state.rides[s.RideID]; cr != nil {
+		for i := range cr.Statuses {
+			if cr.Statuses[i].ID == s.ID {
+				if chair {
+					cr.Statuses[i].ChairSentAt = &now
+				} else {
+					cr.Statuses[i].AppSentAt = &now
+				}
+				break
+			}
+		}
+	}
+	state.Unlock()
+	acknowledgmentQueue <- notificationAck{ID: s.ID, Chair: chair}
+	return nil
+}
+
+func appGetNotificationJSON(w http.ResponseWriter, r *http.Request) {
+	user := r.Context().Value("user").(*User)
+	mu := entityLock("un" + user.ID)
+	mu.Lock()
+	defer mu.Unlock()
+	state.RLock()
+	cr, s, pending := chooseNotificationLocked(user.ID, false)
+	if cr.Ride.ID == "" {
+		state.RUnlock()
+		writeJSON(w, 200, &appGetNotificationResponse{RetryAfterMs: 100})
+		return
+	}
+	ride := cr.Ride
+	data := &appGetNotificationResponseData{RideID: ride.ID, PickupCoordinate: Coordinate{ride.PickupLatitude, ride.PickupLongitude}, DestinationCoordinate: Coordinate{ride.DestinationLatitude, ride.DestinationLongitude}, Fare: cr.Fare, Status: s.Status, CreatedAt: ride.CreatedAt.UnixMilli(), UpdateAt: ride.UpdatedAt.UnixMilli()}
+	if ride.ChairID.Valid {
+		c := state.chairs[ride.ChairID.String]
+		stats := appGetNotificationResponseChairStats{}
+		sum := 0
+		for _, id := range state.chairRides[c.ID] {
+			other := state.rides[id]
+			if other.Ride.Evaluation != nil {
+				stats.TotalRidesCount++
+				sum += *other.Ride.Evaluation
+			}
+		}
+		if stats.TotalRidesCount > 0 {
+			stats.TotalEvaluationAvg = float64(sum) / float64(stats.TotalRidesCount)
+		}
+		data.Chair = &appGetNotificationResponseChair{ID: c.ID, Name: c.Name, Model: c.Model, Stats: stats}
+	}
+	state.RUnlock()
+	if pending {
+		if err := markNotification(r.Context(), s, false); err != nil {
+			writeError(w, 500, err)
+			return
+		}
+	}
+	writeJSON(w, 200, &appGetNotificationResponse{Data: data, RetryAfterMs: 100})
+}
+func chairGetNotificationJSON(w http.ResponseWriter, r *http.Request) {
+	chair := r.Context().Value("chair").(*Chair)
+	mu := entityLock("cn" + chair.ID)
+	mu.Lock()
+	defer mu.Unlock()
+	state.RLock()
+	cr, s, pending := chooseNotificationLocked(chair.ID, true)
+	state.RUnlock()
+	ride := cr.Ride
+	if ride.ID == "" {
+		writeJSON(w, 200, &chairGetNotificationResponse{RetryAfterMs: 100})
+		return
+	}
+	user, err := cachedUser(ride.UserID)
+	if err != nil {
+		writeError(w, 500, err)
+		return
+	}
+	data := &chairGetNotificationResponseData{RideID: ride.ID, User: simpleUser{ID: user.ID, Name: user.Firstname + " " + user.Lastname}, PickupCoordinate: Coordinate{ride.PickupLatitude, ride.PickupLongitude}, DestinationCoordinate: Coordinate{ride.DestinationLatitude, ride.DestinationLongitude}, Status: s.Status}
+	if pending {
+		if err := markNotification(r.Context(), s, true); err != nil {
+			writeError(w, 500, err)
+			return
+		}
+	}
+	writeJSON(w, 200, &chairGetNotificationResponse{Data: data, RetryAfterMs: 100})
+}
+
+func chairPostCoordinate(w http.ResponseWriter, r *http.Request) {
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(r.Context()), 5*time.Second)
+	defer cancel()
+	chair := ctx.Value("chair").(*Chair)
+	req := &Coordinate{}
+	if err := bindJSON(r, req); err != nil {
+		writeError(w, 400, err)
+		return
+	}
+	mu := entityLock("co" + chair.ID)
+	mu.Lock()
+	defer mu.Unlock()
+	now := time.Now().UTC()
+	statusID := ulid.Make().String()
+	ride, status := snapshotLatestChairRide(chair.ID)
+	next := ""
+	if status == "ENROUTE" && req.Latitude == ride.PickupLatitude && req.Longitude == ride.PickupLongitude {
+		next = "PICKUP"
+	}
+	if status == "CARRYING" && req.Latitude == ride.DestinationLatitude && req.Longitude == ride.DestinationLongitude {
+		next = "ARRIVED"
+	}
+	if err := persistLocation(ctx, locationConnection(chair.ID), ulid.Make().String(), chair.ID, *req, now); err != nil {
+		writeError(w, 500, err)
+		return
+	}
+	if next != "" {
+		if _, err := db.ExecContext(ctx, `INSERT INTO ride_statuses (id,ride_id,status,created_at) VALUES (?,?,?,?)`, statusID, ride.ID, next, now); err != nil {
+			writeError(w, 500, err)
+			return
+		}
+	}
+
+	state.Lock()
+	l, exists := state.locations[chair.ID]
+	if exists {
+		l.TotalDistance += calculateDistance(l.Latitude, l.Longitude, req.Latitude, req.Longitude)
+	}
+	l.ChairID = chair.ID
+	l.Latitude = req.Latitude
+	l.Longitude = req.Longitude
+	l.UpdatedAt = now
+	state.locations[chair.ID] = l
+	state.Unlock()
+	if next != "" {
+		cacheStatus(RideStatus{ID: statusID, RideID: ride.ID, Status: next, CreatedAt: now})
+	}
+	writeJSON(w, 200, &chairPostCoordinateResponse{RecordedAt: now.UnixMilli()})
+}
+
+func publishCachedRide(id string) {
+	state.RLock()
+	cr := state.rides[id]
+	if cr == nil {
+		state.RUnlock()
+		return
+	}
+	u, c := cr.Ride.UserID, cr.Ride.ChairID
+	state.RUnlock()
+	notifications.publish("u" + u)
+	if c.Valid {
+		notifications.publish("c" + c.String)
+	}
+}
+func cacheNewRide(ride Ride, status RideStatus, fare int) {
+	state.Lock()
+	state.rides[ride.ID] = &cachedRide{Ride: ride, Statuses: []RideStatus{status}, Fare: fare}
+	state.userRides[ride.UserID] = append(state.userRides[ride.UserID], ride.ID)
+	state.Unlock()
+	publishCachedRide(ride.ID)
+}
+func cacheStatus(status RideStatus) {
+	state.Lock()
+	if cr := state.rides[status.RideID]; cr != nil {
+		cr.Statuses = append(cr.Statuses, status)
+	}
+	state.Unlock()
+	publishCachedRide(status.RideID)
+}
+func cacheCompletedRide(ride Ride, status RideStatus) {
+	state.Lock()
+	if cr := state.rides[ride.ID]; cr != nil {
+		cr.Ride = ride
+		cr.Statuses = append(cr.Statuses, status)
+	}
+	state.Unlock()
+	publishCachedRide(ride.ID)
+}
+
+func locationConnection(chairID string) *sqlx.DB {
+	if crc32.ChecksumIEEE([]byte(chairID))%2 == 0 {
+		return db
+	}
+	return locationDB
+}
