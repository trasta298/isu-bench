--- /dev/null
+++ b/webapp/go/events.go
@@ -0,0 +1,114 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"sync"
+	"time"
+)
+
+type eventBus struct {
+	sync.Mutex
+	events map[string]chan struct{}
+}
+
+var notifications = eventBus{events: make(map[string]chan struct{})}
+
+func (b *eventBus) subscribe(key string) <-chan struct{} {
+	b.Lock()
+	defer b.Unlock()
+	ch := b.events[key]
+	if ch == nil {
+		ch = make(chan struct{})
+		b.events[key] = ch
+	}
+	return ch
+}
+func (b *eventBus) publish(key string) {
+	b.Lock()
+	defer b.Unlock()
+	if ch := b.events[key]; ch != nil {
+		close(ch)
+	}
+	b.events[key] = make(chan struct{})
+}
+func notifyRide(id string) {
+	if ride, err := refreshRide(id); err == nil {
+		notifications.publish("u" + ride.UserID)
+		if ride.ChairID.Valid {
+			notifications.publish("c" + ride.ChairID.String)
+		}
+	}
+}
+
+type responseBuffer struct {
+	header http.Header
+	code   int
+	bytes.Buffer
+}
+
+func (b *responseBuffer) Header() http.Header { return b.header }
+func (b *responseBuffer) WriteHeader(c int)   { b.code = c }
+func appGetNotification(w http.ResponseWriter, r *http.Request) {
+	user := r.Context().Value("user").(*User)
+	streamNotification(w, r, "u"+user.ID, appGetNotificationJSON)
+}
+func chairGetNotification(w http.ResponseWriter, r *http.Request) {
+	chair := r.Context().Value("chair").(*Chair)
+	streamNotification(w, r, "c"+chair.ID, chairGetNotificationJSON)
+}
+func streamNotification(w http.ResponseWriter, r *http.Request, key string, fn http.HandlerFunc) {
+	w.Header().Set("Content-Type", "text/event-stream")
+	w.Header().Set("Cache-Control", "no-cache")
+	w.Header().Set("X-Accel-Buffering", "no")
+	flusher, ok := w.(http.Flusher)
+	if !ok {
+		w.WriteHeader(500)
+		return
+	}
+	w.WriteHeader(200)
+	flusher.Flush()
+	last := ""
+	ticker := time.NewTicker(15 * time.Second)
+	defer ticker.Stop()
+	for {
+		ch := notifications.subscribe(key)
+		for {
+			if r.Context().Err() != nil {
+				return
+			}
+			b := &responseBuffer{header: make(http.Header)}
+			fn(b, r)
+			if b.code != 200 {
+				return
+			}
+			var response struct {
+				Data json.RawMessage `json:"data"`
+			}
+			if err := json.Unmarshal(b.Bytes(), &response); err != nil {
+				return
+			}
+			current := string(response.Data)
+			if current == "null" || current == "" || current == last {
+				break
+			}
+			if _, err := fmt.Fprintf(w, "data: %s\n\n", current); err != nil {
+				return
+			}
+			flusher.Flush()
+			last = current
+		}
+		select {
+		case <-r.Context().Done():
+			return
+		case <-ch:
+		case <-ticker.C:
+			if _, err := fmt.Fprint(w, ": keepalive\n\n"); err != nil {
+				return
+			}
+			flusher.Flush()
+		}
+	}
+}
