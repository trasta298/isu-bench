@@ -0,0 +1,88 @@
+package main
+
+import (
+	"context"
+	"hash/crc32"
+	"strings"
+	"time"
+
+	"github.com/jmoiron/sqlx"
+)
+
+type locationWrite struct {
+	ID, ChairID string
+	Coordinate  Coordinate
+	CreatedAt   time.Time
+	Result      chan error
+}
+
+var locationQueues = [2]chan locationWrite{make(chan locationWrite, 8192), make(chan locationWrite, 8192)}
+var coordinateBatchDelay = envFloat("ISUCON_COORD_BATCH_US", 500)
+
+func locationWriterLoop(shard int) {
+	connection := db
+	if shard == 1 {
+		connection = locationDB
+	}
+	for first := range locationQueues[shard] {
+		batch := make([]locationWrite, 0, 128)
+		batch = append(batch, first)
+		if coordinateBatchDelay > 0 {
+			timer := time.NewTimer(time.Duration(coordinateBatchDelay) * time.Microsecond)
+		collect:
+			for len(batch) < 256 {
+				select {
+				case item := <-locationQueues[shard]:
+					batch = append(batch, item)
+				case <-timer.C:
+					break collect
+				}
+			}
+			timer.Stop()
+		} else {
+		drain:
+			for len(batch) < 256 {
+				select {
+				case item := <-locationQueues[shard]:
+					batch = append(batch, item)
+				default:
+					break drain
+				}
+			}
+		}
+
+		query := strings.Builder{}
+		query.WriteString("INSERT INTO chair_locations (id,chair_id,latitude,longitude,created_at) VALUES ")
+		args := make([]interface{}, 0, len(batch)*5)
+		for i, item := range batch {
+			if i > 0 {
+				query.WriteByte(',')
+			}
+			query.WriteString("(?,?,?,?,?)")
+			args = append(args, item.ID, item.ChairID, item.Coordinate.Latitude, item.Coordinate.Longitude, item.CreatedAt)
+		}
+		_, err := connection.Exec(query.String(), args...)
+		for _, item := range batch {
+			item.Result <- err
+		}
+	}
+}
+func persistLocation(ctx context.Context, connection *sqlx.DB, id, chairID string, coordinate Coordinate, now time.Time) error {
+	if coordinateBatchDelay == 0 {
+		_, err := connection.ExecContext(ctx, `INSERT INTO chair_locations (id,chair_id,latitude,longitude,created_at) VALUES (?,?,?,?,?)`, id, chairID, coordinate.Latitude, coordinate.Longitude, now)
+		return err
+	}
+	item := locationWrite{ID: id, ChairID: chairID, Coordinate: coordinate, CreatedAt: now, Result: make(chan error, 1)}
+	shard := crc32.ChecksumIEEE([]byte(chairID)) % 2
+	select {
+	case locationQueues[shard] <- item:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	select {
+	case err := <-item.Result:
+		return err
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
