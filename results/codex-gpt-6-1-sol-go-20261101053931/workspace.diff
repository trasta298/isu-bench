diff --git a/TUNING.md b/TUNING.md
new file mode 100644
index 0000000..c49ce09
--- /dev/null
+++ b/TUNING.md
@@ -0,0 +1,25 @@
+# ISUCON14 tuning
+
+The production application is Go on **s3**. **s1** runs nginx/TLS and one coordinate-storage shard. **s2** runs the primary MySQL database and the other coordinate-storage shard.
+
+- Main database: `10.0.1.238:3306` (s2).
+- Coordinate records with `CRC32(chair_id) % 2 == 0` use s2; the other records use `10.0.1.116:3306` (s1).
+- s1 nginx proxies API traffic to `10.0.1.191:8080` (s3).
+- Initialization imports the schema/master/initial data into both database servers. Only the assigned coordinate partition is read from each server.
+- Ride state, authentication, locations, distances, chair availability, and owner statistics are cached in the Go process. The caches are reconstructed from MySQL at startup.
+- Coordinate responses wait for committed SQL inserts. Concurrent coordinate requests are combined into inserts without an intentional wait in the final configuration.
+- Notifications use SSE and ordered per-entity status queues. Delivery markers are batched every 5 ms.
+- Matching runs in Go every 10 ms, uses chair speed, pickup travel and trip length, prioritizes old requests, and persists assignments in batches.
+- Payments use a stable ride ID as `Idempotency-Key`, a pooled HTTP client, and retries. Evaluation requests finish their payment/transaction even after the client disconnects.
+- nginx uses HTTP/2, upstream keepalive, precompressed static assets, cached TLS sessions, and higher connection/file limits.
+- MySQL uses a 1 GiB buffer pool and redo capacity, `innodb_flush_log_at_trx_commit=2`, disabled binary logging, and disabled performance instrumentation.
+
+Production configuration snapshots are in `deployment/`. The application unit is enabled only on s3. MySQL is enabled on s1 and s2. The original matcher is disabled on all servers.
+
+Benchmark logs are in `results/runNN.log`; every invocation, including failed runs, counts. `results/run-ledger.tsv` records completed results through the last update before the final run. Run 15 is the final score.
+
+Full three-server reboots were verified after runs 12 and 14. `check_persistence.py` compared completed ride history, owner sales, chair details/distances, and database counts before and after reboot. All comparisons passed. The application became available automatically.
+
+The final pre-run validation (run 14) passed with 559,421 points. Run 15 uses the same deployed code and configuration.
+
+The second full reboot, after run 14 with the final database settings, returned the application automatically in 37.7 seconds. Persisted ride history, sales, chair details/distances (229 chairs in the selected owner snapshot), and database row counts matched.
diff --git a/check_persistence.py b/check_persistence.py
new file mode 100644
index 0000000..2175e74
--- /dev/null
+++ b/check_persistence.py
@@ -0,0 +1,38 @@
+import json, subprocess, sys
+from pathlib import Path
+
+def remote(server,command):
+ return subprocess.check_output(['ssh',server,command],text=True).strip()
+
+def mysql(sql):
+ return remote('s2',"sudo mysql -N -B isuride -e '"+sql+"'")
+
+def http(path,token,cookie):
+ return json.loads(remote('s1',"curl --fail --silent --resolve isuride.xiv.isucon.net:443:127.0.0.1 -H 'Cookie: "+cookie+'='+token+"' 'https://isuride.xiv.isucon.net"+path+"'"))
+
+def canonical(obj):
+ if isinstance(obj,dict):return {k:canonical(v) for k,v in sorted(obj.items())}
+ if isinstance(obj,list):return sorted([canonical(x) for x in obj],key=lambda v:json.dumps(v,sort_keys=True))
+ return obj
+
+mode=sys.argv[1]
+creds_path=Path('/work/results/persistence-credentials.json')
+if mode=='before':
+ owner=mysql('SELECT access_token FROM owners WHERE id IN (SELECT owner_id FROM chairs WHERE id IN (SELECT chair_id FROM rides WHERE evaluation IS NOT NULL)) ORDER BY created_at DESC LIMIT 1')
+ user=mysql('SELECT access_token FROM users WHERE id IN (SELECT user_id FROM rides WHERE evaluation IS NOT NULL) ORDER BY created_at DESC LIMIT 1')
+ creds={'owner':owner,'user':user};creds_path.write_text(json.dumps(creds))
+else:creds=json.loads(creds_path.read_text())
+record={
+ 'chairs':canonical(http('/api/owner/chairs',creds['owner'],'owner_session')),
+ 'sales':canonical(http('/api/owner/sales',creds['owner'],'owner_session')),
+ 'rides':canonical(http('/api/app/rides',creds['user'],'app_session')),
+ 'counts':mysql('SELECT COUNT(*) FROM rides; SELECT COUNT(*) FROM ride_statuses; SELECT COUNT(*) FROM users; SELECT COUNT(*) FROM chairs'),
+ 'locations1':remote('s1', 'sudo mysql -N -B isuride -e "SELECT COUNT(*) FROM chair_locations WHERE MOD(CRC32(chair_id),2)=1"'),
+ 'locations2':mysql('SELECT COUNT(*) FROM chair_locations WHERE MOD(CRC32(chair_id),2)=0')
+}
+path=Path('/work/results/persistence-'+mode+'.json');path.write_text(json.dumps(record,ensure_ascii=False,indent=2))
+if mode=='after':
+ before=json.loads(Path('/work/results/persistence-before.json').read_text())
+ for k in record:assert record[k]==before[k],f'Persistence mismatch: {k}'
+ print('PASS: ride history, sales, chair details/distances, and database counts survived reboot')
+else:print('Saved persistence snapshot:',len(record['chairs']['chairs']),'chairs,',len(record['rides']['rides']),'completed user rides')
